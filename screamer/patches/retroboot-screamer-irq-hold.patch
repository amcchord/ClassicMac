+    uint32_t holds;
     uint32_t underruns;         /* statistics (trace) */
     uint32_t dropped;
 
diff --git a/include/hw/ppc/mac_dbdma.h b/include/hw/ppc/mac_dbdma.h
--- a/include/hw/ppc/mac_dbdma.h
+++ b/include/hw/ppc/mac_dbdma.h
@@ -155,6 +155,14 @@ typedef struct DBDMA_channel {
     DBDMA_rw rw;
     DBDMA_flush flush;
     dbdma_cmd current;
+    /*
+     * RetroBoot: the guest services a channel interrupt by reading the
+     * channel's status (Mac OS's sound driver does at once).  irq_raised_ns:
+     * when an interrupt was raised that no status read has followed yet (0:
+     * none); irq_serviced: the guest has been seen to do so.
+     */
+    int64_t irq_raised_ns;
+    bool irq_serviced;
 } DBDMA_channel;
 
 struct DBDMAState {
