@@ -202,12 +238,21 @@ static void pmac_screamer_tx_transfer(DBDMA_io *io)
     if (s->paced_dma) {
         /* complete when the codec has played this command */
         int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        int64_t play = muldiv64(io->len / 4, NANOSECONDS_PER_SECOND, s->rate);
+        int64_t due;
 
-        s->codec_ns = MAX(s->codec_ns, now) +
-                      muldiv64(io->len / 4, NANOSECONDS_PER_SECOND, s->rate);
+        trace_screamer_out(io->len, (now - s->codec_ns) / 1000, s->bpos - s->ppos, s->frames);
+        if (now - s->codec_ns > (int64_t)s->resync_ms * SCALE_MS) {
+            s->codec_ns = now;                  /* a new stream */
+        }
+        s->codec_ns += play;                    /* continuous timeline */
+        /* behind the codec: catch up at up to twice real time (see above) */
+        due = now - s->dma_ns > SCREAMER_IDLE_NS ? now : s->dma_ns;
+        s->dma_ns = MAX(s->codec_ns - (int64_t)s->dma_lead_us * SCALE_US,
+                        due + play / 2);
         io->len = 0;
         s->dma_pending = io;
-        timer_mod(s->dma_timer, s->codec_ns);
+        timer_mod(s->dma_timer, s->dma_ns);
         return;
     }
 
@@ -222,9 +267,25 @@ static void pmac_screamer_tx(DBDMA_io *io)
 {
