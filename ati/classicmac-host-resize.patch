+/* Guest software owns the CRTC, mode list and desktop geometry. */
+#include "classicmac_host_display.h"
+static void ati_host_resize(ATIVGAState *s, uint32_t width, uint32_t height)
+{
+    if (ati_is_radeon(s)) {
+        classicmac_display_request(MAX(640, MIN(width, 1920) & ~7U),
+                                  MAX(480, MIN(height, 1440)));
+    }
+}
+static void ati_ui_info(void *opaque, uint32_t head, QemuUIInfo *info)
+{
+    VGACommonState *vga = opaque;
+    ATIVGAState *s = container_of(vga, ATIVGAState, vga);
+    if (!head && info->width && info->height) {
+        ati_host_resize(s, info->width, info->height);
+    }
+}
+static void ati_set_host_resize(Object *o, const char *value, Error **errp)
+{
+    uint32_t width, height;
+    char extra;
+    if (sscanf(value, "%ux%u%c", &width, &height, &extra) != 2 ||
+        !width || !height) {
+        error_setg(errp, "Expected WIDTHxHEIGHT");
+        return;
+    }
+    ati_host_resize(ATI_VGA(o), width, height);
+}
+
 static void ati_vga_realize(PCIDevice *dev, Error **errp)
 {
     ATIVGAState *s = ATI_VGA(dev);
