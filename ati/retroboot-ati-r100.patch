+    GLuint prog, vao, vbo;
+    GLint u_fbsize, u_stage_c, u_stage_a, u_tfactor, u_stage_en, u_tex_en,
+          u_tex[3], u_alpha, u_alpharef, u_fog, u_fogcol, u_flags, u_solid;
+    GLRTarget targets[MAX_TARGETS];
