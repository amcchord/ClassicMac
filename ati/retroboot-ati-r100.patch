+    uint16_t min, mag, ws, wt;
+} GLRTexture;
+
+enum { CMD_DRAW, CMD_TEX, CMD_UPLOAD, CMD_READ, CMD_CLEARZ, CMD_FINISH, CMD_READ_ASYNC,
+       CMD_FILL };
+
+typedef struct GLRCmd {
+    int kind;
