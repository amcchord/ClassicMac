+    ATIDrawState st;
+    uint16_t prim;
+    unsigned nv;
+    ATIVertex *v;
+    ATIImage img;
+    ATITexUnit tu;
+    uint64_t key;
+    uint32_t gen;
+    uint8_t *data;
+    size_t len;
+    float z;
+    int stencil, x, y, w, h;
+    uint32_t depth_mc;
