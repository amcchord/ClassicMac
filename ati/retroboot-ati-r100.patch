+} GLRCmd;
+
+struct ATIRenderer {
+    QemuThread thread;
+    QemuMutex lock;
+    QemuCond cond;
+    GLRCmd *head, *tail;
+    bool ok;
+    char info[256];
+    QemuEvent ready;
+    bool waiting;               /* vCPU waits with the BQL released (BQL) */
+
+    /* render thread only */
+    uint8_t *scratch;           /* RGBA8 rows for uploads and readbacks */
+    size_t scratch_len;
