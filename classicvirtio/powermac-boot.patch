diff --git a/ndrvloader.c b/ndrvloader.c
index 83d0c7f..1afa700 100644
--- a/ndrvloader.c
+++ b/ndrvloader.c
@@ -261,6 +261,42 @@ void chain9p(void) {
 }
 
 void chainNormalBoot(void) {
+	char path[512] = {};
+	long pathlen = 0;
+
+	for (long ph=dtroot(); ph!=0; ph=dtstep(ph)) {
+		long vendorid = 0, deviceid = 0;
+		of("getprop",
+			4, ph, "vendor-id", &vendorid, sizeof vendorid,
+			1, NULL);
+		of("getprop",
+			4, ph, "device-id", &deviceid, sizeof deviceid,
+			1, NULL);
+		if (vendorid != 0x1af4 || virtiotype(deviceid) != 2) continue;
+
+		of("package-to-path",
+			3, ph, path, sizeof path,
+			1, &pathlen);
+		if (pathlen <= 0 || pathlen + 12 >= sizeof path) break;
+		path[pathlen] = 0;
+		strcat(path, ":,\\\\:tbxi");
+
+		long chosenph = 0;
+		of("finddevice",
+			1, "/chosen",
+			1, &chosenph);
+		if (chosenph) {
+			of("setprop",
+				4, chosenph, "classicmac-bootpath",
+				path, strlen(path)+1,
+				1, NULL);
+		}
+		ofprint("Mac OS Virtio startup disk: ");
+		ofprint(path);
+		ofprint("\n");
+		break;
+	}
+
 	of("interpret",
 		1, "boot",
 		0);
