+		(UnitNumber []){0},
+		(DriverFlags []){0},
+		(DriverOpenCount []){0},
+		(Str255){},
+		&deviceRegistryEntry,
+		&(CFragSystem7Locator){.u={.onDisk={.fileSpec=&(FSSpec){}}}},
+		(CFragConnectionID []){0},
+		(DriverEntryPointPtr []){NULL},
+		(DriverDescription []){{}});
+
+	if (RegistryPropertyGetSize(&deviceRegistryEntry, markerName,
+			&markerSize) == noErr) {
+		return false;
+	}
+
+	return RegistryPropertyCreate(&deviceRegistryEntry, markerName,
+		&marker, sizeof marker) == noErr;
+#else
+	return true;
+#endif
