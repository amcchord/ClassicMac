 }
 
+// Like HFS, move vcbLsMod on every change: the Finder (9.2.1 has no FNNotify)
+// looks at its open windows' folders again a few seconds after vcbLsMod changes.
+static void bumpLsMod(void) {
+	unsigned long now = 0;
+	GetDateTime(&now);
+	if (now <= (unsigned long)vcb.vcbLsMod) now = (unsigned long)vcb.vcbLsMod + 1;
+	vcb.vcbLsMod = now;
+}
+
+static struct dirInfo *dirFind(int32_t cnid) {
+	for (int i=0; i<DIRCACHE; i++) {
+		if (dirCache[i].cnid == cnid) return &dirCache[i];
+	}
+	return NULL;
+}
+
+static bool dirFresh(const struct dirInfo *d) {
+	return (uint32_t)(TickCount() - d->checked) < RECHECK_TICKS;
+}
+
+// A change made through this driver: compare every cached folder with the host
+// again when it is next asked for, and do not take a new time of the folders it
+// touched (all of them when cnid is 0) for a host change
+static void dirLocalChange(int32_t cnid) {
+	uint32_t stale = TickCount() - RECHECK_TICKS;
+	for (int i=0; i<DIRCACHE; i++) {
+		dirCache[i].checked = stale;
+		if (cnid == 0 || dirCache[i].cnid == cnid) dirCache[i].local = true;
+	}
+}
+
+// Information about directory cnid, which fid already points to
+static struct dirInfo *dirInfo(int32_t cnid, int32_t parent, const char *name, uint32_t fid) {
+	uint32_t now = TickCount();
+	struct dirInfo *d = dirFind(cnid);
+	if (d != NULL && dirFresh(d)) {
+		d->used = now;
+		return d;
+	}
+
+	struct Stat9 stat = {};
+	bool statOK = Getattr9(fid, STAT_MTIME, &stat) == 0;
+
+	if (d != NULL && statOK && stat.mtime_sec == d->msec && stat.mtime_nsec == d->mnsec) {
+		// Unchanged on the host: only the parent or the name can have changed here
+		d->parent = parent;
+		strcpy(d->name, name);
+		d->checked = d->used = now;
+		d->local = false;
+		return d;
+	}
+
+	// A new time that no call through this driver explains came from the host
+	bool hostChange = (d != NULL) && !d->local;
+
+	if (d == NULL) {
+		d = &dirCache[0];
+		for (int i=0; i<DIRCACHE; i++) {
+			if (dirCache[i].cnid == 0) {
+				d = &dirCache[i];
+				break;
+			}
+			if ((uint32_t)(now - dirCache[i].used) > (uint32_t)(now - d->used)) d = &dirCache[i];
+		}
+	}
+
+	d->cnid = cnid;
+	d->parent = parent;
+	strcpy(d->name, name);
+	MF.DGetAttr(cnid, fid, name, MF_FINFO, &d->attr);
+	d->attr.unixtime = statOK ? (int64_t)stat.mtime_sec : 0;
+	d->msec = statOK ? stat.mtime_sec : 0;
+	d->mnsec = statOK ? stat.mtime_nsec : 0;
+	d->mdate = mactime(d->attr.unixtime);
+	countDir(fid, &d->nall, &d->nfiles);
+	d->checked = d->used = TickCount();
+	d->local = false;
+
+	if (hostChange) {
+		// The host may have changed other folders too: check each again when next asked
+		for (int i=0; i<DIRCACHE; i++) {
+			if (&dirCache[i] != d) dirCache[i].checked = d->checked - RECHECK_TICKS;
+		}
+		bumpLsMod();
+	}
+	return d;
+}
