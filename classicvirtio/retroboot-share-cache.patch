+// RetroBoot: directory information cache (emulator/classicvirtio/README.md).
+// The Finder asks for the share's root folder (GetCatInfo by dirID) as often as
+// every tick, and each answer used to cost a walk, a getattr and a full readdir
+// of the host directory, each waited for in a spin loop.  Answers are now kept
+// and compared with the host directory's modification time at most once a second
+// (one Tgetattr); the directory is read again only when that time changed.  A
+// change that was not made through this driver (the host's) moves vcbLsMod, which
+// the Finder watches to look at its open windows' folders again, so new files
+// appear without user action.
+enum {
+	DIRCACHE = 8,
+	RECHECK_TICKS = 60,
+};
+
+struct dirInfo {
+	int32_t cnid; // 0 = free slot
+	int32_t parent;
+	uint32_t checked; // TickCount() when last compared with the host
+	uint32_t used; // TickCount() when last used, for replacement
+	bool local; // changed through this driver since last compared
+	uint64_t msec, mnsec; // the host directory's modification time
+	int32_t mdate; // the same as a Mac date
+	int16_t nall, nfiles; // visible children: all of them, files only
+	struct MFAttr attr;
+	char name[MAXNAME];
+};
+
+static struct dirInfo dirCache[DIRCACHE];
+static void fillDirPB(struct DirInfo *pb, const struct dirInfo *d);
+
 DriverDescription TheDriverDescription = {
 	kTheDescriptionSignature,
 	kInitialDriverDescriptor,
