+// The Mac clock's offset from the host's UTC clock, rounded to 15 minutes
+static bool clockOffset(int32_t *ret) {
+	static int32_t offset;
+	static uint32_t measured;
+	static bool valid;
+	if (valid && (uint32_t)(TickCount() - measured) < CLOCK_TICKS) {
+		*ret = offset;
+		return true;
+	}
+
+	// The host's time now: a scratch file's modification time set by the server
+	struct Stat9 stat = {};
+	bool ok = false;
+	if (WalkPath9(DOTDIRFID, FIDCOUNT, "clock") == 0 ||
+			(WalkPath9(DOTDIRFID, FIDCOUNT, "") == 0 &&
+			 Lcreate9(FIDCOUNT, O_WRONLY|O_CREAT, 0666, 0, "clock", NULL, NULL) == 0)) {
+		ok = Setattr9(FIDCOUNT, SET_MTIME, (struct Stat9){}) == 0 &&
+			Getattr9(FIDCOUNT, STAT_MTIME, &stat) == 0;
+		Clunk9(FIDCOUNT);
+	}
+	unsigned long mac = 0;
+	GetDateTime(&mac);
+	measured = TickCount();
+	if (!ok) return valid && (*ret = offset, true);
+
+	int64_t diff = (int64_t)mac - MACEPOCH_TO_UNIX - (int64_t)stat.mtime_sec;
+	offset = (int32_t)((diff + (diff >= 0 ? 450 : -450)) / 900 * 900);
+	valid = true;
+	*ret = offset;
+	return true;
+}
+
+// Seconds to add to UTC for the Mac's local time
+static int32_t utcOffset(void) {
+	static int32_t offset;
+	static uint32_t checked;
+	static bool valid;
+	if (valid && (uint32_t)(TickCount() - checked) < LOCATION_TICKS) return offset;
