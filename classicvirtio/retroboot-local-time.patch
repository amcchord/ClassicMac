+		tz = measured; // Mac OS's time zone was never set
+	}
+	if (!valid || tz != offset) {
+		printf("UTC offset %ld s (%s)\n", (long)tz,
+			(loc.latitude == 0 && loc.longitude == 0 && (loc.u.gmtDelta & 0xffffff) == 0) ? "Mac clock" : "Mac OS time zone");
+	}
