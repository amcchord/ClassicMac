+// both the clock and gmtDelta by an hour and only flags DST in the high byte).
+// RetroBoot sets the Mac clock to local time (QEMU -rtc base=localtime with
+// TZ = system.timezone) but not Mac OS's time zone, which then reads as all
+// zeros; the offset is then the Mac clock's own, measured against the host's
+// clock through 9P.  Both are asked again at most once a second and once a
+// minute, so a change of time zone or clock is followed.
+enum {
+	MACEPOCH_TO_UNIX = 24107L*24*60*60, // 1904 to 1970
+	LOCATION_TICKS = 60,
+	CLOCK_TICKS = 60*60,
+};
