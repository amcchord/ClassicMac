+// RetroBoot: a folder's Finder flags live beside it in its parent, FOLDER.idump, in
+// the format of a file's sidecar, so a folder Mac OS makes invisible (the Finder's
+// TheVolumeSettingsFolder, Network Trash Folder, Temporary Items, or the user's
+// own) stays invisible, as on HFS; its label, name lock and custom icon flag are kept
+// too.  Only these flags are kept: not the window's place and view (as before), nor
+// the bookkeeping bits the Finder sets on every folder it sees (kHasBeenInited,
+// 0x0040, 0x0080), so a folder gets a sidecar only while a person-visible flag is
+// set.  The share's root folder keeps nothing.
+#define DIRFLAGS_KEPT 0x540e /* kIsInvisible, kNameLocked, kHasCustomIcon, the label */
+
+static void keptDirFlags(char finfo[16]) {
+	memset(finfo, 0, 8); // frRect
+	finfo[8] &= DIRFLAGS_KEPT >> 8;
+	finfo[9] &= DIRFLAGS_KEPT & 0xff;
+	memset(finfo + 10, 0, 6); // frLocation, frView
+}
+
