+
+// RetroBoot: the name Mac OS sees for a host file or folder (emulator/classicvirtio/README.md,
+// "Names").  A host name that converts to at most 31 characters of Mac OS Roman is shown
+// as it is: written decomposed, as this driver writes names, or precomposed when no
+// decomposed sibling of the same name exists.  Any other name (longer, with characters
+// Mac OS Roman lacks, or a second spelling of a sibling's name) is shown shortened, with
+// '#' and its CNID in hex before a short extension, as Mac OS shows long HFS Plus names:
+// "A rather long report#58E9D7.txt".  CatalogWalk finds such names again
+// (findByMacName).  fid is the item itself, or its folder when fidIsDir.
+void CatalogMacName(unsigned char *roman, const char *host, int32_t cnid, uint32_t fid, bool fidIsDir) {
+	if (cnid == 2) { // the volume
+		mr31name(roman, host);
+		return;
+	}
+
+	int how = mrname(roman, host);
+	if (how != MR_NONE) {
+		char canon[MAXNAME];
+		utf8name(canon, roman);
+		if (!strcmp(canon, host)) return; // as this driver writes it
+		if (how == MR_COMPOSED) {
+			char path[MAXNAME+4] = "../";
+			strcpy(path + 3, canon);
+			if (WalkPath9(fid, NAMEFID, fidIsDir ? canon : path) != 0) return; // no decomposed sibling
+		}
+	}
+
+	unsigned char lossy[256];
+	mrlossy(lossy, 255, host);
+
+	char suffix[12];
+	int n = sprintf(suffix, "#%lX", (unsigned long)(cnid & 0x3fffffff));
+
+	// A short extension stays at the end
+	int dot = 0, extlen = 0;
+	for (int i=lossy[0]; i>1; i--) {
+		if (lossy[i] == '.') {
+			dot = i;
+			break;
+		}
+	}
+	if (dot > 1 && lossy[0] - dot >= 1 && lossy[0] - dot <= 5) extlen = lossy[0] - dot + 1;
+	int stem = extlen ? dot - 1 : lossy[0];
+	if (stem > 31 - n - extlen) stem = 31 - n - extlen;
+
+	memcpy(roman + 1, lossy + 1, stem);
+	memcpy(roman + 1 + stem, suffix, n);
+	memcpy(roman + 1 + stem + n, lossy + 1 + lossy[0] - extlen, extlen);
+	roman[0] = stem + n + extlen;
+}
+
+// Could Mac OS have this name from CatalogMacName for a host name other than the one
+// utf8name gives?  Only with a '#' or a character beyond ASCII; other names fail fast.
+static bool macNameCandidate(const char *mac, int len) {
+	for (int i=0; i<len; i++) {
+		if (mac[i] == '#' || (unsigned char)mac[i] >= 0x80) return true;
+	}
+	return false;
+}
+
+static bool macEqual(const unsigned char *roman, const char *mac, int len, bool ci) {
+	if (roman[0] != len) return false;
+	for (int i=0; i<len; i++) {
+		unsigned char a = roman[i+1], b = mac[i];
+		if (ci) {
+			if (a>='a' && a<='z') a += 'A'-'a';
+			if (b>='a' && b<='z') b += 'A'-'a';
+		}
+		if (a != b) return false;
+	}
+	return true;
+}
+
+// The host name in the folder at el[0..nparent-1] that Mac OS calls mac (exactly, else
+// ignoring ASCII case)
+static bool findByMacName(int nparent, const char *const *parent, const char *mac, int len, char *retname) {
+	uint16_t got = 0;
+	struct Qid9 qids[32];
+	Walk9(ROOTFID, SCANDIRFID, nparent, parent, &got, qids);
+	if (got != nparent) return false;
+	WalkPath9(SCANDIRFID, SCANLISTFID, "");
+	if (Lopen9(SCANLISTFID, O_RDONLY|O_DIRECTORY, NULL, NULL)) return false;
+
+	bool found = false, foundExact = false;
+	char rdbuf[4096];
+	uint64_t magic = 0;
+	uint32_t count = 0;
+	while (!foundExact && (Readdir9(SCANLISTFID, magic, sizeof rdbuf, &count, rdbuf), count>0)) {
+		char *ptr = rdbuf;
+		while (ptr < rdbuf + count) {
+			struct Qid9 qid = {};
+			char type = 0;
+			char name[MAXNAME] = "";
+			DirRecord9(&ptr, &qid, &magic, &type, name);
+			if (name[0] == 0 || name[0] == '.' || MF.IsSidecar(name)) continue;
+			qid.type = (type == 4) ? 0x80 : 0; // readdir's qid type is not meaningful
+			unsigned char roman[32];
+			CatalogMacName(roman, name, QID2CNID(qid), SCANDIRFID, true);
+			if (macEqual(roman, mac, len, false)) {
+				strcpy(retname, name);
+				found = foundExact = true;
+				break;
+			} else if (!found && macEqual(roman, mac, len, true)) {
+				strcpy(retname, name);
+				found = true;
+			}
+		}
+	}
+	Clunk9(SCANLISTFID);
+	return found;
+}
