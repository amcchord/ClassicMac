 /*
+ * RetroBoot hot data pages (-accel tcg,x-hot-data-writes=N, 0 = off).
+ *
+ * A page that holds translated code is write-protected in the softmmu TLB,
+ * so every CPU store to it takes the slow path (notdirty_write), even a
+ * store that the code coverage mask shows touches no code.  Mac OS mixes
+ * code and data on pages (code built on a stack page, fragments next to
+ * their globals); on the PMU machine Quake III's hottest stack frames shared
+ * a page with 45 translated instructions and trapped 600,000 times a second.
+ *
+ * After N trapped stores that missed every TB since the page was last
+ * protected, all TBs on the page are dropped (TBs are only a cache), so the
+ * TLB entry turns writable and the stores run inline.  Code still in use
+ * is translated again and protects the page again.  A page protected again
+ * within HOT_DATA_SOON_MS of a drop doubles its threshold (at most
+ * N << HOT_DATA_MAX_SHIFT); one that stays unprotected longer halves it.
+ * A page holding the TB that is storing is never dropped from that store.
+ */
+#define HOT_DATA_SOON_MS    10
+#define HOT_DATA_CALM_MS    1000
+#define HOT_DATA_MAX_SHIFT  8
+
+static uint32_t hot_data_now_ms(void)
+{
+    uint32_t ms = (uint32_t)(g_get_monotonic_time() / 1000);
+    return ms ? ms : 1;     /* 0 means "no drop pending" */
+}
+
+/* The first TB of a page was just added (page lock held). */
+static void hot_data_reprotected(PageDesc *p)
+{
+    if (p->hot_drop_ms) {
+        uint32_t since = hot_data_now_ms() - p->hot_drop_ms;
+
+        if (since < HOT_DATA_SOON_MS) {
+            if (p->hot_shift < HOT_DATA_MAX_SHIFT) {
+                p->hot_shift++;
+            }
+        } else if (since > HOT_DATA_CALM_MS && p->hot_shift) {
+            p->hot_shift--;
+        }
+        p->hot_drop_ms = 0;
+    }
+    p->hot_writes = 0;
+}
+
+/* Is @tb (the storing TB, or NULL) on the physical page @index? */
+static bool hot_data_tb_on_page(TranslationBlock *tb, tb_page_addr_t index)
+{
+    if (!tb) {
+        return false;
+    }
+    if ((tb_page_addr0(tb) >> TARGET_PAGE_BITS) == index) {
+        return true;
+    }
+    return tb_page_addr1(tb) != -1 &&
+           (tb_page_addr1(tb) >> TARGET_PAGE_BITS) == index;
+}
+
+/*
  * Add the tb in the target page and protect it if necessary.
  * Called with @p->lock held.
  */
@@ -748,6 +816,7 @@
      */
     if (!page_already_protected) {
         tlb_protect_code(tb->page_addr[n] & TARGET_PAGE_MASK);
+        hot_data_reprotected(p);
