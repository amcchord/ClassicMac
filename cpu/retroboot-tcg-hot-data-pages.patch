+    if (!visit_type_uint32(v, name, &value, errp)) {
+        return;
+    }
+    if (value > 0xffff) {
+        error_setg(errp, "x-hot-data-writes must be at most 65535");
+        return;
+    }
+    qatomic_set(&tcg_hot_data_writes, value);
+}
