 }
 
 /*
+ * A trapped store to the code page @p (page @index, lock held) that touched
+ * no code.  Returns true when it dropped the page's TBs (hot data pages,
+ * above) and released the lock itself.
+ */
+static bool hot_data_store(CPUState *cpu, PageDesc *p, tb_page_addr_t index,
+                           uintptr_t ra)
+{
+    unsigned n = qatomic_read(&tcg_hot_data_writes);
+    tb_page_addr_t page_start = index << TARGET_PAGE_BITS;
+    tb_page_addr_t page_last = page_start | ~TARGET_PAGE_MASK;
+    struct page_collection *pages;
+
+    if (!n || ++p->hot_writes < MIN((uint64_t)n << p->hot_shift, 0xffffff)) {
+        return false;
+    }
+    p->hot_writes = 0;
+    if (ra && hot_data_tb_on_page(tcg_tb_lookup(ra), index)) {
+        /* the storing code itself is here: dropping it would only bounce */
+        if (p->hot_shift < HOT_DATA_MAX_SHIFT) {
+            p->hot_shift++;
+        }
+        return false;
+    }
+    qatomic_set(&tb_ctx.tb_hot_data_drops, tb_ctx.tb_hot_data_drops + 1);
+    if (tb_invalidate_phys_page_range__locked(cpu, NULL, p, page_start,
+                                              page_last, ra)) {
+        if (!p->first_tb) {
+            p->hot_drop_ms = hot_data_now_ms();
+        }
+        page_unlock(p);
+        return true;
+    }
+    /* a TB spanning two pages: lock both, as below */
+    page_unlock(p);
+    pages = page_collection_lock(page_start, page_last);
+    tb_invalidate_phys_page_range__locked(cpu, pages, p, page_start,
+                                          page_last, ra);
+    if (!p->first_tb) {
+        p->hot_drop_ms = hot_data_now_ms();
+    }
+    page_collection_unlock(pages);
+    return true;
+}
+
