+static void tcg_get_hot_data_writes(Object *obj, Visitor *v,
+                                    const char *name, void *opaque,
+                                    Error **errp)
+{
+    uint32_t value = qatomic_read(&tcg_hot_data_writes);
+
+    visit_type_uint32(v, name, &value, errp);
+}
+
+static void tcg_set_hot_data_writes(Object *obj, Visitor *v,
+                                    const char *name, void *opaque,
+                                    Error **errp)
+{
+    uint32_t value;
