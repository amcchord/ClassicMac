+/*
+ * RetroBoot (accelerator property x-split-i128, default on): in softmmu, a
+ * 16-byte guest access that needs no 16-byte atomicity (MO_ATOM_NONE or
+ * MO_ATOM_IFALIGN_PAIR, e.g. PowerPC lvx/stvx; always MO_ATOM_NONE with one
+ * vCPU) is emitted as two inline 8-byte accesses with their own TLB fast
+ * paths when the host has no 16-byte load/store (x86-64 without AVX),
+ * instead of a call to helper_ld_i128/helper_st_i128 and its full lookup.
+ */
+extern bool tcg_split_i128;
