+/*
+ * RetroBoot: MSSCR0 of the 7400/7410.  MSSCR0[DL1HWF] (L1 data cache
+ * hardware flush) clears itself when the flush is done; QEMU has no cache to
+ * flush, so it is done at once.  Mac OS 9 (its CPU plugin, before power
+ * management transitions on a PowerBook) and Linux set the bit and poll it
+ * until it clears, which never happened here.  Other bits are stored as
+ * written.
+ */
+void spr_write_msscr0(DisasContext *ctx, int sprn, int gprn)
+{
+    TCGv t0 = tcg_temp_new();
+
+    tcg_gen_andi_tl(t0, cpu_gpr[gprn], ~(target_ulong)0x00800000);
+    gen_store_spr(sprn, t0);
+    spr_store_dump_spr(sprn);
+}
