{
  "name": "classicmac-desktop",
  "version": "4.1.1",
  "description": "ClassicMac for Windows and Linux",
  "author": "Austin McChord",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "electron-builder --win zip --x64 --publish never",
    "prepackage:win": "node scripts/refresh-runtime.cjs",
    "package:linux": "electron-builder --linux tar.gz deb --x64 --publish never",
    "prepackage:linux": "node scripts/refresh-runtime.cjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.classicmac.emulator.desktop",
    "productName": "ClassicMac",
    "directories": {
      "output": "../output/desktop/packages"
    },
    "files": [
      "src/**",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../output/desktop/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "icon": "ui/app.ico"
    },
    "artifactName": "ClassicMac-${version}-${os}-${arch}.${ext}",
    "linux": {
      "executableName": "classicmac",
      "category": "Utility",
      "icon": "ui/app.png",
      "maintainer": "Austin McChord",
      "target": [
        "tar.gz",
        "deb"
      ]
    }
  },
  "homepage": "https://github.com/amcchord/ClassicMac"
}
