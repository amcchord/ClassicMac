+static bool cuda_cmd_get_6805_addr(CUDAState *s,
+                                   const uint8_t *in_data, int in_len,
+                                   uint8_t *out_data, int *out_len)
+{
+    uint16_t addr;
+
+    if (in_len != 2) {
+        return false;
+    }
+    addr = (((uint16_t)in_data[0]) << 8) | in_data[1];
+    if (addr >= 0x100 && addr <= 0x1FF) {
+        int start = addr - 0x100;
+        int n = 256 - start;
+        memcpy(out_data, &s->pram[start], n);
+        *out_len = n;
+    } else if (addr >= 0xF00) {
+        out_data[0] = 0;
+        out_data[1] = 0x00;
+        out_data[2] = 0x19;
+        out_data[3] = 0x00;
+        out_data[4] = 0x02;
+        out_data[5] = 0x00;
+        out_data[6] = 0x29;
+        *out_len = 7;
+    } else {
+        out_data[0] = 0;
+        *out_len = 1;
+    }
+    return true;
+}
+
+static bool cuda_cmd_set_6805_addr(CUDAState *s,
+                                   const uint8_t *in_data, int in_len,
+                                   uint8_t *out_data, int *out_len)
+{
+    uint16_t addr;
+
+    if (in_len < 2) {
+        return false;
+    }
+    addr = (((uint16_t)in_data[0]) << 8) | in_data[1];
+    if (addr >= 0x100 && addr <= 0x1FF) {
+        int start = addr - 0x100;
+        for (int i = 0; i < in_len - 2; i++) {
+            uint8_t idx = (start + i) & 0xFF;
+            s->pram[idx] = in_data[2 + i];
+            if (s->pram_blk) {
+                if (blk_pwrite(s->pram_blk, idx, 1, &s->pram[idx], 0) < 0) {
+                    qemu_log_mask(LOG_GUEST_ERROR, "CUDA: PRAM write failed\n");
+                }
+            }
+        }
+    }
+    return true;
+}
+
+static bool cuda_cmd_get_pram(CUDAState *s,
+                              const uint8_t *in_data, int in_len,
+                              uint8_t *out_data, int *out_len)
+{
+    uint16_t addr;
+
+    if (in_len != 2) {
+        return false;
+    }
+    addr = (((uint16_t)in_data[0]) << 8) | in_data[1];
+    if (addr > 0xFF) {
+        return false;
+    }
+    int n = 256 - addr;
+    memcpy(out_data, &s->pram[addr], n);
+    *out_len = n;
+    return true;
+}
+
+static bool cuda_cmd_set_pram(CUDAState *s,
+                              const uint8_t *in_data, int in_len,
+                              uint8_t *out_data, int *out_len)
+{
+    uint16_t addr;
+
+    if (in_len < 2) {
+        return false;
+    }
+    addr = (((uint16_t)in_data[0]) << 8) | in_data[1];
+    if (addr > 0xFF) {
+        return false;
+    }
+    for (int i = 0; i < in_len - 2; i++) {
+        uint8_t idx = (addr + i) & 0xFF;
+        s->pram[idx] = in_data[2 + i];
+        if (s->pram_blk) {
+            if (blk_pwrite(s->pram_blk, idx, 1, &s->pram[idx], 0) < 0) {
+                qemu_log_mask(LOG_GUEST_ERROR, "CUDA: PRAM write failed\n");
+            }
+        }
+    }
+    return true;
+}
