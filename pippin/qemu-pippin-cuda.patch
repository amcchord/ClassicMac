+}
+
+static bool cuda_cmd_get_set_iic(CUDAState *s,
+                                 const uint8_t *in_data, int in_len,
+                                 uint8_t *out_data, int *out_len)
+{
+    if (in_len < 1 || !s->i2c_cmd) {
+        return false;
+    }
+    return s->i2c_cmd(s->i2c_opaque, in_data[0] >> 1, false, 0,
+                      in_data + 1, in_len - 1, !!(in_data[0] & 1),
+                      out_data, out_len);
+}
+
+static bool cuda_cmd_combined_iic(CUDAState *s,
+                                  const uint8_t *in_data, int in_len,
+                                  uint8_t *out_data, int *out_len)
+{
+    if (in_len < 3 || !s->i2c_cmd) {
+        return false;
+    }
+    if ((in_data[0] & 0xFE) != (in_data[2] & 0xFE)) {
+        return false;
+    }
+    return s->i2c_cmd(s->i2c_opaque, in_data[0] >> 1, true, in_data[1],
+                      in_data + 3, in_len - 3, !!(in_data[2] & 1),
+                      out_data, out_len);
+}
