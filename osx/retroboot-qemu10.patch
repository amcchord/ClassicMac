+#define CORE99_HID0_SLEEP (1u << 21)
+
+typedef struct Core99PMUSleepWork {
+    PMUState *pmu;
+    uint64_t epoch;
+} Core99PMUSleepWork;
+
+/* CPU work runs with the BQL held. This serializes PMU lifecycle changes,
+ * protects the physical RAM read, and keeps register/TLB writes CPU-owned. */
+static void core99_osx_sleep_cpu_check(CPUState *cs, run_on_cpu_data data)
+{
+    Core99PMUSleepWork *work = data.host_ptr;
+    PMUState *s = work->pmu;
+    PowerPCCPU *cpu = POWERPC_CPU(cs);
+    CPUPPCState *env = &cpu->env;
+    MemTxResult result;
+    uint32_t vector;
+
+    if (!qdev_is_realized(DEVICE(s)) || !s->osx_sleep ||
+        work->epoch != s->osx_sleep_epoch) {
+        goto out;
+    }
+    s->osx_check_queued = false;
+    /* HID0 doze/nap and ordinary MSR POW idle are not system sleep. */
+    if (!cs->halted || !(env->msr & ((target_ulong)1 << MSR_POW)) ||
+        !(env->spr[SPR_HID0] & CORE99_HID0_SLEEP)) {
+        goto out;
+    }
+    if (!pmu_osx_sleep_cpu_ready(s, work->epoch)) {
+        goto out;
+    }
+    vector = address_space_ldl_be(&address_space_memory, 0x80,
+                                  MEMTXATTRS_UNSPECIFIED, &result);
+    /* The bounded OS X path uses its physical reset vector. A zero,
+     * arbitrary or stale early vector must never redirect a running CPU. */
+    if (result != MEMTX_OK || vector != 0x100) {
+        trace_pmu_osx_wake_rejected(vector);
+        goto out;       /* keep the accepted sleep and wake handler armed */
+    }
+    env->spr[SPR_HID0] &= ~(target_ulong)(HID0_DOZE | HID0_NAP |
+                                        CORE99_HID0_SLEEP);
+    ppc_store_msr(env, (target_ulong)1 << MSR_ME);
+    env->nip = vector;
+    tlb_flush(cs);
+    cs->halted = 0;
+    trace_pmu_osx_wake_accepted(vector);
+    pmu_osx_sleep_cpu_woken(s, work->epoch);
+out:
+    object_unref(OBJECT(s));
+    g_free(work);
+}
+
+static void core99_osx_pmu_wake(void *opaque, int n, int level)
+{
+    PMUState *s = opaque;
+    Core99PMUSleepWork *work;
+
+    if (!level || !s->osx_cpu || !s->osx_sleep || s->osx_check_queued ||
+        (!s->osx_sleep_pending && !s->osx_sleeping)) {
+        return;
+    }
+    work = g_new0(Core99PMUSleepWork, 1);
+    object_ref(OBJECT(s));
+    work->pmu = s;
+    work->epoch = s->osx_sleep_epoch;
+    s->osx_check_queued = true;
+    /* async_safe_run_on_cpu would drop the BQL around device/RAM state. */
+    async_run_on_cpu(s->osx_cpu, core99_osx_sleep_cpu_check,
+                     RUN_ON_CPU_HOST_PTR(work));
+}
