+/* debug screamer */
+//#define DEBUG_SCREAMER
+
+#ifdef DEBUG_SCREAMER
+#define SCREAMER_DPRINTF(fmt, ...)                                  \
+    do { printf("SCREAMER: " fmt , ## __VA_ARGS__); } while (0)
+#else
