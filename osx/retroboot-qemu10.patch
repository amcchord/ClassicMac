+    /* Observe the physical wake event without hiding it from its USB/ADB
+     * device. The HID device must retain held state while the CPU sleeps.
+     * Keep this object alive until the existing deferred removal; the input
+     * dispatcher still uses it after this callback returns. BQL serialization
+     * prevents a concurrent sleep-state change during this synchronous route.
+     * Use the implementation entry point to avoid recording a second input
+     * event in replay. This is the original event, with no synthetic retry. */
+    qemu_input_handler_deactivate(s->osx_wake_input);
+    s->osx_wake_forwarding = true;
+    qemu_input_event_send_impl(src, evt);
+    s->osx_wake_forwarding = false;
+    if (pmu_osx_sleep_active(s)) {
+        qemu_input_handler_activate(s->osx_wake_input);
+    }
+}
