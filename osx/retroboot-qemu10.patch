+#ifndef HW_AUDIO_SCREAMER_H
+#define HW_AUDIO_SCREAMER_H
+
+#include "hw/sysbus.h"
+#include "hw/ppc/mac_dbdma.h"
+#include "audio/audio.h"
+
+#define TYPE_SCREAMER "screamer"
+OBJECT_DECLARE_SIMPLE_TYPE(ScreamerState, SCREAMER)
+
+#define SCREAMER_LEGACY_BUFFER_SIZE 0x4000
+#define SCREAMER_BUFFER_SIZE 0x10000  /* RetroBoot: 371 ms at 44.1 kHz (was 16 KB) */
+
+struct ScreamerState {
+    /*< private >*/
+    SysBusDevice parent_obj;
+
+    /*< public >*/
+    MemoryRegion mem;
+    qemu_irq irq;
+    void *dbdma;
+    qemu_irq dma_tx_irq;
+    qemu_irq dma_rx_irq;
+
+    QEMUSoundCard card;
+    SWVoiceOut *voice;
+    uint8_t  buf[SCREAMER_BUFFER_SIZE];
+    uint32_t bpos;
+    uint32_t ppos;
+    uint32_t rate;
+    DBDMA_io io;
+
+    uint32_t regs[6];
+    uint32_t codec_ctrl_regs[8];
+
+    /* RetroBoot: output DMA at the codec's pace, frame counter (screamer.c) */
+    bool osx_codec;             /* opt-in OS X codec contract */
+    bool paced_dma;             /* property paced-dma */
+    bool frame_count;           /* property frame-count */
+    uint32_t frame_base;        /* writable counter origin, independent of DMA */
+    uint32_t frames;            /* frames taken by the output DMA */
+    QEMUTimer *dma_timer;
+    bool osx_input_dma;
+    QEMUTimer *rx_timer;
+    DBDMA_io *rx_pending;
+    DBDMA_io *dma_pending;      /* OUTPUT command waiting for its play time */
+    int64_t codec_ns;           /* when the codec has played what it holds */
+    bool host_started;          /* pre-roll reached since the stream began */
+    bool vol_pending;           /* codec volume change waiting for vol_pos */
+    uint32_t vol_pos;           /* ring offset the change applies from */
+
+    /* RetroBoot: real-time codec clock and host lead (screamer.c) */
+    uint32_t dma_lead_us;       /* property dma-lead-us: DMA ahead of the codec */
+    uint32_t resync_ms;         /* property resync-ms: longer pauses restart the clock */
+    uint32_t host_lead_ms;      /* property host-lead-ms: pre-roll floor */
+    uint32_t host_lead_max_ms;  /* property host-lead-max-ms: pre-roll ceiling */
+    uint32_t lead_ms;           /* current pre-roll */
+    int64_t dma_ns;             /* when the last output command completes */
+    int64_t host_t0_ns;         /* host stream (re)started */
+    uint64_t host_frames;       /* frames handed to the host since then */
+    int64_t underrun_ns;        /* last host underrun (or lead decay step) */
+    uint32_t underruns;         /* statistics (trace) */
+    uint32_t dropped;
+    bool host_lead_strict;      /* property host-lead-strict: an idle DMA waits too */
+    int64_t preroll_ns;         /* the current pre-roll began (0: none) */
+
+    uint32_t idle_stop_ms;      /* stop the host stream after this long */
+    bool voice_active;
+    int64_t last_audio_ns;      /* last guest output (QEMU_CLOCK_VIRTUAL) */
+};
+
+void macio_screamer_register_dma(ScreamerState *s, void *dbdma,
+                                 int txchannel, int rxchannel);
+
+#endif
