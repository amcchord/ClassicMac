+    /* A legacy/no-USB configuration can have no other matching handler. */
+    if (s->osx_wake_forwarding) {
+        return;
+    }
+    if (pmu_osx_sleep_active(s) &&
+        ((evt->type == INPUT_EVENT_KIND_KEY && evt->u.key.data->down) ||
+         (evt->type == INPUT_EVENT_KIND_BTN && evt->u.btn.data->down))) {
+        s->osx_wake_latched = true;
+        trace_pmu_osx_wake(evt->type == INPUT_EVENT_KIND_KEY ? "key latched" :
+                                                              "button latched");
+        pmu_osx_sleep_poll_soon(s);
+    }
