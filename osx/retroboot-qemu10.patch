+/* chip registers */
+#define SND_CTRL_REG   0x0
+#define CODEC_CTRL_REG 0x1
+#define CODEC_STAT_REG 0x2
+#define CLIP_CNT_REG   0x3
+#define BYTE_SWAP_REG  0x4
+#define FRAME_CNT_REG  0x5
+
+#define CODEC_CTRL_MASKECMD        (0x1 << 24)
+#define CODEC_CTRL1_RECALIBRATE    0x4
+
+#define CODEC_STAT_MANUFACTURER_CRYSTAL    0x100
+#define CODEC_STAT_AWACS_REVISION          0x3000
+#define CODEC_STAT_MASK_VALID              (0x1 << 22)
+
+/* Audio */
+static const char *s_spk = "screamer";
+
+/*
+ * RetroBoot: output DMA at the codec's pace.
+ *
+ * Mac OS's sound driver double-buffers: its DBDMA program loads the frame
+ * counter (LOAD_WORD of FRAME_CNT_REG), outputs one half of a ring buffer,
+ * stores a "half done" flag with an interrupt, does the same for the other
+ * half and stops; the interrupt handler refills the half that has played
+ * and restarts or extends the program.  QEMU completed every OUTPUT command
+ * at once while its 16 KB staging buffer had room, so both halves (and up
+ * to four whole programs) "played" within microseconds: the two half-done
+ * interrupts merged into one, the frame-counter stamps were all equal (the
+ * register read a constant), and the Sound Manager's play position stopped
+ * advancing.  QuickTime runs a movie's clock from that position, so movies
+ * with sound froze at 00:00:00 with a silent sound channel; whether a
+ * given boot got through depended on host and guest timing.
+ *
+ * When osx-codec enables paced-dma each OUTPUT command's data is taken when the
+ * command starts, as the DBDMA engine would, and the command completes when
+ * the codec has played it, on QEMU's virtual clock at the selected sample
+ * rate, so the guest sees its interrupts and frame-counter stamps one
+ * buffer apart as on the hardware (the codec clock and the host stream's
+ * pre-roll are described below).  FRAME_CNT_REG counts the frames the
+ * output DMA has taken (frame-count, default on).
+ *
+ * Codec volume and mute changes take effect at the point of the stream
+ * where the guest made them: audio already taken by the DMA but not yet
+ * handed to the host keeps the old setting.  Mac OS mutes the codec as soon
+ * as a sound's last buffer has played; applied to the host voice at once,
+ * that cut off whatever QEMU still had queued (with the old instantaneous
+ * DMA, nearly every alert, and the Sound control panel and volume-key
+ * feedback sounds entirely).
+ */
+/*
+ * RetroBoot: the codec's clock runs in real time, whatever QEMU's or the
+ * guest's latency (package r12 let it slip).
+ *
+ * Each output command used to complete one play time after the moment it
+ * started, so every delay before the next command started was lost for
+ * good: the main loop's timer latency (some 15 us per 1 ms command on an
+ * idle host, more under load), and above all the time Mac OS takes to
+ * re-arm its DBDMA program when its sound interrupt is serviced late (on a
+ * slow host the program ran out every 70 ms and sat 10-23 ms until Mac OS
+ * restarted it).  The DMA delivered 4.6 s of a QuickTime soundtrack in 5.1 s
+ * on the lab builder and in 9.4 s with its vCPU at 30 % of a core, so the
+ * host stream, consumed in real time, ran dry over and over (ALSA
+ * underruns on the N5105 and N4100 laptops: sound in bursts).
+ *
+ * Now the codec keeps a continuous timeline: a command completes when the
+ * codec, counting from where the previous one ended, has played it, less
+ * dma-lead-us (the DMA engine runs that far ahead of the codec, like the
+ * hardware's FIFO).  Behind that timeline the DMA catches up at up to
+ * twice real time, spaced on its own schedule (timer latency does not slow
+ * it) or, after it sat idle, from the moment it starts again; twice real
+ * time keeps the guest's half-buffer interrupts apart (all at once, they
+ * merge: package r11).  A pause longer than resync-ms ends the stream: the
+ * next sound starts a new timeline.
+ *
+ * The host stream starts once the current lead (host-lead-ms at first) is
+ * queued.  If it then runs dry while the DMA is running (QEMU handed the
+ * host less than it has played since the stream started) the lead grows by
+ * SCREAMER_LEAD_STEP_MS up to host-lead-max-ms and the stream pre-rolls
+ * again; the lead shrinks one step per SCREAMER_LEAD_DECAY_S without an
+ * underrun, when a stream starts.  When the host falls a whole buffer
+ * (371 ms) behind, the oldest audio is dropped: the guest keeps its
+ * real-time pace (QuickTime's clock runs from it) instead of waiting.
+ */
+/*
+ * RetroBoot: a pre-roll that holds on a slow guest (host-lead-strict).
+ *
+ * The host stream starts once the lead is queued, or at once when no output
+ * command is pending, so that a sound shorter than the lead still plays.  On
+ * a slow guest the second rule also fired in the gap between two of Mac OS's
+ * DBDMA programs (the driver restarts its program from the half-done
+ * interrupt, a millisecond or more later on the Gemini PDA's vCPU): when the
+ * 10 ms audio timer met that gap, the stream started with what was queued
+ * (35 ms instead of a 120 ms lead in one QuickTime run), and the next long
+ * wait for the guest (irq-hold, up to 100 ms when QuickTime starts a sound)
+ * ran the host dry.  With host-lead-strict an idle DMA starts the stream only
+ * once the lead's time has passed since the pre-roll began: a short sound
+ * starts one lead after its first data, like a long one.  Off by default (the
+ * PCs' behaviour); hostd turns it on for the Gemini PDA.
+ */
+#define SCREAMER_LEAD_STEP_MS   20
+#define SCREAMER_IDLE_NS        (2 * SCALE_MS)  /* longer: the DMA was idle */
+#define SCREAMER_LEAD_DECAY_S   20
+
+static void screamer_update_volume(ScreamerState *s);
+
+/* Exact original QEMU10 behavior remains the default. */
+
+static void pmac_screamer_tx_transfer_legacy(DBDMA_io *io)
+{
+    ScreamerState *s = io->opaque;
+
+    SCREAMER_DPRINTF("DMA TX transfer: addr %" HWADDR_PRIx
+                     " len: %x  bpos: %d\n", io->addr, io->len, s->bpos);
+
+    dma_memory_read(&address_space_memory, io->addr, &s->buf[s->bpos], io->len,
+                    MEMTXATTRS_UNSPECIFIED);
+
+    s->bpos += io->len;
+
+    /* Indicate success */
+    io->len = 0;
+
+    /* Finish */
+    io->dma_end(io);
+}
+
+static void pmac_screamer_tx_legacy(DBDMA_io *io)
+{
+    ScreamerState *s = io->opaque;
+
+    if (s->bpos + io->len > SCREAMER_LEGACY_BUFFER_SIZE) {
+        /* Not enough space in the buffer, so defer IRQ */
+        memcpy(&s->io, io, sizeof(DBDMA_io));
+
+        SCREAMER_DPRINTF("DMA TX defer interrupt!\n");
+        return;
+    }
+
+    s->io.addr = 0;
+    s->io.len = 0;
+
+    pmac_screamer_tx_transfer_legacy(io);
+}
+
+static void pmac_screamer_tx_flush_legacy(DBDMA_io *io)
+{
+    DBDMA_channel *ch = io->channel;
+    dbdma_cmd *current = &ch->current;
+    uint16_t cmd;
+
+    SCREAMER_DPRINTF("DMA TX flush!\n");
+
+    cmd = le16_to_cpu(current->command) & COMMAND_MASK;
+    if (cmd == OUTPUT_MORE || cmd == OUTPUT_LAST ||
+        cmd == INPUT_MORE || cmd == INPUT_LAST) {
+        current->xfer_status = cpu_to_le16(ch->regs[DBDMA_STATUS]);
+        current->res_count = cpu_to_le16(io->len);
+
+        dma_memory_write(&address_space_memory, ch->regs[DBDMA_CMDPTR_LO],
+                         &ch->current, sizeof(dbdma_cmd),
+                         MEMTXATTRS_UNSPECIFIED);
+    }
+}
+
+static void screamerspk_callback_legacy(void *opaque, int avail)
+{
+    ScreamerState *s = opaque;
+    int n, len;
+
+    if (s->bpos) {
+        if (s->ppos < s->bpos) {
+            n = MIN(s->bpos - s->ppos, (unsigned int)avail);
+            SCREAMER_DPRINTF("########### AUDIO WRITE! %d / %d - %d\n", s->ppos, s->bpos, n);
+            len = AUD_write(s->voice, &s->buf[s->ppos], n);
+            s->ppos += len;
+            return;
+        }
+    }
+
+    if (s->io.len) {
+        /* Deferred IRQ */
+        s->bpos = 0;
+        s->ppos = 0;
+
+        SCREAMER_DPRINTF("Processing deferred buffer\n");
+        pmac_screamer_tx_transfer_legacy(&s->io);
+    }
+}
+
+static void screamer_codec_write_legacy(ScreamerState *s, hwaddr addr, uint64_t val)
+{
+    SCREAMER_DPRINTF("%s: addr " HWADDR_FMT_plx " val %" PRIx64 "\n", __func__, addr, val);
+
+    switch (addr) {
+    case 0x1:
+        /* Clear recalibrate if set */
+        val = val & ~CODEC_CTRL1_RECALIBRATE;
+
+        /* Update volume in case mute set */
+        screamer_update_volume(s);
+        break;
+
+    case 0x4:
+        /* Speaker attenuation */
+        screamer_update_volume(s);
+        break;
+    }
+
+    s->codec_ctrl_regs[addr] = val;
+}
+
+static uint32_t screamer_bytes_per_ms(ScreamerState *s)
+{
+    return s->rate * 4 / 1000;                  /* 16-bit stereo */
+}
+
+/* Room for @len more bytes: drop what the host has already played. */
+static bool screamer_make_room(ScreamerState *s, uint32_t len)
+{
+    if (s->vol_pending && s->ppos >= s->vol_pos) {
+        s->vol_pending = false;
+        screamer_update_volume(s);
+    }
+    if (s->ppos >= s->bpos) {
+        s->bpos = s->ppos = 0;
+    } else if (s->bpos + len > SCREAMER_BUFFER_SIZE && s->ppos) {
+        memmove(s->buf, &s->buf[s->ppos], s->bpos - s->ppos);
+        s->bpos -= s->ppos;
+        s->vol_pos -= MIN(s->vol_pos, s->ppos);
+        s->ppos = 0;
+    }
+    return s->bpos + len <= SCREAMER_BUFFER_SIZE;
+}
+
+/* Hand queued audio to the host, applying a volume change where it was made. */
+static void screamer_host_write(ScreamerState *s, int avail)
+{
+    while (avail > 0 && s->ppos < s->bpos) {
+        uint32_t end = s->bpos;
+        int len;
+
+        if (s->vol_pending) {
+            if (s->ppos >= s->vol_pos) {
+                s->vol_pending = false;
+                screamer_update_volume(s);
+            } else {
+                end = s->vol_pos;
+            }
+        }
+        len = AUD_write(s->voice, &s->buf[s->ppos],
+                             MIN(end - s->ppos, (uint32_t)avail));
+        if (len <= 0) {
+            break;
+        }
+        s->ppos += len;
+        avail -= len;
+    }
+    if (s->vol_pending && s->ppos >= s->vol_pos) {
+        s->vol_pending = false;
+        screamer_update_volume(s);
+    }
+    s->last_audio_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+static void screamer_dma_done(void *opaque)
+{
+    ScreamerState *s = opaque;
+    DBDMA_io *io = s->dma_pending;
+
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    trace_screamer_dma_done((now - s->codec_ns) / 1000);
+    if (io) {
+        s->dma_pending = NULL;
+        io->dma_end(io);
+    }
+}
+
+/*
+ * Mac OS stops the output DMA when it has nothing to play.  After
+ * idle_stop_ms without guest output the voice is made inactive, which stops
+ * QEMU's audio timer and the host stream (an idle sound device can power
+ * down); the next output DMA starts it again.
+ */
+static void screamer_voice_active(ScreamerState *s, bool on)
+{
+    s->last_audio_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (s->voice && s->voice_active != on) {
+        AUD_set_active_out(s->voice, on);
+        s->voice_active = on;
+    }
+}
+
+static void pmac_screamer_tx_transfer(DBDMA_io *io)
+{
+    ScreamerState *s = io->opaque;
+
+    if (!s->osx_codec) {
+        pmac_screamer_tx_transfer_legacy(io);
+        return;
+    }
+
+    SCREAMER_DPRINTF("DMA TX transfer: addr %" HWADDR_PRIx
+                     " len: %x  bpos: %d\n", io->addr, io->len, s->bpos);
+
+    dma_memory_read(&address_space_memory, io->addr, &s->buf[s->bpos], io->len,
+                    MEMTXATTRS_UNSPECIFIED);
+
+    s->bpos += io->len;
+    s->frames += io->len / 4;                   /* 16-bit stereo */
+
+    if (s->paced_dma) {
+        /* complete when the codec has played this command */
+        int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        int64_t play = muldiv64(io->len / 4, NANOSECONDS_PER_SECOND, s->rate);
+        int64_t due;
+
+        trace_screamer_out(io->len, (now - s->codec_ns) / 1000, s->bpos - s->ppos, s->frames);
+        if (now - s->codec_ns > (int64_t)s->resync_ms * SCALE_MS) {
+            s->codec_ns = now;                  /* a new stream */
+        }
+        s->codec_ns += play;                    /* continuous timeline */
+        /* behind the codec: catch up at up to twice real time (see above) */
+        due = now - s->dma_ns > SCREAMER_IDLE_NS ? now : s->dma_ns;
+        s->dma_ns = MAX(s->codec_ns - (int64_t)s->dma_lead_us * SCALE_US,
+                        due + play / 2);
+        io->len = 0;
+        s->dma_pending = io;
+        timer_mod(s->dma_timer, s->dma_ns);
+        return;
+    }
+
+    /* Indicate success */
+    io->len = 0;
+
+    /* Finish */
+    io->dma_end(io);
+}
+
+static void pmac_screamer_tx(DBDMA_io *io)
+{
+    ScreamerState *s = io->opaque;
+
+    if (!s->osx_codec) {
+        pmac_screamer_tx_legacy(io);
+        return;
+    }
+
+    if (!s->host_started && s->bpos == s->ppos && s->lead_ms > s->host_lead_ms &&
+        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->underrun_ns >
+        SCREAMER_LEAD_DECAY_S * NANOSECONDS_PER_SECOND) {
+        s->lead_ms = MAX(s->lead_ms - SCREAMER_LEAD_STEP_MS, s->host_lead_ms);
+        s->underrun_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);  /* next step later */
+    }
+    screamer_voice_active(s, true);
+
+    if (s->paced_dma && io->len <= SCREAMER_BUFFER_SIZE) {
+        if (!screamer_make_room(s, io->len)) {
+            /* the host is a whole buffer behind: drop its oldest audio */
+            uint32_t queued = s->bpos - s->ppos;
+            uint32_t drop = MIN(queued, queued + io->len - SCREAMER_BUFFER_SIZE);
+
+            s->ppos += drop;
+            s->dropped += drop;
+            trace_screamer_drop(drop, s->dropped);
+            screamer_make_room(s, io->len);
+        }
+        pmac_screamer_tx_transfer(io);
+        return;
+    }
+    if (s->bpos + io->len > SCREAMER_BUFFER_SIZE) {
+        /* Not enough space in the buffer, so defer IRQ */
+        memcpy(&s->io, io, sizeof(DBDMA_io));
+
+        SCREAMER_DPRINTF("DMA TX defer interrupt!\n");
+        return;
+    }
+
+    s->io.addr = 0;
+    s->io.len = 0;
+
+    pmac_screamer_tx_transfer(io);
+}
+
+static bool screamer_dma_stopping(DBDMA_channel *ch)
+{
+    uint32_t ctrl = ch->regs[DBDMA_CONTROL];
+    uint32_t mask = ctrl >> 16;
+
+    return ((mask & RUN) && !(ctrl & RUN)) ||
+           ((mask & PAUSE) && (ctrl & PAUSE));
+}
+
+static void pmac_screamer_tx_flush(DBDMA_io *io)
+{
+    ScreamerState *s = io->opaque;
+
+    if (!s->osx_codec) {
+        pmac_screamer_tx_flush_legacy(io);
+        return;
+    }
+    DBDMA_channel *ch = io->channel;
+    dbdma_cmd *current = &ch->current;
+    uint16_t cmd;
+
+    SCREAMER_DPRINTF("DMA TX flush!\n");
+
+    if (s->dma_pending && s->dma_pending->channel == io->channel) {
+        io = s->dma_pending;
+        timer_del(s->dma_timer);
+        s->dma_pending = NULL;
+        if (screamer_dma_stopping(ch)) {
+            /* stopped: the command ends here, no interrupt or branch */
+            io->processing = false;
+        } else {
+            io->dma_end(io);                    /* FLUSH while running */
+            return;
+        }
+    }
+
+    cmd = le16_to_cpu(current->command) & COMMAND_MASK;
+    if (cmd == OUTPUT_MORE || cmd == OUTPUT_LAST ||
+        cmd == INPUT_MORE || cmd == INPUT_LAST) {
+        current->xfer_status = cpu_to_le16(ch->regs[DBDMA_STATUS]);
+        current->res_count = cpu_to_le16(io->len);
+
+        dma_memory_write(&address_space_memory, ch->regs[DBDMA_CMDPTR_LO],
+                         &ch->current, sizeof(dbdma_cmd),
+                         MEMTXATTRS_UNSPECIFIED);
+    }
+}
+
+static void screamer_osx_rx_done(void *opaque)
+{
+    ScreamerState *s = opaque;
+    DBDMA_io *io = s->rx_pending;
+    s->rx_pending = NULL;
+    if (!io) {
+        return;
+    }
+    dma_memory_set(&address_space_memory, io->addr, 0, io->len,
+                   MEMTXATTRS_UNSPECIFIED);
+    io->len = 0;
+    io->dma_end(io);
+}
+
+static void pmac_screamer_rx(DBDMA_io *io)
+{
+    SCREAMER_DPRINTF("DMA RX transfer: addr %" HWADDR_PRIx
+                     " len: %x\n", io->addr, io->len);
+
+    ScreamerState *s = io->opaque;
+    DBDMAState *dbs = s->dbdma;
+    DBDMA_channel *ch = &dbs->channels[0x12];
+
+    if (s->osx_codec && s->osx_input_dma) {
+        int64_t play = muldiv64(io->len / 4, NANOSECONDS_PER_SECOND, s->rate);
+        /* Apple02DBDMAAudio checks that input remains active at every output
+         * ring interrupt, even for an output-only application. */
+        s->rx_pending = io;
+        timer_mod(s->rx_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + play);
+        return;
+    }
+
+    /* FIXME: stop channel after updating with status to stop MacOS 9 freezing */
+    ch->regs[DBDMA_STATUS] = 0x0;
+
+    io->dma_end(io);
+}
+
+static void pmac_screamer_rx_flush(DBDMA_io *io)
+{
+    ScreamerState *s = io->opaque;
+    DBDMA_channel *ch = io->channel;
+    dbdma_cmd *current = &ch->current;
+    uint16_t cmd;
+
+    SCREAMER_DPRINTF("DMA RX flush!\n");
+
+    if (s->osx_codec && s->osx_input_dma && s->rx_pending &&
+        s->rx_pending->channel == io->channel) {
+        timer_del(s->rx_timer);
+        s->rx_pending = NULL;
+        if (screamer_dma_stopping(ch)) {
+            io->processing = false;
+        } else {
+            io->dma_end(io);
+            return;
+        }
+    }
+
+    cmd = le16_to_cpu(current->command) & COMMAND_MASK;
+    if (cmd == OUTPUT_MORE || cmd == OUTPUT_LAST ||
+        cmd == INPUT_MORE || cmd == INPUT_LAST) {
+        current->xfer_status = cpu_to_le16(ch->regs[DBDMA_STATUS]);
+        current->res_count = cpu_to_le16(io->len);
+
+        dma_memory_write(&address_space_memory, ch->regs[DBDMA_CMDPTR_LO],
+                         &ch->current, sizeof(dbdma_cmd),
+                         MEMTXATTRS_UNSPECIFIED);
+    }
+}
+
+void macio_screamer_register_dma(ScreamerState *s, void *dbdma, int txchannel, int rxchannel)
+{
+    DBDMAState *dbs = dbdma;
+
+    s->dbdma = dbdma;
+    dbs->channels[txchannel].software_status = s->osx_codec;
+    dbs->channels[rxchannel].software_status = s->osx_codec;
+    DBDMA_register_channel(dbdma, txchannel, s->dma_tx_irq,
+                           pmac_screamer_tx, pmac_screamer_tx_flush, s);
+    DBDMA_register_channel(dbdma, rxchannel, s->dma_rx_irq,
+                           pmac_screamer_rx, pmac_screamer_rx_flush, s);
+}
+
+static void screamerspk_callback(void *opaque, int avail)
+{
+    ScreamerState *s = opaque;
+
+    if (!s->osx_codec) {
+        screamerspk_callback_legacy(opaque, avail);
+        return;
+    }
+    int n, len;
+
+    if (s->paced_dma) {
+        int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        uint32_t queued;
+
+        if (s->io.len && !s->dma_pending && screamer_make_room(s, s->io.len)) {
+            pmac_screamer_tx_transfer(&s->io);  /* a command that found no room */
+        }
+        queued = s->bpos - s->ppos;
+        if (queued && !s->host_started && !s->preroll_ns) {
+            s->preroll_ns = now;                /* a pre-roll begins */
+        }
+
+        if (s->host_started && s->dma_pending &&
+            muldiv64(now - s->host_t0_ns, s->rate, NANOSECONDS_PER_SECOND) >
+            s->host_frames + s->rate / 500) {
+            /* the host has played more than it got (2 ms slack): it ran dry */
+            s->underruns++;
+            s->underrun_ns = now;
+            s->lead_ms = MIN(s->lead_ms + SCREAMER_LEAD_STEP_MS,
+                             MAX(s->host_lead_max_ms, s->host_lead_ms));
+            s->host_started = false;            /* pre-roll the larger lead */
+            s->preroll_ns = now;
+            trace_screamer_underrun(s->underruns, s->lead_ms, queued);
+        }
+        if (!queued) {
+            if (!s->dma_pending &&
+                now - s->dma_ns > (int64_t)s->resync_ms * SCALE_MS) {
+                s->host_started = false;        /* stream ended */
+            }
+        } else if (s->host_started ||
+                   queued >= s->lead_ms * screamer_bytes_per_ms(s) ||
+                   (!s->dma_pending &&
+                    (!s->host_lead_strict ||
+                     now - s->preroll_ns >= (int64_t)s->lead_ms * SCALE_MS))) {
+            uint32_t before = s->ppos;
+
+            if (!s->host_started) {
+                s->host_started = true;
+                s->host_t0_ns = now;
+                s->host_frames = 0;
+                s->preroll_ns = 0;
+            }
+            screamer_host_write(s, avail);
+            s->host_frames += (s->ppos - before) / 4;
+            trace_screamer_host(avail, queued, s->ppos - before);
+            return;
+        } else {
+            return;                             /* pre-roll */
+        }
+    } else if (s->bpos) {
+        if (s->ppos < s->bpos) {
+            n = MIN(s->bpos - s->ppos, (unsigned int)avail);
+            SCREAMER_DPRINTF("########### AUDIO WRITE! %d / %d - %d\n", s->ppos, s->bpos, n);
+            len = AUD_write(s->voice, &s->buf[s->ppos], n);
+            s->ppos += len;
+            s->last_audio_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+            return;
+        }
+    }
+
+    if (s->io.len) {
+        /* Deferred IRQ */
+        s->bpos = 0;
+        s->ppos = 0;
+
+        SCREAMER_DPRINTF("Processing deferred buffer\n");
+        pmac_screamer_tx_transfer(&s->io);
+        s->last_audio_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        return;
+    }
+    if (s->idle_stop_ms &&
+        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->last_audio_ns >=
+        (int64_t)s->idle_stop_ms * SCALE_MS) {
+        screamer_voice_active(s, false);
+    }
+}
+
+static void screamer_update_settings(ScreamerState *s)
+{
+    struct audsettings as = { s->rate, 2, AUDIO_FORMAT_S16,
+        s->regs[BYTE_SWAP_REG] ? false : true };
+
+    if (!s->card.state) {
+        return;
+    }
+
+    s->voice = AUD_open_out(&s->card, s->voice, s_spk, s,
+                                 screamerspk_callback, &as);
+    if (!s->voice) {
+        qemu_log_mask(LOG_GUEST_ERROR, "screamer: could not open voice\n");
+        return;
+    }
+
+    AUD_set_active_out(s->voice, true);
+    s->voice_active = true;
+    s->last_audio_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+static void screamer_update_volume(ScreamerState *s)
+{
+    bool muted = s->codec_ctrl_regs[0x1] & 0x80 ? true : false;
+    uint8_t att_left = (s->codec_ctrl_regs[0x4] & 0xf);
+    uint8_t att_right = (s->codec_ctrl_regs[0x4] & 0x3c0) >> 6;
+
+    SCREAMER_DPRINTF("setting mute: %d, attenuation L: %d R: %d\n",
+                     muted, att_left, att_right);
+    trace_screamer_volume(muted, att_left, att_right);
+
+    if (!s->voice) {
+        return;
+    }
+
+    AUD_set_volume_out(s->voice, muted,
+                               (0xf - att_left) << 4, (0xf - att_right) << 4);
+}
+
+static void screamer_reset(DeviceState *dev)
+{
+    ScreamerState *s = SCREAMER(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->codec_ctrl_regs, 0, sizeof(s->codec_ctrl_regs));
+
+    s->rate = 44100;
+    s->bpos = 0;
+    s->ppos = 0;
+    s->frames = 0;
+    s->frame_base = 0;
+    s->codec_ns = 0;
+    s->host_started = false;
+    s->preroll_ns = 0;
+    s->vol_pending = false;
+    s->lead_ms = s->host_lead_ms;
+    s->underrun_ns = 0;
+    s->dma_ns = 0;
+    if (s->dma_pending) {
+        s->dma_pending->processing = false;
+        timer_del(s->dma_timer);
+        s->dma_pending = NULL;
+    }
+
+    if (s->rx_pending) {
+        s->rx_pending->processing = false;
+        timer_del(s->rx_timer);
+        s->rx_pending = NULL;
+    }
+
+    screamer_update_settings(s);
+
+    return;
+}
+
+static void screamer_realizefn(DeviceState *dev, Error **errp)
+{
+    ScreamerState *s = SCREAMER(dev);
+
+    if (!AUD_register_card("Screamer", &s->card, errp)) {
+        return;
+    }
+    if (s->osx_codec) {
+        s->dma_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, screamer_dma_done, s);
+    }
+    if (s->osx_codec && s->osx_input_dma) {
+        s->rx_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, screamer_osx_rx_done, s);
+    }
+}
+
+static void screamer_control_write(ScreamerState *s, uint32_t val)
+{
+    SCREAMER_DPRINTF("%s: val %" PRId32 "\n", __func__, val);
+
+    /* Basic rate selection */
+    switch ((val & 0x700) >> 8) {
+    case 0x00:
+        s->rate = 44100;
+        break;
+    case 0x1:
+        s->rate = 29400;
+        break;
+    case 0x2:
+        s->rate = 22050;
+        break;
+    case 0x3:
+        s->rate = 17640;
+        break;
+    case 0x4:
+        s->rate = 14700;
+        break;
+    case 0x5:
+        s->rate = 11025;
+        break;
+    case 0x6:
+        s->rate = 8820;
+        break;
+    case 0x7:
+        s->rate = 7350;
+        break;
+    }
+
+    SCREAMER_DPRINTF("basic rate: %d\n", s->rate);
+    screamer_update_settings(s);
+
+    s->regs[0] = val;
+}
+
+static void screamer_codec_write(ScreamerState *s, hwaddr addr, uint64_t val)
+{
+    if (!s->osx_codec) {
+        screamer_codec_write_legacy(s, addr, val);
+        return;
+    }
+
+    SCREAMER_DPRINTF("%s: addr " HWADDR_FMT_plx " val %" PRIx64 "\n", __func__, addr, val);
+
+    switch (addr) {
+    case 0x1:
+        /* Clear recalibrate if set */
+        val = val & ~CODEC_CTRL1_RECALIBRATE;
+        break;
+    }
+
+    s->codec_ctrl_regs[addr] = val;
+
+    /*
+     * RetroBoot: apply mute (register 1) and the attenuation (register 4)
+     * Mac OS has just written; updating before the store applied the
+     * previous value, one volume step late.
+     */
+    if (addr == 0x1 || addr == 0x4) {
+        if (s->paced_dma && s->ppos < s->bpos) {
+            /* at the stream position of the write (see the top of the file) */
+            s->vol_pending = true;
+            s->vol_pos = s->bpos;
+        } else {
+            s->vol_pending = false;
+            screamer_update_volume(s);
+        }
+    }
+}
+
+static uint32_t screamer_frame_position(ScreamerState *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint64_t ahead = s->paced_dma && s->codec_ns > now ?
+        muldiv64(s->codec_ns - now, s->rate, NANOSECONDS_PER_SECOND) : 0;
+
+    return s->frame_base + s->frames - (uint32_t)ahead;
+}
+
+static uint64_t screamer_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ScreamerState *s = opaque;
+    uint32_t val;
+
+    addr = addr >> 4;
+    switch (addr) {
+    case SND_CTRL_REG:
+        val = s->regs[addr];
+        break;
+    case CODEC_CTRL_REG:
+        val = s->regs[addr] & ~CODEC_CTRL_MASKECMD;
+        break;
+    case CODEC_STAT_REG:
+        if (s->codec_ctrl_regs[7] & 1) {
+            /* Read back mode */
+            val = s->codec_ctrl_regs[(s->codec_ctrl_regs[7] >> 1) & 0xe];
+        } else {
+            /* Return status register */
+            val = s->regs[addr] & ~0xff00;
+            val |= CODEC_STAT_MANUFACTURER_CRYSTAL | CODEC_STAT_AWACS_REVISION |
+                   CODEC_STAT_MASK_VALID;
+        }
+        break;
+    case CLIP_CNT_REG:
+    case BYTE_SWAP_REG:
+        val = s->regs[addr];
+        break;
+    case FRAME_CNT_REG:
+        if (s->osx_codec && s->frame_count) {
+            val = screamer_frame_position(s);
+        } else {
+            val = s->regs[addr];
+        }
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP,
+                  "screamer: Unimplemented register read "
+                  "reg 0x%" HWADDR_PRIx " size 0x%x\n",
+                  addr, size);
+        val = 0;
+        break;
+    }
+
+    SCREAMER_DPRINTF("%s: addr " HWADDR_FMT_plx " -> %x\n", __func__, addr, val);
+
+    return val;
+}
+
+static void screamer_write(void *opaque, hwaddr addr,
+                           uint64_t val, unsigned size)
+{
+    ScreamerState *s = opaque;
+    uint32_t codec_addr;
+
+    addr = addr >> 4;
+
+    SCREAMER_DPRINTF("%s: addr " HWADDR_FMT_plx " val %" PRIx64 "\n", __func__, addr, val);
+
+    switch (addr) {
+    case SND_CTRL_REG:
+        screamer_control_write(s, val & 0xffffffff);
+        break;
+    case CODEC_CTRL_REG:
+        s->regs[addr] = val & 0xffffffff;
+        codec_addr = (val & 0x7fff) >> 12;
+        screamer_codec_write(s, codec_addr, val & 0xfff);
+        break;
+    case FRAME_CNT_REG:
+        if (!s->osx_codec) {
+            goto unimplemented;
+        }
+        s->regs[addr] = val;
+        if (s->osx_codec && s->frame_count) {
+            /* A counter write changes its origin, not the codec schedule. */
+            s->frame_base += (uint32_t)val - screamer_frame_position(s);
+        }
+        break;
+    case CODEC_STAT_REG:
+    case CLIP_CNT_REG:
+    case BYTE_SWAP_REG:
+        s->regs[addr] = val & 0xffffffff;
+        break;
+    default:
+    unimplemented:
+        qemu_log_mask(LOG_UNIMP,
+                  "screamer: Unimplemented register write "
+                  "reg 0x%" HWADDR_PRIx " size 0x%x value 0x%" PRIx64 "\n",
+                  addr, size, val);
+        break;
+    }
+
+    return;
+}
+
+static const MemoryRegionOps screamer_ops = {
+    .read = screamer_read,
+    .write = screamer_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    }
+};
+
+static void screamer_initfn(Object *obj)
+{
+    SysBusDevice *d = SYS_BUS_DEVICE(obj);
+    ScreamerState *s = SCREAMER(obj);
+
+    memory_region_init_io(&s->mem, obj, &screamer_ops, s, "screamer", 0x1000);
+    sysbus_init_mmio(d, &s->mem);
+    sysbus_init_irq(d, &s->irq);
+    sysbus_init_irq(d, &s->dma_tx_irq);
+    sysbus_init_irq(d, &s->dma_rx_irq);
+}
+
+static const Property screamer_properties[] = {
+    DEFINE_PROP_BOOL("osx-codec", ScreamerState, osx_codec, false),
+    DEFINE_PROP_BOOL("osx-input-dma", ScreamerState, osx_input_dma, true),
+    DEFINE_AUDIO_PROPERTIES(ScreamerState, card),
+    DEFINE_PROP_UINT32("idle-stop-ms", ScreamerState, idle_stop_ms, 1000),
+    DEFINE_PROP_BOOL("paced-dma", ScreamerState, paced_dma, true),
+    DEFINE_PROP_BOOL("frame-count", ScreamerState, frame_count, true),
+    DEFINE_PROP_UINT32("dma-lead-us", ScreamerState, dma_lead_us, 5000),
+    DEFINE_PROP_UINT32("resync-ms", ScreamerState, resync_ms, 200),
+    DEFINE_PROP_UINT32("host-lead-ms", ScreamerState, host_lead_ms, 40),
+    DEFINE_PROP_UINT32("host-lead-max-ms", ScreamerState, host_lead_max_ms, 120),
+    DEFINE_PROP_BOOL("host-lead-strict", ScreamerState, host_lead_strict, false),
+};
+
+static void screamer_class_init(ObjectClass *oc, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = screamer_realizefn;
+    device_class_set_legacy_reset(dc, screamer_reset);
+    set_bit(DEVICE_CATEGORY_SOUND, dc->categories);
+    device_class_set_props(dc, screamer_properties);
+}
+
+static const TypeInfo screamer_type_info = {
+    .name = TYPE_SCREAMER,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ScreamerState),
+    .instance_init = screamer_initfn,
+    .class_init = screamer_class_init,
+};
+
+static void screamer_register_types(void)
+{
+    type_register_static(&screamer_type_info);
+}
