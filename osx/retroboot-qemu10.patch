+/*
+ * QEMU ATI Radeon (R100) emulation: memory controller view and
+ * command processor (CP, "PM4"), emulated at the packet level.
+ *
+ * Copyright (c) 2026 RetroBoot contributors
+ *
+ * This work is licensed under the GNU GPL license version 2 or later.
+ *
+ * Register offsets and packet layouts follow AMD's R100 documentation and
+ * the register definitions in the X.org/Linux radeon drivers.  The CP
+ * microcode the guest uploads is kept (so it reads back) but not executed:
+ * packets are interpreted directly.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/bswap.h"
+#include "exec/address-spaces.h"
+#include "exec/cpu-common.h"
+#include "hw/pci/pci_bus.h"
+#include "hw/pci-host/uninorth.h"
+#include "ati_int.h"
+#include "ati_regs.h"
+#include "trace.h"
+
+#define CP_PACKET_MAX_DWORDS 0x4000
+
+/* ---------------------------------------------------------------------
+ * Memory controller address space
+ *
+ * The CP, the bus-master engines and the 3D unit address memory with
+ * card ("MC") addresses: MC_FB_LOCATION maps VRAM, MC_AGP_LOCATION the AGP
+ * aperture (AGP_BASE = bus address), and a PCI card's GART (AIC_*) maps
+ * pages of system memory through a table in system memory.  Anything else is
+ * treated as a bus address (PCI cards bus-master straight to RAM).
+ */
+
+/* AIC page-table entries resolve ordinary PCI DMA addresses. UniNorth's
+ * AGP aperture is a separate transaction domain; applying it to an already
+ * resolved AIC page performs a second translation. Other PCI host IOMMUs
+ * still use the normal PCI bus-master address space. */
+static bool ati_aic_pci_rw(ATIVGAState *s, uint64_t addr, void *buf,
+                           uint64_t len, bool write)
+{
+    AddressSpace *as = pci_get_address_space(&s->dev);
+    DeviceState *parent = BUS(pci_get_bus(&s->dev))->parent;
+    Object *host = parent ? object_dynamic_cast(OBJECT(parent),
+                               TYPE_UNI_NORTH_PCI_HOST_BRIDGE) : NULL;
+
+    if (!(pci_get_word(s->dev.config + PCI_COMMAND) & PCI_COMMAND_MASTER)) {
+        if (!write) {
+            memset(buf, 0, len);
+        }
+        return false;
+    }
+    if (host) {
+        UNINHostState *unin = UNI_NORTH_PCI_HOST_BRIDGE(host);
+        if (unin->agp_compat && s->dev.devfn == unin->agp_devfn) {
+            as = &address_space_memory;
+        }
+    }
+    return address_space_rw(as, addr, MEMTXATTRS_UNSPECIFIED, buf, len,
+                            write) == MEMTX_OK;
+}
+
+static uint64_t ati_mc_fb_start(ATIVGAState *s)
+{
+    return (uint64_t)(s->regfile[MC_FB_LOCATION / 4] & 0xffff) << 16;
+}
+
+static uint64_t ati_mc_fb_end(ATIVGAState *s)
+{
+    return ((uint64_t)(s->regfile[MC_FB_LOCATION / 4] >> 16) << 16) | 0xffff;
+}
+
+/*
+ * Translate an MC address. Returns ATI_MC_VRAM with *off set to the VRAM
+ * offset, ATI_MC_BUS with *off = bus address, or ATI_MC_NONE.
+ * *contig is the number of bytes that are contiguous from there.
+ */
+int ati_mc_translate(ATIVGAState *s, uint64_t mc, uint64_t *off,
+                     uint64_t *contig)
+{
+    uint64_t fb_start = ati_mc_fb_start(s), fb_end = ati_mc_fb_end(s);
+    uint32_t aic = s->regfile[ATI_AIC_CNTL / 4];
+
+    *contig = 0x1000 - (mc & 0xfff);
+
+    if (fb_end > fb_start && mc >= fb_start && mc <= fb_end) {
+        uint64_t o = mc - fb_start;
+        if (o >= s->vga.vram_size) {
+            return ATI_MC_NONE;
+        }
+        *off = o;
+        *contig = s->vga.vram_size - o;
+        return ATI_MC_VRAM;
+    }
+    if (aic & 1) {      /* PCIGART_TRANSLATE_EN */
+        uint64_t lo = s->regfile[ATI_AIC_LO_ADDR / 4];
+        uint64_t hi = s->regfile[ATI_AIC_HI_ADDR / 4];
+        if (mc >= lo && mc <= hi) {
+            uint64_t page = (mc - lo) >> 12;
+            uint64_t pte_addr = s->regfile[ATI_AIC_PT_BASE / 4] + page * 4;
+            uint32_t pte = 0;
+            if (!ati_aic_pci_rw(s, pte_addr, &pte, sizeof(pte), false)) {
+                return ATI_MC_NONE;
+            }
+            pte = ldl_le_p(&pte);
+            *off = (pte & ~0xfffULL) | (mc & 0xfff);
+            *contig = 0x1000 - (mc & 0xfff);
+            return ATI_MC_PCI_PHYS;
+        }
+    }
+    {
+        uint32_t agp = s->regfile[MC_AGP_LOCATION / 4];
+        uint64_t a_start = (uint64_t)(agp & 0xffff) << 16;
+        uint64_t a_end = ((uint64_t)(agp >> 16) << 16) | 0xffff;
+        if (a_end > a_start && mc >= a_start && mc <= a_end) {
+            *off = s->regfile[AGP_BASE / 4] + (mc - a_start);
+            *contig = a_end + 1 - mc;
+            return ATI_MC_BUS;
+        }
+    }
+    *off = mc;
+    *contig = UINT64_MAX;
+    return ATI_MC_BUS;
+}
+
+bool ati_mc_rw(ATIVGAState *s, uint64_t mc, void *buf, uint64_t len,
+               bool write)
+{
+    uint8_t *p = buf;
+
+    while (len) {
+        uint64_t off, contig, n;
+        int kind = ati_mc_translate(s, mc, &off, &contig);
+
+        n = MIN(len, contig);
+        if (kind == ATI_MC_VRAM) {
+            if (write) {
+                memcpy(s->vga.vram_ptr + off, p, n);
+                memory_region_set_dirty(&s->vga.vram, off, n);
+            } else {
+                memcpy(p, s->vga.vram_ptr + off, n);
+            }
+        } else if (kind == ATI_MC_PCI_PHYS) {
+            if (!ati_aic_pci_rw(s, off, p, n, write)) {
+                return false;
+            }
+        } else if (kind == ATI_MC_BUS) {
+            if (write) {
+                if (pci_dma_write(&s->dev, off, p, n) != MEMTX_OK) {
+                    return false;
+                }
+            } else {
+                if (pci_dma_read(&s->dev, off, p, n) != MEMTX_OK) {
+                    return false;
+                }
+            }
+        } else {
+            qemu_log_mask(LOG_GUEST_ERROR, "ati: MC access to unmapped 0x%"
+                          PRIx64 "\n", mc);
+            if (!write) {
+                memset(p, 0, n);
+            }
+            return false;
+        }
+        p += n;
+        mc += n;
+        len -= n;
+    }
+    return true;
+}
+
+/* Eligibility-only flat RAM proof. Do not invoke MemoryRegion/IOMMU read
+ * callbacks while deciding whether a source can omit unrelated GPU drains.
+ * Aliases resolve to their final flat MR; readonly alias attributes remain in
+ * the section. No pointer/reference escapes this BQL-held probe. */
+static bool ati_mc_ram_piece(ATIVGAState *s, AddressSpace *as, uint64_t addr,
+                             uint64_t *len, uint32_t *pte)
+{
+    MemoryRegionSection part = memory_region_find(as->root, addr, *len);
+    MemoryRegion *mr = part.mr;
+    bool ok = false;
+    uint64_t n;
+    if (!mr || !memory_region_is_ram(mr) || memory_region_is_rom(mr) ||
+        memory_region_is_ram_device(mr) || mr == &s->vga.vram ||
+        part.readonly || mr->readonly ||
+        part.offset_within_address_space != addr ||
+        !int128_gt(part.size, int128_zero())) goto done;
+    n = MIN(*len, int128_get64(part.size));
+    if (!n || part.offset_within_region > memory_region_size(mr) ||
+        n > memory_region_size(mr) - part.offset_within_region ||
+        (pte && n != 4)) goto done;
+    uint8_t *ptr = memory_region_get_ram_ptr(mr) + part.offset_within_region;
+    uintptr_t lo = (uintptr_t)ptr, end = lo + n;
+    uintptr_t vram = (uintptr_t)s->vga.vram_ptr;
+    if (end < lo || (lo < vram + s->vga.vram_size && vram < end)) goto done;
+    if (pte) *pte = ldl_le_p(ptr);
+    *len = n;
+    ok = true;
+done:
+    if (mr) memory_region_unref(mr);
+    return ok;
+}
+
+/* Mirror only the exact selected UniNorth compatibility mapper already
+ * installed by this machine. The flat section must be that object's IOMMU;
+ * unknown/nested IOMMUs stay rejected. Read the known bridge config directly
+ * and its LE PTE only from independently proven physical RAM. Do not invoke
+ * the IOMMU callback (which may read a table through MMIO). AIC-resolved PCI
+ * physical addresses use their existing bypass and never enter this helper.
+ */
+static bool ati_mc_uninorth_ram_piece(ATIVGAState *s, AddressSpace *as,
+                                      uint64_t addr, uint64_t *len)
+{
+    DeviceState *parent = BUS(pci_get_bus(&s->dev))->parent;
+    Object *host = parent ? object_dynamic_cast(OBJECT(parent),
+                                   TYPE_UNI_NORTH_PCI_HOST_BRIDGE) : NULL;
+    if (!host || !s->agp || as != pci_get_address_space(&s->dev)) return false;
+    UNINHostState *unin = UNI_NORTH_PCI_HOST_BRIDGE(host);
+    if (!unin->agp_compat || s->dev.devfn != unin->agp_devfn ||
+        !unin->agp_bridge ||
+        !(pci_get_word(s->dev.config + PCI_COMMAND) & PCI_COMMAND_MASTER)) {
+        return false;
+    }
+    MemoryRegionSection part = memory_region_find(as->root, addr, *len);
+    bool exact = part.mr == MEMORY_REGION(&unin->agp_iommu) &&
+        !part.readonly && part.offset_within_address_space == addr &&
+        part.offset_within_region == addr &&
+        int128_ge(part.size,int128_make64(*len));
+    if (part.mr) memory_region_unref(part.mr);
+    if (!exact) return false;
+    uint64_t n = MIN(*len, 0x1000 - (addr & 0xfff));
+    uint64_t physical = addr;
+    PCIDevice *bridge = unin->agp_bridge;
+    uint32_t base = pci_get_long(bridge->config + 0x8c);
+    uint64_t start = pci_get_long(bridge->config + 0x90) & 0xf0000000;
+    uint64_t length = (base & 0xfff) * 4ULL * 1024 * 1024;
+    if ((pci_get_long(bridge->config + 0x94) & 0x100) &&
+        addr >= start && addr - start < length) {
+        uint64_t pte_addr = (base & ~0xfffULL) + ((addr-start) >> 12)*4;
+        uint64_t pte_len = 4;
+        uint32_t pte;
+        if (!ati_mc_ram_piece(s,&address_space_memory,pte_addr,&pte_len,&pte) ||
+            !(pte & 1)) return false;
+        physical = (pte & ~0xfffULL) | (addr & 0xfff);
+    }
+    if (!ati_mc_ram_piece(s,&address_space_memory,physical,&n,NULL)) return false;
+    *len = n;
+    return true;
+}
+
+/* Source must be complete ordinary writable/readable RAM, including all
+ * stride padding in its supplied envelope. Unknown IOMMU sections, VRAM,
+ * MMIO, RAM devices, ROM/readonly aliases and invalid AIC tables fail closed.
+ * AIC PTEs are read only after the same side-effect-free RAM proof. */
+bool ati_mc_ordinary_ram_source(ATIVGAState *s, uint64_t mc, uint64_t len)
+{
+    if (!len || len > 32 * MiB || mc >= (1ULL << 32) ||
+        len > (1ULL << 32) - mc ||
+        !(pci_get_word(s->dev.config + PCI_COMMAND) & PCI_COMMAND_MASTER)) {
+        return false;
+    }
+    AddressSpace *aic_as = pci_get_address_space(&s->dev);
+    DeviceState *parent = BUS(pci_get_bus(&s->dev))->parent;
+    Object *host = parent ? object_dynamic_cast(OBJECT(parent),
+                                    TYPE_UNI_NORTH_PCI_HOST_BRIDGE) : NULL;
+    if (host) {
+        UNINHostState *unin = UNI_NORTH_PCI_HOST_BRIDGE(host);
+        if (unin->agp_compat && s->dev.devfn == unin->agp_devfn) {
+            aic_as = &address_space_memory;
+        }
+    }
+    while (len) {
+        uint64_t fb_start = ati_mc_fb_start(s), fb_end = ati_mc_fb_end(s);
+        uint64_t off = mc, n = len;
+        AddressSpace *as = pci_get_address_space(&s->dev);
+        uint64_t lo = s->regfile[ATI_AIC_LO_ADDR / 4];
+        uint64_t hi = s->regfile[ATI_AIC_HI_ADDR / 4];
+        if (fb_end > fb_start && mc >= fb_start && mc <= fb_end) return false;
+        if ((s->regfile[ATI_AIC_CNTL / 4] & 1) && mc >= lo && mc <= hi) {
+            uint64_t page = (mc - lo) >> 12;
+            uint64_t addr = s->regfile[ATI_AIC_PT_BASE / 4] + page * 4;
+            uint64_t pte_len = 4;
+            uint32_t pte;
+            if (!ati_mc_ram_piece(s,aic_as,addr,&pte_len,&pte)) return false;
+            off = (pte & ~0xfffULL) | (mc & 0xfff);
+            n = MIN(n, 0x1000 - (mc & 0xfff));
+            n = MIN(n, hi + 1 - mc);
+            as = aic_as;
+        } else {
+            uint32_t agp = s->regfile[MC_AGP_LOCATION / 4];
+            uint64_t start = (uint64_t)(agp & 0xffff) << 16;
+            uint64_t end = ((uint64_t)(agp >> 16) << 16) | 0xffff;
+            if (end > start && mc >= start && mc <= end) {
+                off = s->regfile[AGP_BASE / 4] + (mc - start);
+                n = MIN(n, end + 1 - mc);
+            }
+            /* Do not cross into a later mapping-precedence range. */
+            if (fb_end > fb_start && mc < fb_start) n = MIN(n, fb_start-mc);
+            if ((s->regfile[ATI_AIC_CNTL / 4] & 1) && mc < lo) n = MIN(n,lo-mc);
+            if (end > start && mc < start) n = MIN(n,start-mc);
+        }
+        if (!n) return false;
+        if (!ati_mc_ram_piece(s,as,off,&n,NULL) &&
+            !ati_mc_uninorth_ram_piece(s,as,off,&n)) return false;
+        mc += n;
+        len -= n;
+    }
+    return true;
+}
+
+/* Depth backing may be VRAM or ordinary DMA RAM, never recursive MMIO.
+ * AIC aliases to a framebuffer aperture would recurse through coherence while
+ * exporting that same surface and are rejected explicitly in the opt-in mode. */
+bool ati_mc_depth_memory_supported(ATIVGAState *s, uint64_t mc, uint64_t len)
+{
+    while (len) {
+        uint64_t offset, contiguous;
+        int kind = ati_mc_translate(s, mc, &offset, &contiguous);
+        uint64_t n = MIN(len, contiguous);
+        if (!n || kind == ATI_MC_NONE) {
+            return false;
+        }
+        if (kind != ATI_MC_VRAM) {
+            AddressSpace *as = pci_get_address_space(&s->dev);
+            DeviceState *parent = BUS(pci_get_bus(&s->dev))->parent;
+            Object *host = parent ? object_dynamic_cast(OBJECT(parent),
+                                    TYPE_UNI_NORTH_PCI_HOST_BRIDGE) : NULL;
+            if (kind == ATI_MC_PCI_PHYS && host) {
+                UNINHostState *unin = UNI_NORTH_PCI_HOST_BRIDGE(host);
+                if (unin->agp_compat && s->dev.devfn == unin->agp_devfn) {
+                    as = &address_space_memory;
+                }
+            }
+            hwaddr translated, mapped = n;
+            MemoryRegion *mr = address_space_translate(as, offset, &translated,
+                                      &mapped, true, MEMTXATTRS_UNSPECIFIED);
+            if (!mr || !mapped || !memory_region_is_ram(mr) ||
+                memory_region_is_rom(mr)) {
+                return false;
+            }
+            n = MIN(n, mapped);
+            /* address_space_translate() returns the final MR but drops
+             * readonly attributes inherited through aliases. Validate the
+             * actual flat section as well; an intervening IOMMU section is
+             * intentionally unsupported rather than guessed writable. */
+            MemoryRegionSection section = memory_region_find(as->root,
+                                                             offset, n);
+            bool writable = section.mr == mr && !section.readonly &&
+                section.offset_within_address_space == offset &&
+                section.offset_within_region == translated &&
+                int128_ge(section.size, int128_make64(n));
+            if (section.mr) {
+                memory_region_unref(section.mr);
+            }
+            if (!writable) {
+                return false;
+            }
+        }
+        mc += n;
+        len -= n;
+    }
+    return true;
+}
+
+/* ---------------------------------------------------------------------
+ * Packet execution
+ */
+
+static void ati_cp_exec_ib(ATIVGAState *s, uint32_t base, uint32_t ndw);
+
+/*
+ * Execute one complete packet starting at pkt[0]; avail dwords are present.
+ * Returns the packet length in dwords, or 0 if it is incomplete.
+ */
+static unsigned ati_cp_packet(ATIVGAState *s, const uint32_t *pkt,
+                              unsigned avail)
+{
+    uint32_t h = pkt[0];
+    unsigned type = h >> 30, count, i;
+
+    switch (type) {
+    case 0:
+    {
+        uint32_t reg = (h & 0x1fff) << 2;
+        bool one = h & BIT(15);
+        count = ((h >> 16) & 0x3fff) + 1;
+        if (avail < count + 1) {
+            return 0;
+        }
+        trace_ati_cp_packet0(reg, count, one);
+        for (i = 0; i < count; i++) {
+            ati_reg_write(s, one ? reg : reg + 4 * i, pkt[1 + i]);
+        }
+        return count + 1;
+    }
+    case 1:
+        if (avail < 3) {
+            return 0;
+        }
+        ati_reg_write(s, (h & 0x7ff) << 2, pkt[1]);
+        ati_reg_write(s, ((h >> 11) & 0x7ff) << 2, pkt[2]);
+        return 3;
+    case 2:
+        return 1;
+    default:
+    {
+        uint8_t op = (h >> 8) & 0xff;
+        count = ((h >> 16) & 0x3fff) + 1;
+        if (avail < count + 1) {
+            return 0;
+        }
+        trace_ati_cp_packet3(op, count);
+        s->cp.packets3++;
+        switch (op) {
+        case 0x10:  /* NOP */
+        case 0x24:  /* LOAD_MICROCODE */
+            break;
+        case 0x26:  /* WAIT_FOR_IDLE: expose completed draws to CPU reads */
+            ati_3d_sync(s, ATI_SYNC_CP_WAIT);
+            break;
+        case 0x33:  /* INDX_BUFFER: indirect buffer of 3D indices handled
+                       by the 3D draw that uses it */
+            ati_3d_packet(s, op, &pkt[1], count);
+            break;
+        case 0x91 ... 0x9f:   /* 2D CNTL packets */
+            ati_2d_packet(s, op, &pkt[1], count);
+            break;
+        case 0x20 ... 0x23:
+        case 0x25:
+        case 0x28 ... 0x2f:
+        case 0x32:
+        case 0x34 ... 0x3f:
+            ati_3d_packet(s, op, &pkt[1], count);
+            break;
+        default:
+            qemu_log_mask(LOG_UNIMP, "ati: CP packet3 op 0x%02x (%u dwords)\n",
+                          op, count);
+            break;
+        }
+        return count + 1;
+    }
+    }
+}
+
+/* run complete packets in buf[0..n); returns dwords consumed */
+static unsigned ati_cp_run(ATIVGAState *s, const uint32_t *buf, unsigned n)
+{
+    unsigned pos = 0;
+
+    while (pos < n) {
+        unsigned len = ati_cp_packet(s, buf + pos, n - pos);
+        if (!len) {
+            break;
+        }
+        pos += len;
+    }
+    return pos;
+}
+
+static void ati_cp_fetch(ATIVGAState *s, uint64_t mc, uint32_t *dst,
+                         unsigned ndw, bool swap32)
+{
+    ati_mc_rw(s, mc, dst, (uint64_t)ndw * 4, false);
+    for (unsigned i = 0; i < ndw; i++) {
+        dst[i] = swap32 ? ldl_be_p(&dst[i]) : ldl_le_p(&dst[i]);
+    }
+}
+
+static void ati_cp_exec_ib(ATIVGAState *s, uint32_t base, uint32_t ndw)
+{
+    uint32_t *buf;
+    unsigned done;
+
+    if (!ndw || ndw > 1 << 20) {
+        return;
+    }
+    if (s->cp.depth > 4) {
+        qemu_log_mask(LOG_GUEST_ERROR, "ati: indirect buffers nested too deep\n");
+        return;
+    }
+    s->cp.depth++;
+    buf = g_new(uint32_t, ndw);
+    /* indirect buffers use the ring's swap setting */
+    ati_cp_fetch(s, base, buf, ndw, (s->regfile[CP_RB_CNTL / 4] >> 16) & 3);
+    trace_ati_cp_ib(base, ndw);
+    s->accel.ib_dw += ndw;
+    done = ati_cp_run(s, buf, ndw);
+    if (done != ndw) {
+        qemu_log_mask(LOG_GUEST_ERROR, "ati: indirect buffer ends inside a "
+                      "packet (%u of %u dwords)\n", done, ndw);
+    }
+    g_free(buf);
+    s->cp.depth--;
+}
+
+/* bus-master ring: run everything between RPTR and WPTR */
+static void ati_cp_ring_kick(ATIVGAState *s)
+{
+    uint32_t cntl = s->regfile[CP_RB_CNTL / 4];
+    unsigned size = 2u << (cntl & 0x3f);           /* dwords */
+    uint32_t wptr = s->regfile[CP_RB_WPTR / 4] & (size - 1);
+    uint32_t rptr = s->cp.rptr & (size - 1);
+    uint64_t base = s->regfile[CP_RB_BASE / 4];
+    bool swap = (cntl >> 16) & 3;
+    unsigned n, done;
+    uint32_t *buf;
+
+    if (size > (1u << 22) || rptr == wptr) {
+        return;
+    }
+    n = (wptr - rptr) & (size - 1);
+    buf = g_new(uint32_t, n);
+    if (rptr + n <= size) {
+        ati_cp_fetch(s, base + rptr * 4, buf, n, swap);
+    } else {
+        unsigned first = size - rptr;
+        ati_cp_fetch(s, base + rptr * 4, buf, first, swap);
+        ati_cp_fetch(s, base, buf + first, n - first, swap);
+    }
+    trace_ati_cp_ring(rptr, wptr, n);
+    s->accel.ring_dw += n;
+    done = ati_cp_run(s, buf, n);
+    g_free(buf);
+    s->cp.rptr = (rptr + done) & (size - 1);
+    if (!(cntl & BIT(27))) {            /* RB_NO_UPDATE */
+        uint32_t addr = s->regfile[CP_RB_RPTR_ADDR / 4];
+        uint32_t v = s->cp.rptr;
+        uint32_t out = (addr & 3) == 2 ? cpu_to_be32(v) : cpu_to_le32(v);
+        ati_mc_rw(s, addr & ~3u, &out, 4, true);
+    }
+}
+
+/*
+ * PIO queues (CP_CSQ_APER_PRIMARY / INDIRECT).  The aperture is a FIFO port:
+ * the address within it does not order anything (Mac OS's ATI queue server
+ * writes every indirect-buffer packet at offset 0 and every timestamp packet
+ * at offset 12).  Packets run as soon as they are complete.
+ */
+static void ati_cp_pio_write(ATIVGAState *s, int q, unsigned slot, uint32_t dw)
+{
+    ATICPQueue *pq = &s->cp.pio[q];
+    unsigned done;
+
+    (void)slot;
+    s->accel.pio_dw++;
+    if (pq->n >= ARRAY_SIZE(pq->buf)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "ati: PIO packet too long, dropped\n");
+        pq->n = 0;
+    }
+    pq->buf[pq->n++] = dw;
+    done = ati_cp_run(s, pq->buf, pq->n);
+    if (done) {
+        memmove(pq->buf, pq->buf + done, (pq->n - done) * 4);
+        pq->n -= done;
+    }
+}
+
+/* ---------------------------------------------------------------------
+ * Register interface
+ */
+
+bool ati_cp_write(ATIVGAState *s, hwaddr addr, uint32_t data)
+{
+    switch (addr) {
+    case CP_RB_BASE:
+        s->cp.rptr = 0;
+        return true;
+    case CP_RB_RPTR_WR:
+        s->cp.rptr = data;
+        return true;
+    case CP_RB_WPTR:
+        ati_cp_ring_kick(s);
+        return true;
+    case CP_IB_BUFSZ:
+        ati_cp_exec_ib(s, s->regfile[CP_IB_BASE / 4], data & 0x7fffff);
+        return true;
+    case CP_ME_RAM_ADDR:
+        s->cp.me_addr = data & 0xff;
+        return true;
+    case CP_ME_RAM_RADDR:
+        s->cp.me_addr = data & 0xff;
+        return true;
+    case CP_ME_RAM_DATAH:
+        s->cp.me_ram[s->cp.me_addr].hi = data;
+        return true;
+    case CP_ME_RAM_DATAL:
+        s->cp.me_ram[s->cp.me_addr].lo = data;
+        s->cp.me_addr = (s->cp.me_addr + 1) & 0xff;
+        return true;
+    case CP_CSQ_APER_PRIMARY ... CP_CSQ_APER_PRIMARY + 0x1fc:
+        ati_cp_pio_write(s, 0, (addr - CP_CSQ_APER_PRIMARY) / 4, data);
+        return true;
+    case CP_CSQ_APER_INDIRECT ... CP_CSQ_APER_INDIRECT + 0xfc:
+        ati_cp_pio_write(s, 1, (addr - CP_CSQ_APER_INDIRECT) / 4, data);
+        return true;
+    case WAIT_UNTIL:
+        /* Idle/clean waits also complete GL-backed 2D fills. */
+        if (data & (BIT(14) | BIT(15) | BIT(16) | BIT(17) | BIT(18))) {
+            ati_3d_sync(s, ATI_SYNC_CP_WAIT);
+        }
+        return true;
+    case SCRATCH_REG0 ... SCRATCH_REG5:
+    {
+        int i = (addr - SCRATCH_REG0) / 4;
+
+        /* Completion must not become visible ahead of framebuffer data. */
+        ati_3d_sync(s, ATI_SYNC_STATUS);
+        if (s->regfile[SCRATCH_UMSK / 4] & BIT(i)) {
+            uint32_t out = cpu_to_le32(data);
+            ati_mc_rw(s, s->regfile[SCRATCH_ADDR / 4] + 4 * i, &out, 4, true);
+        }
+        return true;
+    }
+    default:
+        return false;
+    }
+}
+
+bool ati_cp_read(ATIVGAState *s, hwaddr addr, uint32_t *val)
+{
+    switch (addr) {
+    case CP_RB_RPTR:
+        *val = s->cp.rptr;
+        return true;
+    case CP_ME_RAM_DATAH:
+        *val = s->cp.me_ram[s->cp.me_addr].hi;
+        return true;
+    case CP_ME_RAM_DATAL:
+        *val = s->cp.me_ram[s->cp.me_addr].lo;
+        s->cp.me_addr = (s->cp.me_addr + 1) & 0xff;
+        return true;
+    case CP_CSQ_CNTL:
+        /*
+         * CSQ_CNT_PRIMARY (bits 7:0) counts free primary-queue entries; the
+         * PIO queues drain immediately here, so they are always empty.
+         */
+        *val = (s->regfile[CP_CSQ_CNTL / 4] & 0xf0000000) | 0xc0;
+        return true;
+    case CP_CSQ_STAT:
+        /* queues always drained: read pointers equal write pointers */
+        *val = 0;
+        return true;
+    case CP_STAT:
+        *val = 0;
+        return true;
+    default:
+        return false;
+    }
+}
+
+void ati_cp_reset(ATIVGAState *s)
+{
+    memset(&s->cp, 0, sizeof(s->cp));
+}
diff --git a/hw/display/ati_gl.c b/hw/display/ati_gl.c
new file mode 100644
index 00000000..4849bf87
--- /dev/null
+++ b/hw/display/ati_gl.c
@@ -0,0 +1,285 @@
+/*
+ * QEMU ATI Radeon (R100) emulation: run-time EGL/GLES loader.
+ *
+ * Copyright (c) 2026 RetroBoot contributors
+ *
+ * This work is licensed under the GNU GPL license version 2 or later.
+ *
+ * Written without QEMU dependencies so it can be built into a small
+ * stand-alone test (tools/gltest in research/gfx).
+ */
+
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "ati_gl.h"
+
+typedef void *EGLDisplay;
+typedef void *EGLContext;
+typedef void *EGLSurface;
+typedef void *EGLConfig;
+typedef void *EGLDeviceEXT;
+typedef int32_t EGLint;
+typedef unsigned int EGLBoolean;
+typedef unsigned int EGLenum;
+typedef intptr_t EGLAttrib;
+
+#define EGL_NONE                        0x3038
+#define EGL_VENDOR                      0x3053
+#define EGL_VERSION                     0x3054
+#define EGL_EXTENSIONS                  0x3055
+#define EGL_OPENGL_ES_API               0x30A0
+#define EGL_CONTEXT_MAJOR_VERSION       0x3098
+#define EGL_CONTEXT_MINOR_VERSION       0x30FB
+#define EGL_PLATFORM_SURFACELESS_MESA   0x31DD
+#define EGL_PLATFORM_DEVICE_EXT         0x313F
+#define EGL_DEVICE_EXT                  0x322C
+#define EGL_DRM_RENDER_NODE_FILE_EXT    0x3377
+
+static struct {
+    void *lib_egl;
+    void *lib_gles;
+    EGLDisplay dpy;
+    EGLContext ctx;
+    void *(*GetProcAddress)(const char *);
+    EGLDisplay (*GetPlatformDisplay)(EGLenum, void *, const EGLint *);
+    EGLBoolean (*Initialize)(EGLDisplay, EGLint *, EGLint *);
+    EGLBoolean (*Terminate)(EGLDisplay);
+    EGLBoolean (*BindAPI)(EGLenum);
+    EGLContext (*CreateContext)(EGLDisplay, EGLConfig, EGLContext,
+                                const EGLint *);
+    EGLBoolean (*DestroyContext)(EGLDisplay, EGLContext);
+    EGLBoolean (*MakeCurrent)(EGLDisplay, EGLSurface, EGLSurface, EGLContext);
+    const char *(*QueryString)(EGLDisplay, EGLint);
+    EGLint (*GetError)(void);
+    EGLBoolean (*QueryDevices)(EGLint, EGLDeviceEXT *, EGLint *);
+    const char *(*QueryDeviceString)(EGLDeviceEXT, EGLint);
+    EGLBoolean (*QueryDisplayAttrib)(EGLDisplay, EGLint, EGLAttrib *);
+} egl;
+
+static bool ati_egl_ext(const char *extensions, const char *name)
+{
+    size_t len = strlen(name);
+    const char *p = extensions;
+
+    while (p && (p = strstr(p, name))) {
+        if ((p == extensions || p[-1] == ' ') &&
+            (!p[len] || p[len] == ' ')) {
+            return true;
+        }
+        p += len;
+    }
+    return false;
+}
+
+static bool ati_gl_software(const char *renderer)
+{
+    static const char *names[] = {
+        "llvmpipe", "softpipe", "swrast", "lavapipe", "software rasterizer"
+    };
+    char lower[512];
+    size_t i;
+
+    if (!renderer || !*renderer) {
+        return true;
+    }
+    for (i = 0; i + 1 < sizeof(lower) && renderer[i]; i++) {
+        unsigned char c = renderer[i];
+        lower[i] = c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c;
+    }
+    lower[i] = 0;
+    for (i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+        if (strstr(lower, names[i])) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void *ati_gl_sym(const char *name)
+{
+    void *p = NULL;
+
+    if (egl.lib_gles) {
+        p = dlsym(egl.lib_gles, name);
+    }
+    if (!p && egl.GetProcAddress) {
+        p = egl.GetProcAddress(name);
+    }
+    return p;
+}
+
+bool ati_gl_open(ATIGL *gl, char *info, size_t infolen)
+{
+    EGLint major, minor;
+    static const EGLint ctx_attr[] = {
+        EGL_CONTEXT_MAJOR_VERSION, 3, EGL_CONTEXT_MINOR_VERSION, 0, EGL_NONE
+    };
+    const char *ext, *renderer, *version;
+    const char *render_node = getenv("RETROBOOT_EGL_RENDER_NODE");
+    EGLDeviceEXT selected = NULL;
+
+    memset(gl, 0, sizeof(*gl));
+    egl.lib_egl = dlopen("libEGL.so.1", RTLD_NOW | RTLD_LOCAL);
+    if (!egl.lib_egl) {
+        snprintf(info, infolen, "libEGL.so.1 not available");
+        return false;
+    }
+    egl.lib_gles = dlopen("libGLESv2.so.2", RTLD_NOW | RTLD_LOCAL);
+#define EGLSYM(n) (*(void **)&egl.n = dlsym(egl.lib_egl, "egl" #n))
+    EGLSYM(GetProcAddress);
+    EGLSYM(Initialize);
+    EGLSYM(Terminate);
+    EGLSYM(BindAPI);
+    EGLSYM(CreateContext);
+    EGLSYM(DestroyContext);
+    EGLSYM(MakeCurrent);
+    EGLSYM(QueryString);
+    EGLSYM(GetError);
+#undef EGLSYM
+    if (!egl.GetProcAddress || !egl.Initialize || !egl.BindAPI ||
+        !egl.CreateContext || !egl.MakeCurrent || !egl.QueryString ||
+        !egl.GetError) {
+        snprintf(info, infolen, "libEGL.so.1 lacks core entry points");
+        goto fail;
+    }
+    ext = egl.QueryString(NULL, EGL_EXTENSIONS);
+    if (!render_node && !ati_egl_ext(ext, "EGL_MESA_platform_surfaceless")) {
+        snprintf(info, infolen, "EGL has no surfaceless platform");
+        goto fail;
+    }
+    *(void **)&egl.GetPlatformDisplay = egl.GetProcAddress("eglGetPlatformDisplayEXT");
+    if (!egl.GetPlatformDisplay) {
+        snprintf(info, infolen, "eglGetPlatformDisplayEXT missing");
+        goto fail;
+    }
+    if (render_node) {
+        EGLDeviceEXT devices[64];
+        EGLint count = 0, capacity;
+
+        if (!*render_node ||
+            !ati_egl_ext(ext, "EGL_EXT_platform_device") ||
+            !(ati_egl_ext(ext, "EGL_EXT_device_base") ||
+              (ati_egl_ext(ext, "EGL_EXT_device_enumeration") &&
+               ati_egl_ext(ext, "EGL_EXT_device_query")))) {
+            snprintf(info, infolen, "explicit EGL render node requires device extensions");
+            goto fail;
+        }
+        *(void **)&egl.QueryDevices = egl.GetProcAddress("eglQueryDevicesEXT");
+        *(void **)&egl.QueryDeviceString = egl.GetProcAddress("eglQueryDeviceStringEXT");
+        *(void **)&egl.QueryDisplayAttrib = egl.GetProcAddress("eglQueryDisplayAttribEXT");
+        if (!egl.QueryDevices || !egl.QueryDeviceString || !egl.QueryDisplayAttrib ||
+            !egl.QueryDevices(0, NULL, &count) || count <= 0 ||
+            count > (EGLint)(sizeof(devices) / sizeof(devices[0]))) {
+            snprintf(info, infolen, "EGL device enumeration failed");
+            goto fail;
+        }
+        capacity = count;
+        if (!egl.QueryDevices(capacity, devices, &count) ||
+            count <= 0 || count > capacity) {
+            snprintf(info, infolen, "EGL device count changed outside bounds");
+            goto fail;
+        }
+        for (EGLint i = 0; i < count; i++) {
+            const char *de = egl.QueryDeviceString(devices[i], EGL_EXTENSIONS);
+            const char *node;
+
+            if (!ati_egl_ext(de, "EGL_EXT_device_drm_render_node")) {
+                continue;
+            }
+            node = egl.QueryDeviceString(devices[i], EGL_DRM_RENDER_NODE_FILE_EXT);
+            if (node && !strcmp(node, render_node)) {
+                if (selected || ati_egl_ext(de, "EGL_MESA_device_software")) {
+                    snprintf(info, infolen, "EGL render node is ambiguous or software");
+                    goto fail;
+                }
+                selected = devices[i];
+            }
+        }
+        if (!selected) {
+            snprintf(info, infolen, "EGL render node not found: %.128s", render_node);
+            goto fail;
+        }
+        egl.dpy = egl.GetPlatformDisplay(EGL_PLATFORM_DEVICE_EXT, selected, NULL);
+    } else {
+        egl.dpy = egl.GetPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, NULL, NULL);
+    }
+    if (!egl.dpy || !egl.Initialize(egl.dpy, &major, &minor)) {
+        snprintf(info, infolen, "eglInitialize failed (0x%x)",
+                 egl.GetError ? egl.GetError() : 0);
+        goto fail;
+    }
+    if (selected) {
+        EGLAttrib actual = 0;
+
+        if (!egl.QueryDisplayAttrib(egl.dpy, EGL_DEVICE_EXT, &actual) ||
+            (EGLDeviceEXT)actual != selected) {
+            snprintf(info, infolen, "EGL display does not use the selected render node");
+            goto fail;
+        }
+    }
+    ext = egl.QueryString(egl.dpy, EGL_EXTENSIONS);
+    if (!ext || !strstr(ext, "EGL_KHR_surfaceless_context") ||
+        !strstr(ext, "EGL_KHR_no_config_context")) {
+        snprintf(info, infolen, "EGL lacks surfaceless/no-config contexts");
+        goto fail;
+    }
+    if (!egl.BindAPI(EGL_OPENGL_ES_API)) {
+        snprintf(info, infolen, "no OpenGL ES API");
+        goto fail;
+    }
+    egl.ctx = egl.CreateContext(egl.dpy, NULL, NULL, ctx_attr);
+    if (!egl.ctx) {
+        snprintf(info, infolen, "no OpenGL ES 3.0 context (0x%x)",
+                 egl.GetError());
+        goto fail;
+    }
+    if (!egl.MakeCurrent(egl.dpy, NULL, NULL, egl.ctx)) {
+        snprintf(info, infolen, "eglMakeCurrent failed (0x%x)", egl.GetError());
+        goto fail;
+    }
+#define ATI_GL_LOAD(ret, name, args) \
+    *(void **)&gl->name = ati_gl_sym("gl" #name); \
+    if (!gl->name) { \
+        snprintf(info, infolen, "missing gl" #name); \
+        goto fail; \
+    }
+    ATI_GL_FUNCS(ATI_GL_LOAD)
+#undef ATI_GL_LOAD
+    renderer = (const char *)gl->GetString(GL_RENDERER);
+    version = (const char *)gl->GetString(GL_VERSION);
+    if (!renderer || !version || (selected && ati_gl_software(renderer))) {
+        snprintf(info, infolen, "selected EGL render node has no hardware renderer");
+        goto fail;
+    }
+    if (selected) {
+        snprintf(info, infolen, "node %.64s; EGL %d.%d %s; GL %s; %s",
+                 render_node, major, minor, egl.QueryString(egl.dpy, EGL_VENDOR),
+                 version, renderer);
+    } else {
+        snprintf(info, infolen, "EGL %d.%d %s; GL %s; %s", major, minor,
+                 egl.QueryString(egl.dpy, EGL_VENDOR), version, renderer);
+    }
+    return true;
+
+fail:
+    ati_gl_close();
+    return false;
+}
+
+void ati_gl_close(void)
+{
+    if (egl.dpy && egl.MakeCurrent) {
+        egl.MakeCurrent(egl.dpy, NULL, NULL, NULL);
+    }
+    if (egl.ctx && egl.DestroyContext) {
+        egl.DestroyContext(egl.dpy, egl.ctx);
+    }
+    if (egl.dpy && egl.Terminate) {
+        egl.Terminate(egl.dpy);
+    }
+    egl.ctx = NULL;
+    egl.dpy = NULL;
+    /* the libraries stay loaded: Mesa does not like being unloaded */
+}
diff --git a/hw/display/ati_gl.h b/hw/display/ati_gl.h
new file mode 100644
index 00000000..1b7dafc5
--- /dev/null
+++ b/hw/display/ati_gl.h
@@ -0,0 +1,258 @@
+/*
+ * QEMU ATI Radeon (R100) emulation: host OpenGL ES 3.0 back end.
+ *
+ * Copyright (c) 2026 RetroBoot contributors
+ *
+ * This work is licensed under the GNU GPL license version 2 or later.
+ *
+ * libEGL/libGLESv2 are loaded at run time (dlopen), so the emulator has no
+ * link-time GL dependency and still runs (as a 2D card) where none exists.
+ * The default context is surfaceless (EGL_MESA_platform_surfaceless); Mesa's
+ * default device can be llvmpipe even when another GPU is available. No window
+ * system is involved. RETROBOOT_EGL_RENDER_NODE opts into an exact DRM
+ * render-node match through EGL_EXT_platform_device; this path rejects
+ * software devices/renderers and never falls back to the default display.
+ */
+#ifndef ATI_GL_H
+#define ATI_GL_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* minimal GL ES 3.0 declarations (no GL headers needed at build time) */
+typedef unsigned int GLenum;
+typedef unsigned int GLuint;
+typedef int GLint;
+typedef int GLsizei;
+typedef unsigned char GLboolean;
+typedef unsigned int GLbitfield;
+typedef float GLfloat;
+typedef char GLchar;
+typedef intptr_t GLintptr;
+typedef intptr_t GLsizeiptr;
