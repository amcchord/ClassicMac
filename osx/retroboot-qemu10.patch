+#define VF_ST3      (1u << 12)
+#define VF_Q3       (1u << 13)
+#define VF_Q0       (1u << 14)
+#define VF_N0       (1u << 18)
+#define VF_Z        (1u << 31)
+
+/* GL enums used in the draw description (match GLES values) */
+enum {
+    G_NEVER = 0x0200, G_LESS, G_EQUAL, G_LEQUAL, G_GREATER, G_NOTEQUAL,
+    G_GEQUAL, G_ALWAYS,
+};
+
+typedef struct ATITrack {
+    ATIImage img;
+    bool gl_owned;
+    uint32_t depth_mc;
+    /* after a readback GL still holds the same pixels; the next draw takes
+     * them back without an upload if VRAM still hashes the same */
+    bool gl_valid;
+    uint64_t vram_hash;
+    /* scanout readback in flight (vblank), and draw generations */
+    ATIReadJob *pending;
+    uint64_t gen, read_gen;
+} ATITrack;
+
+#define MAX_TRACK ATI_COLOR_SLOTS
+
+typedef struct ATITexCache {
+    uint64_t key;
+    uint32_t gen;
+    uint32_t mc, len;
+    bool valid;
+} ATITexCache;
+
+#define TEXC_BITS 12
+#define TEXC_N (1 << TEXC_BITS)
+
+typedef struct ATIDepthTrack {
+    ATIDepthImage img, pending_img;
+    bool used, owned, valid;
+    uint64_t gen, pending_gen, hash, lru;
+    ATIDepthReadJob *pending;
+} ATIDepthTrack;
+
+struct ATI3DState {
+    ATIRenderer *r;
+    bool mc_ram_enabled;
+    uint64_t mc_ram_tries, mc_ram_hits, mc_ram_map_reject;
+    uint64_t mc_ram_owner_reject, mc_ram_recheck_global;
+    bool failed;
+    ATITrack track[MAX_TRACK];
+    ATIDepthTrack depth[ATI_DEPTH_SLOTS];
+    bool depth_failed;
+    uint64_t depth_tick, depth_uploads, depth_readbacks;
+    ATITexCache texc[TEXC_N];
+    uint32_t tex_gen;
+    uint32_t tcl_vectors[128][4];
+    uint8_t tcl_index, tcl_component;
+    uint16_t tcl_stride;
+    bool tcl_valid[128];
+    ATIVertex *vbuf;
+    unsigned vbuf_cap;
+    uint32_t *mbuf;                   /* 3D_RNDR_GEN_INDX_PRIM: fetched vertex dwords */
+    size_t mbuf_cap;
+    ATIVertex *dec;                   /* ... and the vertices they decode to */
+    unsigned dec_cap;
+    /* vertex arrays from 3D_LOAD_VBPNTR */
+    unsigned narrays;
+    uint32_t arr_addr[16], arr_stride[16], arr_size[16];
+    uint64_t draws, verts, syncs, readbacks, uploads, texuploads, texhits;
+    uint64_t zclears, upload_skips, flips, vblank_waits, readbacks_joined;
+    uint64_t gl_fills;          /* RetroBoot: 2D fills done as GL clears */
+    uint64_t rb_why[ATI_SYNC_N];      /* readbacks by cause: 2D, status read, vblank */
+    uint64_t vb_fetch, vb_idx;        /* vertices fetched and decoded / drawn, 3D_RNDR_GEN_INDX_PRIM */
+    char stats[1024];
+};
+
+static inline uint32_t R(ATIVGAState *s, hwaddr a)
+{
+    return s->regfile[a / 4];
+}
+
+static inline float RF(ATIVGAState *s, hwaddr a)
+{
+    union { uint32_t u; float f; } v = { .u = s->regfile[a / 4] };
+    return v.f;
+}
+
+static void argb_to_float(uint32_t c, float *o)
+{
+    o[0] = ((c >> 16) & 0xff) / 255.0f;
+    o[1] = ((c >> 8) & 0xff) / 255.0f;
+    o[2] = (c & 0xff) / 255.0f;
+    o[3] = (c >> 24) / 255.0f;
+}
+
+/* ---------------------------------------------------------------------
+ * Byte-swap bookkeeping.  QEMU's VRAM holds what the CPU sees through the
+ * framebuffer aperture.  The chip's own view is the aperture swap (the CPU's
+ * writes went through it) composed with the engine's per-surface swap.
+ * Codes form a group: 0 none, 1 swap within 16-bit, 2 swap 16-bit halves,
+ * 3 full 32-bit swap; composition is XOR.
+ */
+static uint8_t swap_code(unsigned r100_endian)
+{
+    static const uint8_t map[4] = { 0, 1, 3, 2 };   /* none, 16, 32, halfdw */
+    return map[r100_endian & 3];
+}
+
+static uint8_t aperture_swap(ATIVGAState *s, unsigned bpp)
+{
+    uint32_t sc = R(s, SURFACE_CNTL);
+    /* the Mac driver programs aperture 1 for the CPU's frame buffer view */
+    unsigned bits = (sc >> 22) & 3;
+    if (!bits) {
+        bits = (sc >> 20) & 3;
+    }
+    if (bits & 2) {
+        return 3;               /* 32bpp swap */
+    }
+    if (bits & 1) {
+        return 1;               /* 16bpp swap */
+    }
+    (void)bpp;
+    return 0;
+}
+
+/* ---------------------------------------------------------------------
+ * Render-target tracking and sync
+ */
+
+static ATITrack *track_find(ATI3DState *t, uint32_t mc, uint32_t pitch,
+                            uint8_t fmt)
+{
+    for (int i = 0; i < MAX_TRACK; i++) {
+        ATITrack *k = &t->track[i];
+        if (k->img.w && k->img.mc == mc && k->img.pitch == pitch &&
+            k->img.fmt == fmt) {
+            return k;
+        }
+    }
+    return NULL;
+}
+
+static void color_fail(ATIVGAState *s)
+{
+    if (!s->r3d->failed) {
+        s->r3d->failed = true;
+        error_report("ati: color readback failed; old VRAM is not a valid result");
+        qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+    }
+}
+
+/* copy a finished scanout readback into VRAM */
+static void track_land(ATIVGAState *s, ATITrack *k)
+{
+    uint64_t off, contig;
+    ATIReadJob *j = k->pending;
+    bool in_vram;
+    uint64_t j_mc, j_hash;
+    size_t j_len;
+
+    if (!j || !ati_glr_read_done(j)) {
+        return;
+    }
+    if (!j->ok) {
+        ati_glr_read_free(j);
+        k->pending = NULL;
+        color_fail(s);
+        return;
+    }
+    in_vram = ati_mc_translate(s, j->img.mc, &off, &contig) == ATI_MC_VRAM &&
+              off + j->len <= s->vga.vram_size;
+    if (in_vram) {
+        memcpy(s->vga.vram_ptr + off, j->buf, j->len);
+        memory_region_set_dirty(&s->vga.vram, off, j->len);
+    } else {
+        ati_mc_rw(s, j->img.mc, j->buf, j->len, true);
+    }
+    j_mc = j->img.mc;
+    j_len = j->len;
+    j_hash = j->hash;           /* of j->buf, now VRAM's bytes */
+    ati_glr_read_free(j);
+    k->pending = NULL;
+    if (k->gen == k->read_gen) {
+        /* nothing drawn since: VRAM holds the target; GL keeps a copy that
+         * the next draw takes back without an upload if VRAM is unchanged */
+        uint64_t off2, c2;
+        size_t len = (size_t)k->img.pitch * k->img.h;
+        k->gl_owned = false;
+        k->gl_valid = ati_mc_translate(s, k->img.mc, &off2, &c2) == ATI_MC_VRAM &&
+                      off2 + len <= s->vga.vram_size;
+        if (k->gl_valid) {
+            k->vram_hash = in_vram && j_mc == k->img.mc && j_len == len ?
+                           j_hash : ati_vram_hash(s->vga.vram_ptr + off2, len);
+        }
+    }
+}
+
+/* a synchronous readback supersedes one in flight */
+static void track_drop_pending(ATIVGAState *s, ATITrack *k)
+{
+    if (k->pending) {
+        ati_glr_read_wait(s->r3d->r, k->pending);
+        ati_glr_read_free(k->pending);
+        k->pending = NULL;
+    }
+}
+
+static void track_readback(ATIVGAState *s, ATITrack *k)
+{
+    ATI3DState *t = s->r3d;
+    uint64_t off, contig;
+    size_t len = (size_t)k->img.pitch * k->img.h;
+
+    if (!k->gl_owned || t->failed) {
+        return;
+    }
+    if (k->pending && k->gen == k->read_gen) {
+        /* the read in flight is current: wait for it instead of a new one */
+        ati_glr_read_wait(t->r, k->pending);
+        track_land(s, k);
+        t->readbacks_joined++;
+        return;
+    }
+    track_drop_pending(s, k);
+    if (ati_mc_translate(s, k->img.mc, &off, &contig) == ATI_MC_VRAM &&
+        off + len <= s->vga.vram_size) {
+        /*
+         * Into a copy, then into VRAM with the BQL held again: the vCPU waits
+         * without the BQL, and the display must not see a target it shows
+         * half rewritten.  The copy starts as VRAM because the renderer
+         * writes only the target's pixels, not the rest of each pitch.
+         */
+        uint8_t *buf = g_memdup2(s->vga.vram_ptr + off, len);
+        if (!ati_glr_target_read(t->r, &k->img, buf, &k->vram_hash)) {
+            g_free(buf);
+            color_fail(s);
+            return;
+        }
+        memcpy(s->vga.vram_ptr + off, buf, len);
+        g_free(buf);
+        memory_region_set_dirty(&s->vga.vram, off, len);
+        k->gl_valid = true;
+    } else {
+        uint8_t *buf = g_malloc(len);
+        ati_mc_rw(s, k->img.mc, buf, len, false);
+        if (!ati_glr_target_read(t->r, &k->img, buf, NULL)) {
+            g_free(buf);
+            color_fail(s);
+            return;
+        }
+        ati_mc_rw(s, k->img.mc, buf, len, true);
+        g_free(buf);
+    }
+    k->gl_owned = false;
+    t->readbacks++;
+}
+
+void ati_3d_color_reset(ATIVGAState *s)
+{
+    ATI3DState *t = s->r3d;
+    if (!t || !t->r) return;
+    ati_3d_sync(s, ATI_SYNC_2D);
+    for (unsigned i = 0; i < MAX_TRACK; i++) {
+        track_drop_pending(s, &t->track[i]);
+        ati_glr_target_hold(t->r, i, NULL);
+    }
+    memset(t->track, 0, sizeof(t->track));
+    ati_glr_finish(t->r);
+}
+
+/* Shared depth memory: main/BQL ownership. The worker owns only immutable
+ * commands and refcounted read snapshots, never these tracking records. */
+static void depth_fail(ATIVGAState *s, const char *reason)
+{
+    ATI3DState *t = s->r3d;
+    if (!t->depth_failed) {
+        error_report("ati: depth memory failure: %s", reason);
+        t->depth_failed = true;
+        qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+    }
+}
+
+static size_t depth_length(const ATIDepthImage *img)
+{
+    return (size_t)img->pitch * img->h;
+}
+
+static bool depth_overlap(uint64_t a, uint64_t an, uint64_t b, uint64_t bn)
+{
+    return an && bn && a < b + bn && b < a + an;
+}
+
+static bool depth_key_equal(const ATIDepthImage *a, const ATIDepthImage *b)
+{
+    return a->mc == b->mc && a->pitch == b->pitch && a->w == b->w &&
+           a->fmt == b->fmt && a->swap == b->swap;
+}
+
+static bool depth_land(ATIVGAState *s, ATIDepthTrack *k)
+{
+    ATIDepthReadJob *job = k->pending;
+    if (!job || !ati_glr_depth_read_done(job)) {
+        return false;
+    }
+    if (!ati_glr_depth_read_ok(job)) {
+        depth_fail(s, "host depth read failed");
+        return false;
+    }
+    const uint8_t *raw = ati_glr_depth_read_data(job);
+    size_t len = depth_length(&k->pending_img);
+    if (!ati_mc_depth_memory_supported(s, k->pending_img.mc, len) ||
+        !ati_mc_rw(s, k->pending_img.mc, (void *)raw, len, true)) {
+        depth_fail(s, "depth snapshot cannot reach original guest mapping");
+        return false;
+    }
+    k->hash = ati_vram_hash(raw, len);
+    k->valid = true;
+    if (k->gen == k->pending_gen) {
+        k->owned = false;
+    }
+    k->pending = NULL;
+    ati_glr_depth_read_unref(job); /* main pending ownership, landed once */
+    s->r3d->depth_readbacks++;
+    return true;
+}
+
+static bool depth_readback(ATIVGAState *s, ATIDepthTrack *k)
+{
+    ATI3DState *t = s->r3d;
+    while (k->owned && !t->depth_failed) {
+        ATIDepthReadJob *job;
+        if (!k->pending) {
+            size_t len = depth_length(&k->img);
+            uint8_t *raw = g_malloc(len);
+            if (!ati_mc_depth_memory_supported(s, k->img.mc, len) ||
+                !ati_mc_rw(s, k->img.mc, raw, len, false)) {
+                g_free(raw);
+                depth_fail(s, "cannot snapshot depth backing bytes");
+                return false;
+            }
+            k->pending_img = k->img;
+            k->pending_gen = k->gen;
+            k->pending = ati_glr_depth_memory_read_async(t->r,
+                         k - t->depth, &k->img, raw);
+            g_free(raw);
+            if (!k->pending) {
+                depth_fail(s, "cannot queue depth read");
+                return false;
+            }
+        }
+        job = k->pending;
+        /* Another BQL owner can land this job while the vCPU is waiting.
+         * Keep our own reference, then recheck pending identity under BQL. */
+        ati_glr_depth_read_ref(job);
+        bool ok = ati_glr_depth_read_wait(t->r, job);
+        if (!ok) {
+            ati_glr_depth_read_unref(job);
+            depth_fail(s, "host depth read failed while waiting");
+            return false;
+        }
+        if (k->pending == job) {
+            depth_land(s, k);
+        }
+        ati_glr_depth_read_unref(job);
+    }
+    return !t->depth_failed;
+}
+
+static void depth_sync_all(ATIVGAState *s, bool external_only)
+{
+    ATI3DState *t = s->r3d;
+    if (!s->depth_memory_enabled || !t || !t->r) {
+        return;
+    }
+    for (unsigned i = 0; i < ATI_DEPTH_SLOTS; i++) {
+        ATIDepthTrack *k = &t->depth[i];
+        uint64_t off, contig;
+        size_t len = depth_length(&k->img);
+        if (!k->used || !k->owned) {
+            continue;
+        }
+        if (!external_only ||
+            ati_mc_translate(s, k->img.mc, &off, &contig) != ATI_MC_VRAM ||
+            contig < len || off + len > s->vga.vram_size) {
+            depth_readback(s, k);
+        }
+    }
+}
+
+static void depth_sync_mc(ATIVGAState *s, uint64_t mc, uint64_t len)
+{
+    ATI3DState *t = s->r3d;
+    if (!s->depth_memory_enabled || !t || !t->r) {
+        return;
+    }
+    for (unsigned i = 0; i < ATI_DEPTH_SLOTS; i++) {
+        ATIDepthTrack *k = &t->depth[i];
+        if (k->used && k->owned &&
+            depth_overlap(mc, len, k->img.mc, depth_length(&k->img))) {
+            depth_readback(s, k);
+        }
+    }
+}
+
+static bool depth_descriptor(ATIVGAState *s, unsigned height,
+                              bool stencil, ATIDepthImage *img)
+{
+    uint32_t zs = R(s, RB3D_ZSTENCILCNTL);
+    uint32_t pitch = R(s, RB3D_DEPTHPITCH);
+    unsigned fmt = zs & 15;
+    if (fmt != 0 && fmt != 2) {
+        depth_fail(s, "unsupported depth format (only integer16/24 supported)");
+        return false;
+    }
+    memset(img, 0, sizeof(*img));
+    img->mc = R(s, RB3D_DEPTHOFFSET) & ~15u;
+    img->fmt = fmt == 0 ? 16 : 24;
+    if ((pitch & (3u << 16)) || (stencil && img->fmt == 16)) {
+        depth_fail(s, "unsupported tiled depth or D16/stencil layout");
+        return false;
+    }
+    img->w = pitch & 0x1ff8;
+    img->h = height;
+    img->pitch = img->w * (img->fmt == 16 ? 2 : 4);
+    img->swap = swap_code((pitch >> 18) & 3);
+    if (!height || height > 2048 || !img->w || img->w > 2048) {
+        depth_fail(s, "invalid depth dimensions");
+        return false;
+    }
+    if (!ati_mc_depth_memory_supported(s, img->mc, depth_length(img))) {
+        depth_fail(s, "depth storage must resolve to VRAM or ordinary writable RAM");
+        return false;
+    }
+    return true;
+}
+
+static ATIDepthTrack *depth_acquire(ATIVGAState *s,
+                                     const ATIDepthImage *img)
+{
+    ATI3DState *t = s->r3d;
+    ATIDepthTrack *k = NULL, *victim = NULL;
+    size_t len = depth_length(img);
+    uint8_t *raw;
+    uint64_t hash;
+    /* Non-VRAM surfaces cannot trap ordinary CPU/DMA accesses. Materialize
+     * them before GPU imports that might use a different AIC alias. Guests
+     * still must fence GPU completion before concurrent CPU writes. */
+    depth_sync_all(s, true);
+    for (unsigned i = 0; i < ATI_DEPTH_SLOTS; i++) {
+        ATIDepthTrack *candidate = &t->depth[i];
+        if (candidate->used && depth_key_equal(&candidate->img, img)) {
+            k = candidate;
+        }
+        if (!victim || !candidate->used ||
+            (victim->used && candidate->lru < victim->lru)) {
+            victim = candidate;
+        }
+    }
+    /* A smaller origin clear reuses the retained larger attachment. Resolve
+     * aliases over every byte that will be imported, including its tail. */
+    if (k && img->h < k->img.h) {
+        len = depth_length(&k->img);
+    }
+    /* Physical memory reinterpreted as a color target must be exported before
+     * depth import, even when another MC/format aliases the same bytes. */
+    for (unsigned i = 0; i < MAX_TRACK; i++) {
+        ATITrack *color = &t->track[i];
+        if (color->gl_owned && depth_overlap(img->mc, len, color->img.mc,
+                     (uint64_t)color->img.pitch * color->img.h)) {
+            track_readback(s, color);
+        }
+    }
+    for (unsigned i = 0; i < ATI_DEPTH_SLOTS; i++) {
+        ATIDepthTrack *other = &t->depth[i];
+        if (other != k && other->used &&
+            depth_overlap(img->mc, len, other->img.mc,
+                          depth_length(&other->img))) {
+            if (!depth_readback(s, other)) {
+                return NULL;
+            }
+            other->valid = false;
+        }
+    }
+    if (k && img->h <= k->img.h && k->owned) {
+        k->lru = ++t->depth_tick;
+        return k;
+    }
+    if (!k) {
+        k = victim;
+    }
+    if (k->owned && !depth_readback(s, k)) {
+        return NULL;
+    }
+    raw = g_malloc(len);
+    if (!ati_mc_depth_memory_supported(s, img->mc, len) ||
+        !ati_mc_rw(s, img->mc, raw, len, false)) {
+        g_free(raw);
+        depth_fail(s, "cannot import depth backing bytes");
+        return NULL;
+    }
+    hash = ati_vram_hash(raw, len);
+    if (k->used && depth_key_equal(&k->img, img) &&
+        img->h <= k->img.h && k->valid && k->hash == hash) {
+        g_free(raw);
+        k->owned = true;
+        k->lru = ++t->depth_tick;
+        return k;
+    }
+    ATIDepthImage next = *img;
+    if (k->used && depth_key_equal(&k->img, img)) {
+        next.h = MAX(k->img.h, img->h);
+    }
+    ati_glr_depth_memory_upload(t->r, k - t->depth, &next, raw);
+    g_free(raw);
+    k->img = next;
+    k->used = k->owned = true;
+    k->valid = false;
+    k->hash = hash;
+    k->gen++;
+    k->lru = ++t->depth_tick;
+    t->depth_uploads++;
+    return k;
+}
+
+static bool depth_prepare_draw(ATIVGAState *s, ATIDrawState *st)
+{
+    ATIDepthImage img;
+    ATIDepthTrack *k;
+    if (!s->depth_memory_enabled || !(st->z_test || st->stencil)) {
+        return true;
+    }
+    if (!depth_descriptor(s, st->color.h, st->stencil, &img)) {
+        return false;
+    }
+    if (depth_overlap(img.mc, depth_length(&img), st->color.mc,
+                      (uint64_t)st->color.pitch * st->color.h)) {
+        depth_fail(s, "simultaneous overlapping color/depth storage unsupported");
+        return false;
+    }
+    k = depth_acquire(s, &img);
+    if (!k) {
+        return false;
+    }
+    st->depth_memory = true;
+    st->depth_slot = k - s->r3d->depth;
+    st->depth_image = k->img;
+    k->gen++;
+    return true;
+}
+
+void ati_3d_depth_reset(ATIVGAState *s)
+{
+    ATI3DState *t = s->r3d;
+    if (!s->depth_memory_enabled || !t || !t->r) {
+        return;
+    }
+    depth_sync_all(s, false);
+    ati_glr_depth_memory_reset(t->r);
+    for (unsigned i = 0; i < ATI_DEPTH_SLOTS; i++) {
+        if (t->depth[i].pending) {
+            ati_glr_depth_read_unref(t->depth[i].pending);
+        }
+    }
+    memset(t->depth, 0, sizeof(t->depth));
+}
+
+/* Caller supplies complete linear VRAM byte envelopes.
+ * Keep the original pending-flip pass. Unknown physical aliases keep the
+ * original full barrier; coherent CPU apertures are mandatory. */
+void ati_3d_sync_2d_vram(ATIVGAState *s, uint64_t dst, uint64_t dst_len,
+                        uint64_t src, uint64_t src_len)
+{
+    ATI3DState *t = s->r3d;
+    if (!t || !t->r) {
+        return;
+    }
+    if (!s->coherent_vram_enabled) {
+        ati_3d_sync(s, ATI_SYNC_2D);
+        return;
+    }
+    for (int i = 0; i < MAX_TRACK; i++) {
+        ATITrack *k = &t->track[i];
+        uint64_t off, contiguous, len = (uint64_t)k->img.pitch * k->img.h;
+        if (k->gl_owned &&
+            (ati_mc_translate(s, k->img.mc, &off, &contiguous) != ATI_MC_VRAM ||
+             len > contiguous || off + len > s->vga.vram_size)) {
+            ati_3d_sync(s, ATI_SYNC_2D);
+            return;
+        }
+    }
+    if (s->depth_memory_enabled) {
+        for (unsigned i = 0; i < ATI_DEPTH_SLOTS; i++) {
+            ATIDepthTrack *k = &t->depth[i];
+            uint64_t off, contiguous, len = depth_length(&k->img);
+            if (k->used && k->owned &&
+                (ati_mc_translate(s, k->img.mc, &off, &contiguous) != ATI_MC_VRAM ||
+                 len > contiguous || off + len > s->vga.vram_size)) {
+                ati_3d_sync(s, ATI_SYNC_2D);
+                return;
+            }
+        }
+    }
+    /* Same first pass as the full barrier: finish and settle every pending
+     * display handoff before another target overwrites the old front buffer. */
+    for (int i = 0; i < MAX_TRACK; i++) {
+        ATITrack *k = &t->track[i];
+        if (k->gl_owned && k->pending) {
+            t->rb_why[ATI_SYNC_2D]++;
+            track_readback(s, k);
+        }
+    }
+    ati_3d_land(s);
+    ati_flip_settle(s);
+    if (s->depth_memory_enabled) {
+        for (unsigned i = 0; i < ATI_DEPTH_SLOTS; i++) {
+            ATIDepthTrack *k = &t->depth[i];
+            uint64_t off, contiguous, len = depth_length(&k->img);
+            if (k->used && k->owned &&
+                ati_mc_translate(s, k->img.mc, &off, &contiguous) == ATI_MC_VRAM &&
+                (depth_overlap(dst, dst_len, off, len) ||
+                 (src_len && depth_overlap(src, src_len, off, len)))) {
+                depth_readback(s, k);
+            }
+        }
+    }
+    for (int i = 0; i < MAX_TRACK; i++) {
+        ATITrack *k = &t->track[i];
+        uint64_t off, contiguous, len = (uint64_t)k->img.pitch * k->img.h;
+        if (k->gl_owned &&
+            ati_mc_translate(s, k->img.mc, &off, &contiguous) == ATI_MC_VRAM &&
+            (depth_overlap(dst, dst_len, off, len) ||
+             (src_len && depth_overlap(src, src_len, off, len)))) {
+            t->rb_why[ATI_SYNC_2D]++;
+            track_readback(s, k);
+        }
+    }
+    ati_3d_land(s);
+    ati_flip_settle(s);
+}
+
+/* Unlike ati_mc_translate, this eligibility predicate never consults a
+ * page table for an external owner. Anything outside the direct local FB
+ * allocation retains the original full barrier. */
+static bool ati_3d_ram_sync_owners_local(ATIVGAState *s)
+{
+    ATI3DState *t = s->r3d;
+    uint64_t start = (uint64_t)(R(s,MC_FB_LOCATION) & 0xffff) << 16;
+    uint64_t end = ((uint64_t)(R(s,MC_FB_LOCATION) >> 16) << 16) | 0xffff;
+    if (end <= start) return false;
+    for (unsigned i = 0; i < MAX_TRACK + ATI_DEPTH_SLOTS; i++) {
+        uint64_t mc, len;
+        if (i < MAX_TRACK) {
+            ATITrack *k = &t->track[i];
+            if (!k->gl_owned) continue;
+            mc = k->img.mc; len = (uint64_t)k->img.pitch*k->img.h;
+        } else {
+            ATIDepthTrack *k = &t->depth[i-MAX_TRACK];
+            if (!s->depth_memory_enabled || !k->used || !k->owned) continue;
+            mc = k->img.mc; len = depth_length(&k->img);
+        }
+        if (!len || mc < start || mc > end || len > end+1-mc ||
+            mc-start >= s->vga.vram_size ||
+            len > s->vga.vram_size-(mc-start)) return false;
+    }
+    return true;
+}
+
+/* Only omit reads of unrelated local GPU images when every source byte is
+ * proven ordinary RAM. The existing helper retains pending-front ordering
+ * and destination color/depth overlap materialization. Recheck after waits:
+ * no mapping proof or host pointer is assumed to survive BQL release. */
+bool ati_3d_ram_sync_failed(ATIVGAState *s)
+{
+    ATI3DState *t = s->r3d;
+    return t && t->mc_ram_enabled && (t->failed || t->depth_failed);
+}
+
+bool ati_3d_sync_2d_ram(ATIVGAState *s, uint64_t dst, uint64_t dst_len,
+                       uint64_t src, uint64_t src_len)
+{
+    ATI3DState *t = s->r3d;
+    if (!t || !t->r || !t->mc_ram_enabled || !s->coherent_vram_enabled ||
+        !s->selective_2d_sync_enabled) return false;
+    if (t->failed || t->depth_failed) return true;
+    t->mc_ram_tries++;
+    if (!ati_mc_ordinary_ram_source(s,src,src_len)) {
+        t->mc_ram_map_reject++;
+        return false;
+    }
+    if (!ati_3d_ram_sync_owners_local(s)) {
+        t->mc_ram_owner_reject++;
+        return false;
+    }
+    ati_3d_sync_2d_vram(s,dst,dst_len,0,0);
+    if (t->failed || t->depth_failed) return true;
+    if (!ati_mc_ordinary_ram_source(s,src,src_len) ||
+        !ati_3d_ram_sync_owners_local(s)) {
+        t->mc_ram_recheck_global++;
+        ati_3d_sync(s,ATI_SYNC_2D);
+        return true;
+    }
+    t->mc_ram_hits++;
+    return true;
+}
+
+void ati_3d_sync(ATIVGAState *s, int why)
+{
+    ATI3DState *t = s->r3d;
+
+    if (!t || !t->r) {
+        return;
+    }
+    depth_sync_all(s, why != ATI_SYNC_2D);
+    if ((why == ATI_SYNC_STATUS || why == ATI_SYNC_CP_WAIT) &&
+        s->coherent_vram_enabled) {
+        /* CPU access to VRAM is trapped by both coherent apertures. Ordinary
+         * guest RAM/AIC targets have no such hook and must still land before
+         * an idle/scratch completion becomes visible. */
+        /* Posted CP waits order GPU work; the renderer FIFO already orders
+         * snapshots. CPU status reads and scratch completions still wait. */
+        if (why == ATI_SYNC_STATUS) {
+            ati_glr_finish(t->r);
+        }
+        for (int i = 0; i < MAX_TRACK; i++) {
+            ATITrack *k = &t->track[i];
+            uint64_t off, contig;
+            uint64_t len = (uint64_t)k->img.pitch * k->img.h;
+            if (k->gl_owned &&
+                (ati_mc_translate(s, k->img.mc, &off, &contig) != ATI_MC_VRAM ||
+                 len > contig || off + len > s->vga.vram_size)) {
+                t->rb_why[why]++;
+                track_readback(s, k);
+            }
+        }
+        ati_3d_land(s);
+        ati_flip_settle(s);
+        return;
+    }
+    /*
+     * Frames in flight first, then the flip waiting for one settles, and only
+     * then are other targets read back into VRAM.  With off-screen 2D fills
+     * done in GL (ati_3d_fill) the buffer still on screen can be GL-owned
+     * while its flip-away is pending; reading it back before the display has
+     * left it (the BQL is released while the vCPU waits, so the display can
+     * refresh meanwhile) would show the next frame half drawn.
+     */
+    for (int pass = 0; pass < 2; pass++) {
+        for (int i = 0; i < MAX_TRACK; i++) {
+            ATITrack *k = &t->track[i];
+            if (!k->gl_owned || (pass == 0 && !k->pending)) {
+                continue;
+            }
+            t->rb_why[why]++;
+            track_readback(s, k);
+        }
+        /* every frame is in VRAM now: a flip waiting for one shows it before
+         * the guest writes to the buffer it is leaving */
+        ati_3d_land(s);
+        ati_flip_settle(s);
+    }
+}
+
+/* start an asynchronous readback of the GL-owned targets in [mc, mc+len)
+ * that changed since their last read */
+static void scanout_read_async(ATIVGAState *s, uint64_t mc, uint64_t len)
+{
+    ATI3DState *t = s->r3d;
+
+    for (int i = 0; i < MAX_TRACK; i++) {
+        ATITrack *k = &t->track[i];
+        uint64_t a = k->img.mc, b = a + (uint64_t)k->img.pitch * k->img.h;
+        track_land(s, k);
+        if (k->gl_owned && mc < b && mc + len > a && !k->pending &&
+            k->gen != k->read_gen) {
+            k->pending = ati_glr_target_read_async(t->r, &k->img);
+            k->read_gen = k->gen;
+            t->rb_why[ATI_SYNC_VBLANK]++;
+            t->readbacks++;
+        }
+    }
+}
+
+/*
+ * A page flip (CRTC_OFFSET write): the new front buffer is read back
+ * asynchronously while the guest goes on with the next frame.  Returns true
+ * when a readback for that range is in flight (the display should keep the
+ * old buffer until it has landed).
+ */
+bool ati_3d_flip(ATIVGAState *s, uint64_t mc, uint64_t len)
+{
+    ATI3DState *t = s->r3d;
+
+    if (!t || !t->r) {
+        return false;
+    }
+    /* at most one frame in flight: the previous flip's readback finishes
+     * first, so the guest cannot run ahead of the host renderer */
+    for (int i = 0; i < MAX_TRACK; i++) {
+        ATITrack *k = &t->track[i];
+        if (k->pending) {
+            if (!ati_glr_read_done(k->pending)) {
+                ati_glr_read_wait(t->r, k->pending);
+                t->vblank_waits++;
+            }
+            track_land(s, k);
+        }
+    }
+    scanout_read_async(s, mc, len);
+    t->flips++;
+    return !ati_3d_range_ready(s, mc, len);
+}
+
+/* finished asynchronous readbacks into VRAM */
+void ati_3d_land(ATIVGAState *s)
+{
+    ATI3DState *t = s->r3d;
+
+    for (int i = 0; t && t->r && i < MAX_TRACK; i++) {
+        track_land(s, &t->track[i]);
+    }
+}
+
+bool ati_3d_busy(ATIVGAState *s)
+{
+    return s->r3d && ati_glr_waiting(s->r3d->r);
+}
+
+/*
+ * The 2D engine wrote VRAM [off, off + len).  A target there whose GL copy
+ * matched VRAM (gl_valid) no longer does, so its next draw uploads it without
+ * hashing the whole target to find that out (Mac OS's ATI OpenGL 2D-clears
+ * the back buffer every frame: a 4 MB hash per frame at 1920x1080 on the
+ * vCPU).  CPU writes are still caught by the hash.
+ */
+void ati_3d_vram_written(ATIVGAState *s, uint64_t off, uint64_t len)
+{
+    ATI3DState *t = s->r3d;
+
+    if (s->depth_memory_enabled && t) {
+        for (unsigned i = 0; i < ATI_DEPTH_SLOTS; i++) {
+            ATIDepthTrack *k = &t->depth[i];
+            uint64_t ko, contiguous;
+            if (k->used && ati_mc_translate(s, k->img.mc, &ko, &contiguous) ==
+                ATI_MC_VRAM && depth_overlap(off, len, ko,
+                                              depth_length(&k->img))) {
+                k->valid = false;
+            }
+        }
+    }
+    for (int i = 0; t && i < MAX_TRACK; i++) {
+        ATITrack *k = &t->track[i];
+        uint64_t koff, contig;
+        uint64_t klen = (uint64_t)k->img.pitch * k->img.h;
+
+        if (k->gl_valid &&
+            ati_mc_translate(s, k->img.mc, &koff, &contig) == ATI_MC_VRAM &&
+            off < koff + klen && koff < off + len) {
+            k->gl_valid = false;
+        }
+    }
+}
+
+void ati_3d_cpu_vram_sync(ATIVGAState *s, uint64_t off, uint64_t len)
+{
+    ATI3DState *t = s->r3d;
+
+    if (s->depth_memory_enabled && t && t->r) {
+        for (unsigned i = 0; i < ATI_DEPTH_SLOTS; i++) {
+            ATIDepthTrack *k = &t->depth[i];
+            uint64_t ko, contiguous;
+            if (k->used && k->owned &&
+                ati_mc_translate(s, k->img.mc, &ko, &contiguous) == ATI_MC_VRAM &&
+                depth_overlap(off, len, ko, depth_length(&k->img))) {
+                depth_readback(s, k);
+            }
+        }
+    }
+
+    for (int i = 0; t && t->r && i < MAX_TRACK; i++) {
+        ATITrack *k = &t->track[i];
+        uint64_t ko, contig;
+        uint64_t kl = (uint64_t)k->img.pitch * k->img.h;
+
+        if (k->gl_owned &&
+            ati_mc_translate(s, k->img.mc, &ko, &contig) == ATI_MC_VRAM &&
+            off < ko + kl && ko < off + len) {
+            track_readback(s, k);
+        }
+    }
+    ati_3d_land(s);
+    ati_flip_settle(s);
+}
+
+/*
+ * A solid 2D fill of an off-screen 3D render target, done as a GL clear.
+ *
+ * Mac OS's ATI OpenGL 2D-clears the next back buffer -- the buffer the
+ * display is just leaving -- every frame.  In VRAM that meant: waiting for the
+ * frame in flight to land (so the display could leave the buffer, else it
+ * showed black), a 4 MB fill at 1920x1080, and uploading the cleared buffer
+ * to GL for the first draw.  In GL it is a scissored clear: the vCPU doesn't
+ * wait, the old frame stays intact in VRAM until the new one lands, and the
+ * next draw finds the target GL-owned.
+ *
+ * Only for a rectangle inside one tracked target, with that target's pitch
+ * and depth, never the buffer the CRTC shows or is about to show (that keeps
+ * the Finder's and single-buffered drawing in VRAM).  A partial fill needs GL
+ * to hold the rest of the target already: GL-owned, or a readback that VRAM
+ * still matches.  Afterwards the target is GL-owned like one drawn into; VRAM
+ * catches up at the next sync point, as for 3D drawing.
+ */
+bool ati_3d_fill(ATIVGAState *s, uint32_t dst_offset, int stride, int bypp,
+                 int x, int y, int w, int h, uint32_t filler)
+{
+    ATI3DState *t = s->r3d;
+    ATITrack *hit = NULL;
+    uint64_t smc, slen, soff, koff = 0, contig, start, end, rel;
+    int tx, ty;
+    bool whole;
+    uint8_t px[4];
+
+    if (!t || !t->r || !ati_ext_mode(s) || w <= 0 || h <= 0 || !stride) {
+        return false;
+    }
+    start = dst_offset + (uint64_t)y * stride + (uint64_t)x * bypp;
+    end = dst_offset + (uint64_t)(y + h - 1) * stride + (uint64_t)(x + w) * bypp;
+    ati_scanout_range(s, &smc, &slen);
+    if (ati_mc_translate(s, smc, &soff, &contig) != ATI_MC_VRAM ||
+        (start < soff + slen && soff < end)) {
+        return false;
+    }
+    for (int i = 0; i < MAX_TRACK; i++) {
+        ATITrack *k = &t->track[i];
+        uint64_t o;
+        uint64_t klen = (uint64_t)k->img.pitch * k->img.h;
+
+        if (!k->img.w ||
+            ati_mc_translate(s, k->img.mc, &o, &contig) != ATI_MC_VRAM ||
+            !(start < o + klen && o < end)) {
+            continue;
+        }
+        if (hit) {
+            return false;                       /* spans two targets */
+        }
+        hit = k;
+        koff = o;
+    }
+    if (!hit || hit->img.pitch != (uint32_t)stride ||
+        ati_fmt_bpp(hit->img.fmt) != (unsigned)bypp || start < koff ||
+        end > koff + (uint64_t)hit->img.pitch * hit->img.h) {
+        return false;
+    }
+    rel = start - koff;
+    if ((rel % stride) % bypp) {
+        return false;
+    }
+    tx = (rel % stride) / bypp;
+    ty = rel / stride;
+    if (tx + w > hit->img.w || ty + h > hit->img.h) {
+        return false;
+    }
+    depth_sync_mc(s, hit->img.mc, (uint64_t)hit->img.pitch * hit->img.h);
+    whole = !tx && !ty && w == hit->img.w && h == hit->img.h;
+    if (!whole && !hit->gl_owned) {
+        /* GL must hold the rest of the target: VRAM unchanged since the
+         * readback (the same test as a draw's, track_acquire) */
+        if (!hit->gl_valid ||
+            ati_vram_hash(s->vga.vram_ptr + koff,
+                          (size_t)hit->img.pitch * hit->img.h) != hit->vram_hash) {
+            return false;
+        }
+    }
+    stl_he_p(px, filler);
+    ati_glr_fill(t->r, &hit->img, tx, ty, w, h, px);
+    hit->gl_owned = true;
+    hit->gl_valid = false;
+    hit->gen++;
+    t->gl_fills++;
+    return true;
+}
+
+/* no readback in flight for [mc, mc+len) */
+bool ati_3d_range_ready(ATIVGAState *s, uint64_t mc, uint64_t len)
+{
+    ATI3DState *t = s->r3d;
+
+    for (int i = 0; t && i < MAX_TRACK; i++) {
+        ATITrack *k = &t->track[i];
+        uint64_t a = k->img.mc, b = a + (uint64_t)k->img.pitch * k->img.h;
+        if (k->pending && mc < b && mc + len > a) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/*
+ * The vblank on the scanout [mc, mc+len): finished readbacks land in VRAM
+ * (never waiting for the host), and a target drawn since its last read gets
+ * a new asynchronous read (single-buffered drawing shows up a vblank or two
+ * later).  2D operations and status reads still read back synchronously
+ * (ati_3d_sync).
+ */
+void ati_3d_sync_range(ATIVGAState *s, uint64_t mc, uint64_t len)
+{
+    ATI3DState *t = s->r3d;
+
+    if (!t || !t->r) {
+        return;
+    }
+    /* Scanout is another physical-memory view, including when the guest
+     * points a CRTC directly at bytes last written as depth/stencil. */
+    depth_sync_mc(s, mc, len);
+    scanout_read_async(s, mc, len);
+}
+
+static ATITrack *track_acquire(ATIVGAState *s, const ATIImage *img)
+{
+    ATI3DState *t = s->r3d;
+    ATITrack *k = track_find(t, img->mc, img->pitch, img->fmt);
+    size_t len = (size_t)img->pitch * img->h;
+    uint8_t *buf;
+
+    depth_sync_all(s, true);
+    depth_sync_mc(s, img->mc, len);
+    /* Different framebuffer layouts can cover the same card memory.
+     * Land their writes before importing this target's initial pixels. */
+    for (unsigned i = 0; i < MAX_TRACK; i++) {
+        ATITrack *other = &t->track[i];
+        uint64_t a = other->img.mc;
+        uint64_t b = a + (uint64_t)other->img.pitch * other->img.h;
+        if (other != k && other->gl_owned && img->mc < b &&
+            (uint64_t)img->mc + len > a) {
+            track_readback(s, other);
+        }
+    }
+    if (k && k->gl_owned) {
+        if (img->h <= k->img.h) {
+            return k;
+        }
+        track_readback(s, k);
+    }
+    if (k && k->gl_valid && img->h <= k->img.h) {
+        uint64_t off, contig;
+        size_t klen = (size_t)k->img.pitch * k->img.h;
+        if (ati_mc_translate(s, k->img.mc, &off, &contig) == ATI_MC_VRAM &&
+            off + klen <= s->vga.vram_size &&
+            ati_vram_hash(s->vga.vram_ptr + off, klen) == k->vram_hash) {
+            /* nobody wrote it since the readback: GL's copy is current */
+            k->gl_owned = true;
+            t->upload_skips++;
+            return k;
+        }
+    }
+    if (!k) {
+        k = &t->track[0];
+        for (int i = 0; i < MAX_TRACK; i++) {
+            if (!t->track[i].img.w) {
+                k = &t->track[i];
+                break;
+            }
+            if (!t->track[i].gl_owned) {
+                k = &t->track[i];
+            }
+        }
+        track_readback(s, k);
+    }
+    k->img = *img;
+    ati_glr_target_hold(t->r, k - t->track, img);
+    /* the colour buffer's current contents become the GL target's */
+    buf = g_malloc(len);
+    ati_mc_rw(s, img->mc, buf, len, false);
+    ati_glr_target_upload_take(t->r, img, buf);  /* buf is the queue's now */
+    k->gl_owned = true;
+    k->gl_valid = false;
+    t->uploads++;
+    return k;
+}
+
+/* ---------------------------------------------------------------------
+ * State decoding
+ */
+
+static const uint16_t gl_cmp[8] = {
+    G_NEVER, G_LESS, G_LEQUAL, G_EQUAL, G_GEQUAL, G_GREATER, G_NOTEQUAL,
+    G_ALWAYS
+};
+
+static uint16_t blend_factor(unsigned f)
+{
+    switch (f) {
+    case 32: return 0;              /* GL_ZERO */
+    case 33: return 1;              /* GL_ONE */
+    case 34: return 0x0300;         /* SRC_COLOR */
+    case 35: return 0x0301;
+    case 36: return 0x0306;         /* DST_COLOR */
+    case 37: return 0x0307;
+    case 38: return 0x0302;         /* SRC_ALPHA */
+    case 39: return 0x0303;
+    case 40: return 0x0304;         /* DST_ALPHA */
+    case 41: return 0x0305;
+    case 42: return 0x0308;         /* SRC_ALPHA_SATURATE */
+    default: return 1;
+    }
+}
+
+static uint16_t stencil_op(unsigned op)
+{
+    static const uint16_t m[8] = { 0x1E00, 0, 0x1E01, 0x1E02, 0x1E03, 0x150A,
+                                   0x1E00, 0x1E00 };
+    return m[op & 7];
+}
+
+static uint8_t color_fmt(unsigned f)
+{
+    switch (f) {
+    case 3: return ATI_FMT_ARGB1555;
+    case 4: return ATI_FMT_RGB565;
+    case 6: return ATI_FMT_ARGB8888;
+    case 7: return ATI_FMT_RGB332;
+    case 8: return ATI_FMT_Y8;
+    case 15: return ATI_FMT_ARGB4444;
+    default: return ATI_FMT_NONE;
+    }
+}
+
+/*
+ * RB3D_PLANEMASK holds a mask in the colour buffer's pixel layout; GL masks
+ * whole channels, so a channel is written when any of its bits is (partial
+ * channel masks are not used by the guest drivers seen so far).
+ */
+static uint8_t plane_mask_channels(uint8_t fmt, uint32_t m)
+{
+    /* shift and width of R, G, B, A */
+    static const uint8_t lay[][8] = {
+        [ATI_FMT_ARGB1555] = { 10, 5, 5, 5, 0, 5, 15, 1 },
+        [ATI_FMT_RGB565]   = { 11, 5, 5, 6, 0, 5, 0, 0 },
+        [ATI_FMT_ARGB8888] = { 16, 8, 8, 8, 0, 8, 24, 8 },
+        [ATI_FMT_RGB332]   = { 5, 3, 2, 3, 0, 2, 0, 0 },
+        [ATI_FMT_ARGB4444] = { 8, 4, 4, 4, 0, 4, 12, 4 },
+    };
+    uint8_t r = 0;
+
+    if (fmt >= ARRAY_SIZE(lay) || !lay[fmt][1]) {
+        return m ? 15 : 0;
+    }
+    for (int c = 0; c < 4; c++) {
+        unsigned sh = lay[fmt][2 * c], w = lay[fmt][2 * c + 1];
+        if (!w) {
+            r |= 1 << c;        /* no such channel: GL's copy may change */
+        } else if ((m >> sh) & ((1u << w) - 1)) {
+            r |= 1 << c;
+        }
+    }
+    return r;
+}
+
+static uint8_t tex_fmt(unsigned f)
+{
+    switch (f & 31) {
+    case 0: return ATI_FMT_I8;
+    case 1: return ATI_FMT_AI88;
+    case 2: return ATI_FMT_RGB332;
+    case 3: return ATI_FMT_ARGB1555;
+    case 4: return ATI_FMT_RGB565;
+    case 5: return ATI_FMT_ARGB4444;
+    case 6: return ATI_FMT_ARGB8888;
+    case 7: return ATI_FMT_RGBA8888;
+    case 8: return ATI_FMT_Y8;
+    case 10: return ATI_FMT_VYUY422;
+    case 11: return ATI_FMT_YVYU422;
+    case 12: return ATI_FMT_DXT1;
+    case 14: return ATI_FMT_DXT23;
+    case 15: return ATI_FMT_DXT45;
+    default: return ATI_FMT_NONE;
+    }
+}
+
+static uint16_t wrap_mode(unsigned c)
+{
+    switch (c & 7) {
+    case 0: return 0x2901;              /* REPEAT */
+    case 1: return 0x8370;              /* MIRRORED_REPEAT */
+    default: return 0x812F;             /* CLAMP_TO_EDGE */
+    }
+}
+
+/* Cache invalidation uses physical VRAM pages, independently for every
+ * cached texture. One texture must not consume a shared page's change on
+ * behalf of another. len==0 conservatively invalidates the whole cache. */
+void ati_3d_texture_vram_invalidate(ATIVGAState *s, uint64_t off, uint64_t len)
+{
+    ATI3DState *t = s->r3d;
+    if (!t) {
+        return;
+    }
+    if (len && (off >= s->vga.vram_size || len > s->vga.vram_size - off)) {
+        len = 0;
+    }
+    uint64_t lo = QEMU_ALIGN_DOWN(off, qemu_target_page_size());
+    uint64_t hi = len ? QEMU_ALIGN_UP(off + len, qemu_target_page_size()) : 0;
+    for (unsigned i = 0; i < TEXC_N; i++) {
+        ATITexCache *c = &t->texc[i];
+        uint64_t co, contiguous;
+        if (!c->valid) {
+            continue;
+        }
+        if (!len ||
+            (ati_mc_translate(s, c->mc, &co, &contiguous) == ATI_MC_VRAM &&
+             co < hi && lo < co + c->len)) {
+            c->valid = false;
+        }
+    }
+}
+
+static void tex_invalidate_snapshot(ATIVGAState *s,
+                                    DirtyBitmapSnapshot *snapshot,
+                                    uint64_t lo, uint64_t hi)
+{
+    ATI3DState *t = s->r3d;
+    for (unsigned i = 0; i < TEXC_N; i++) {
+        ATITexCache *c = &t->texc[i];
+        uint64_t off, contiguous, begin, end;
+        if (!c->valid ||
+            ati_mc_translate(s, c->mc, &off, &contiguous) != ATI_MC_VRAM) {
+            continue;
+        }
+        begin = MAX(lo, QEMU_ALIGN_DOWN(off, qemu_target_page_size()));
+        end = MIN(hi, QEMU_ALIGN_UP(off + c->len, qemu_target_page_size()));
+        if (begin < end && memory_region_snapshot_get_dirty(&s->vga.vram,
+                                          snapshot, begin, end - begin)) {
+            c->valid = false;
+        }
+    }
+}
+
+/* Returns 1 dirty, 0 clean, -1 untracked (compare actual contents).
+ * VGA owns display pages. Its callback invalidates overlapping cache entries
+ * before clearing those pages; texture lookups never clear display dirt. */
+static int tex_vram_dirty(ATIVGAState *s, uint64_t mc, uint32_t len)
+{
+    uint64_t off, contig, so, sl, a0, a1;
+    VGACommonState *vga = &s->vga;
+    if (!len || ati_mc_translate(s, mc, &off, &contig) != ATI_MC_VRAM ||
+        contig < len || off >= vga->vram_size || len > vga->vram_size - off) {
+        return -1;
+    }
+    if (!ati_texture_scanout_span(s, &so, &sl)) {
+        return -1;
+    }
+    a0 = QEMU_ALIGN_DOWN(off, qemu_target_page_size());
+    a1 = QEMU_ALIGN_UP(off + len, qemu_target_page_size());
+    if (a0 < so + sl && so < a1) {
+        return -1;
+    }
+    DirtyBitmapSnapshot *snapshot = memory_region_snapshot_and_clear_dirty(
+        &s->vga.vram, a0, a1 - a0, DIRTY_MEMORY_VGA);
+    bool dirty = memory_region_snapshot_get_dirty(&s->vga.vram, snapshot,
+                                                  a0, a1 - a0);
+    if (dirty) {
+        tex_invalidate_snapshot(s, snapshot, a0, a1);
+    }
+    g_free(snapshot);
+    return dirty;
+}
+
+static void decode_texture(ATIVGAState *s, int u, ATITexUnit *tu)
+{
+    ATI3DState *t = s->r3d;
+    uint32_t filt = R(s, PP_TXFILTER_0 + u * PP_TEX_STRIDE);
+    uint32_t fmt = R(s, PP_TXFORMAT_0 + u * PP_TEX_STRIDE);
+    uint32_t offs = R(s, PP_TXOFFSET_0 + u * PP_TEX_STRIDE);
+    unsigned f = tex_fmt(fmt), bpp = ati_fmt_bpp(f);
+    unsigned w, h, maxl, levels;
+    uint32_t pos;
+    uint8_t swp;
+
+    memset(tu, 0, sizeof(*tu));
+    tu->enabled = true;
+    if (fmt & (1u << 7)) {      /* NON_POWER2: size from PP_TEX_SIZE */
+        uint32_t sz = R(s, PP_TEX_SIZE_0 + u * PP_TEX_NPOT_STRIDE);
+        w = (sz & 0x7ff) + 1;
+        h = ((sz >> 16) & 0x7ff) + 1;
+        maxl = 0;
+    } else {
+        w = 1u << ((fmt >> 8) & 15);
+        h = 1u << ((fmt >> 12) & 15);
+        maxl = (filt >> 16) & 15;
+    }
+    if (!bpp) {
+        /* compressed or unsupported: not decoded yet (drawn untextured) */
+        static bool warned;
+        if (!warned) {
+            warned = true;
+            qemu_log_mask(LOG_UNIMP, "ati: texture format %u unsupported\n",
+                          fmt & 31);
+        }
+        tu->enabled = false;
+        return;
+    }
+    trace_ati_3d_tex(u, offs, fmt, filt, w, h,
+                     R(s, PP_TXCBLEND_0 + u * PP_TEX_STRIDE),
+                     R(s, PP_TXABLEND_0 + u * PP_TEX_STRIDE));
+    swp = swap_code((fmt >> 26) & 3) ^ swap_code(offs & 3);
+    /* I8 is byte-valued. A framebuffer aperture setting must not move its
+     * edge texels into row padding. Explicit texture endian modes remain. */
+    if (!(s->i8_byte_order_enabled && f == ATI_FMT_I8)) {
+        uint8_t aperture = aperture_swap(s, bpp * 8);
+        if (s->yuv16_aperture_view_enabled &&
+            (f == ATI_FMT_VYUY422 || f == ATI_FMT_YVYU422)) {
+            /* The legacy backing stores the Mac CPU view, not independent
+             * byte-swapped aperture images. Its packed YUV uploads contain
+             * 16-bit component pairs: applying the RGB32 half-word exchange
+             * also would reverse the shared chroma and paired luma. Keep
+             * explicit per-texture endian modes separate from this opt-in
+             * CPU-view compatibility conversion. */
+            aperture &= 1;
+        }
+        swp ^= aperture;
+    }
+    tu->img.mc = offs & ~31u;
+    tu->img.fmt = f;
+    tu->img.swap = swp;
+    tu->img.w = w;
+    tu->img.h = h;
+    pos = 0;
+    levels = 0;
+    for (unsigned l = 0; l <= maxl && l < 12; l++) {
+        unsigned lw = MAX(w >> l, 1), lh = MAX(h >> l, 1);
+        uint32_t pitch;
+        if (fmt & (1u << 7)) {
+            pitch = (R(s, PP_TEX_PITCH_0 + u * PP_TEX_NPOT_STRIDE) & 0x3fe0) + 32;
+        } else if (!(offs & (1u << 2)) &&
+                   (offs & (3u << 3)) == (1u << 3) && lw * bpp <= 16) {
+            /* R100 microtile rows have a 16-byte minimum, independent of
+             * texel format. This also locates narrow 8/16-bit mip levels;
+             * a 32-byte row would skip their actual following levels. */
+            pitch = 16;
+        } else {
+            pitch = ROUND_UP(lw * bpp, 32);
+        }
+        tu->level_offs[l] = pos;
+        tu->level_w[l] = lw;
+        tu->level_h[l] = lh;
+        tu->level_pitch[l] = pitch;
+        pos += pitch * lh;
+        pos = ROUND_UP(pos, 32);
+        levels++;
+        if (lw == 1 && lh == 1) {
+            break;
+        }
+    }
+    tu->levels = levels;
+    tu->img.pitch = tu->level_pitch[0];
+    {
+        static const uint16_t minf[16] = {
+            [0] = 0x2600, [1] = 0x2601, [2] = 0x2700, [3] = 0x2702,
+            [6] = 0x2701, [7] = 0x2703, [8] = 0x2600, [9] = 0x2601,
+            [10] = 0x2700, [11] = 0x2702,
+        };
+        uint16_t m = minf[(filt >> 1) & 15];
+        tu->min_filter = m ? m : 0x2601;
+        tu->mag_filter = (filt & 1) ? 0x2601 : 0x2600;
+    }
+    tu->wrap_s = wrap_mode(filt >> 23);
+    tu->wrap_t = wrap_mode(filt >> 27);
+    if (s->texture_sampling_enabled) {
+        static const uint16_t host_wrap[8] = {
+            0x2901, 0x8370, 0x812f, 0x812f, /* repeat, mirror, last */
+            0x812d, 0x812d, 0x812d, 0x812d, /* border, GL clamp */
+        };
+        tu->clamp_s = (filt >> 23) & 7;
+        tu->clamp_t = (filt >> 27) & 7;
+        tu->wrap_s = host_wrap[tu->clamp_s];
+        tu->wrap_t = host_wrap[tu->clamp_t];
+    }
+    argb_to_float(R(s, PP_BORDER_COLOR_0 + u * 4), tu->border);
+    tu->chroma_key = fmt & (1u << 29);
+
+    /* identity and content: a cache entry per (address, layout) */
+    {
+        uint64_t key;
+        uint32_t len = pos;
+        uint8_t *data;
+        uint32_t hash;
+        ATITexCache *c;
+        int tracked;
+
+        /* Render-to-texture needs the GPU producer's bytes even when the
+         * guest has not polled an idle/status register between draws. */
+        for (unsigned i = 0; i < MAX_TRACK; i++) {
+            ATITrack *producer = &t->track[i];
+            uint64_t a = producer->img.mc;
+            uint64_t b = a + (uint64_t)producer->img.pitch * producer->img.h;
+            if (producer->gl_owned && tu->img.mc < b &&
+                (uint64_t)tu->img.mc + len > a) {
+                track_readback(s, producer);
+            }
+        }
+        depth_sync_all(s, true);
+        depth_sync_mc(s, tu->img.mc, len);
+        tracked = tex_vram_dirty(s, tu->img.mc, len);
+
+        /* The aperture describes the CPU's local VRAM view. An entire
+         * ordinary-RAM upload already has its explicit texture byte order.
+         * Qualify only after all producer/depth waits; never retain a mapping
+         * proof across BQL release. Rejected or mixed storage keeps the
+         * existing conversion. No app, dimensions or source-byte heuristic.
+         */
+        if (s->yuv_ram_byte_order_enabled && bql_locked() &&
+            (f == ATI_FMT_VYUY422 || f == ATI_FMT_YVYU422) &&
+            ati_mc_ordinary_ram_source(s, tu->img.mc, len)) {
+            swp = swap_code((fmt >> 26) & 3) ^ swap_code(offs & 3);
+            tu->img.swap = swp;
+        }
+        key = ((uint64_t)tu->img.mc << 32) ^
+              ((uint64_t)f << 24) ^ (w << 12) ^ h ^
+              ((uint64_t)swp << 30) ^ ((uint64_t)levels << 28);
+        /* Select the bucket only after the qualified swap and key agree. */
+        c = &t->texc[(key * 0x9E3779B97F4A7C15ULL) >> (64 - TEXC_BITS)];
+
+        if (tracked == 0 && c->valid && c->key == key && c->len == len) {
+            /* VRAM texture not written since it was last read */
+            tu->key = key;
+            tu->gen = c->gen;
+            t->texhits++;
+            return;
+        }
+        data = g_malloc(len);
+        ati_mc_rw(s, tu->img.mc, data, len, false);
+        c->len = len;
+        c->mc = tu->img.mc;
+        /* cheap content hash: guests rewrite textures in place */
+        hash = 2166136261u;
+        for (uint32_t i = 0; i < len; i += 4) {
+            hash = (hash ^ ldl_he_p(data + i)) * 16777619u;
+        }
+        tu->key = key;
+        if (!c->valid || c->key != key || c->gen != hash) {
+            c->valid = true;
+            c->key = key;
+            c->gen = hash;
+            ati_glr_texture(t->r, key, hash, tu, data, len);
+            t->texuploads++;
+        }
+        tu->gen = hash;
+        g_free(data);
+    }
+}
+
+/* the colour target only (for clears) */
+static bool decode_targets(ATIVGAState *s, ATIDrawState *st)
+{
+    uint32_t rb3d = R(s, RB3D_CNTL), cpitch = R(s, RB3D_COLORPITCH);
+    uint8_t cf = color_fmt((rb3d >> 10) & 15);
+    unsigned bpp = ati_fmt_bpp(cf);
+    uint32_t wh = R(s, RE_WIDTH_HEIGHT);
+
+    memset(st, 0, sizeof(*st));
+    if (!bpp) {
+        return false;
+    }
+    st->color.mc = R(s, RB3D_COLOROFFSET) & ~15u;
+    st->color.pitch = (cpitch & 0x1ff8) * bpp;
+    st->color.fmt = cf;
+    /* Color pitch defines stored byte order independently of CPU apertures. */
+    st->color.swap = swap_code((cpitch >> 18) & 3);
+    st->color.w = cpitch & 0x1ff8;
+    st->color.h = ((wh >> 16) & 0x7ff) + 1;
+    return true;
+}
+
+static bool decode_state(ATIVGAState *s, ATIDrawState *st)
+{
+    uint32_t rb3d = R(s, RB3D_CNTL), pp = R(s, PP_CNTL), se = R(s, SE_CNTL);
+    uint32_t zs = R(s, RB3D_ZSTENCILCNTL), misc = R(s, PP_MISC);
+    uint32_t cpitch = R(s, RB3D_COLORPITCH);
+    uint8_t cf = color_fmt((rb3d >> 10) & 15);
+    unsigned bpp = ati_fmt_bpp(cf);
+    uint32_t tl = R(s, RE_TOP_LEFT), wh = R(s, RE_WIDTH_HEIGHT);
+
+    memset(st, 0, sizeof(*st));
+    if (!bpp) {
+        return false;
+    }
+    st->color.mc = R(s, RB3D_COLOROFFSET) & ~15u;
+    st->color.pitch = (cpitch & 0x1ff8) * bpp;
+    st->color.fmt = cf;
+    /* Color pitch defines stored byte order independently of CPU apertures. */
+    st->color.swap = swap_code((cpitch >> 18) & 3);
+    /* surface height: up to the scissor's bottom edge */
+    st->color.w = cpitch & 0x1ff8;
+    st->color.h = ((wh >> 16) & 0x7ff) + 1;
+
+    st->scissor = true;     /* RE_TOP_LEFT/WIDTH_HEIGHT always clip */
+    st->sc_x0 = tl & 0x7ff;
+    st->sc_y0 = (tl >> 16) & 0x7ff;
+    st->sc_x1 = (wh & 0x7ff);
+    st->sc_y1 = (wh >> 16) & 0x7ff;
+
+    /* Stencil and depth have independent enable bits. A stencil-only draw
+     * still needs its attachment and comparison/write state, while disabled
+     * depth testing must not inherit the prior depth-write setting. */
+    if (rb3d & ((1 << 8) | (1 << 7))) {
+        st->depth_mc = R(s, RB3D_DEPTHOFFSET) & ~15u;
+        st->depth_pitch = R(s, RB3D_DEPTHPITCH) & 0x1ff8;
+        st->z_test = (rb3d & (1 << 8)) != 0;
+        st->z_func = gl_cmp[(zs >> 4) & 7];
+        st->z_write = st->z_test && (zs & (1u << 30));
+        st->depth_fmt = (zs & 15) == 0 ? 16 : 24;
+        if (rb3d & (1 << 7)) {      /* STENCIL_ENABLE */
+            uint32_t ref = R(s, RB3D_STENCILREFMASK);
+            st->stencil = true;
+            st->st_func = gl_cmp[(zs >> 12) & 7];
+            st->st_fail = stencil_op(zs >> 16);
+            st->st_zpass = stencil_op(zs >> 20);
+            st->st_zfail = stencil_op(zs >> 24);
+            st->st_ref = ref & 0xff;
+            st->st_mask = (ref >> 16) & 0xff;
+            st->st_wmask = ref >> 24;
+        }
+    }
+    if (rb3d & 1) {                 /* ALPHA_BLEND_ENABLE */
+        uint32_t b = R(s, RB3D_BLENDCNTL);
+        st->blend = true;
+        st->blend_src = blend_factor((b >> 16) & 63);
+        st->blend_dst = blend_factor((b >> 24) & 63);
+        st->blend_eq = ((b >> 12) & 2) ? 0x800B /* REVERSE_SUBTRACT */ : 0x8006;
+        if (((b >> 12) & 3) >= 2) {
+            st->blend_eq = 0x800A;  /* FUNC_SUBTRACT: src - dst */
+        }
+    }
+    if (rb3d & (1 << 6)) {
+        st->rop_enable = true;
+        st->rop = (R(s, RB3D_ROPCNTL) >> 8) & 15;
+    }
+    /* ATI's OpenGL clears depth alone with a rectangle drawn under plane
+     * mask 0 when the target has no fast Z clear (r_mode 0's back buffer) */
+    st->plane_mask = (rb3d & 2) ? R(s, RB3D_PLANEMASK) : 0xffffffff;
+    st->color_mask = plane_mask_channels(cf, st->plane_mask);
+    if (st->rop_enable) {
+        switch (st->rop) {
+        case 10:                    /* NOOP: the destination stays */
+            st->color_mask = 0;
+            break;
+        case 12:                    /* COPY */
+            break;
+        default: {
+            static bool warned;
+            if (!warned) {
+                warned = true;
+                qemu_log_mask(LOG_UNIMP, "ati: 3D raster op %u drawn as copy\n",
+                              st->rop);
+            }
+        }
+        }
+    }
+    trace_ati_3d_rb(rb3d, st->plane_mask, R(s, RB3D_ROPCNTL), st->color_mask);
+
+    /* culling: SE_CNTL bit 0 = front faces are CCW; b/f solid or cull */
+    {
+        bool bcull = ((se >> 1) & 3) != 3, fcull = ((se >> 3) & 3) != 3;
+        st->front_ccw = se & 1;
+        if (bcull || fcull) {
+            st->cull_enable = true;
+            st->cull_face = (bcull && fcull) ? 0x0408 : bcull ? 0x0405 : 0x0404;
+        }
+        /*
+         * The renderer flips y (row 0 = top of the guest surface), which
+         * mirrors the winding; compensate.
+         */
+        st->front_ccw = !st->front_ccw;
+    }
+    st->flat = ((se >> 8) & 3) == 1;
+    st->solid_color = ((se >> 8) & 3) == 0;
+    argb_to_float(R(s, RE_SOLID_COLOR), st->solid);
+    st->zbias = (se & (1 << 18)) != 0;
+    st->zbias_factor = RF(s, SE_ZBIAS_FACTOR);
+    st->zbias_const = RF(s, SE_ZBIAS_CONSTANT);
+
+    if (pp & (1 << 23)) {
+        st->alpha_test = true;
+        st->alpha_func = (misc >> 8) & 7;
+        st->alpha_ref = (misc & 0xff) / 255.0f;
+    }
+    if (pp & (1 << 22)) {
+        uint32_t fc = R(s, PP_FOG_COLOR);
+        st->fog = true;
+        argb_to_float(fc | 0xff000000, st->fog_color);
+        st->fog_src = ((fc >> 24) & 1) ? 1 : (((fc >> 25) & 3) == 2 ? 2 : 0);
+    }
+    st->specular = pp & (1 << 21);
+    st->stage_enable = (pp >> 12) & 7;
+    st->tex_enable = (pp >> 4) & 7;
+    for (int u = 0; u < 3; u++) {
+        st->stage[u].cblend = R(s, PP_TXCBLEND_0 + u * PP_TEX_STRIDE);
+        st->stage[u].ablend = R(s, PP_TXABLEND_0 + u * PP_TEX_STRIDE);
+        argb_to_float(R(s, PP_TFACTOR_0 + u * PP_TEX_STRIDE),
+                      st->stage[u].tfactor);
+        if (st->tex_enable & (1 << u)) {
+            decode_texture(s, u, &st->tex[u]);
+            if (!st->tex[u].enabled) {
+                st->tex_enable &= ~(1 << u);
+            }
+        }
+    }
+    st->persp_tex = true;
+    st->line_width = 1.0f;
+    return true;
+}
+
+/* ---------------------------------------------------------------------
+ * Vertices
+ */
+
+static unsigned vtx_dwords(uint32_t f)
+{
+    unsigned n = 2;
+    if (f & VF_Z) n++;
+    if (f & VF_W0) n++;
+    if (f & VF_FPCOLOR) n += 3;
+    if (f & VF_FPALPHA) n++;
+    if (f & VF_PKCOLOR) n++;
+    if (f & VF_FPSPEC) n += 3;
+    if (f & VF_FPFOG) n++;
+    if (f & VF_PKSPEC) n++;
+    if (f & VF_ST0) n += 2;
+    if (f & VF_Q0) n++;
+    if (f & VF_ST1) n += 2;
+    if (f & VF_Q1) n++;
+    if (f & VF_ST2) n += 2;
+    if (f & VF_Q2) n++;
+    if (f & VF_ST3) n += 2;
+    if (f & VF_Q3) n++;
+    if (f & VF_N0) n += 3;
+    return n;
+}
+
+static inline float fl(uint32_t u)
+{
+    union { uint32_t u; float f; } v = { .u = u };
+    return v.f;
+}
+
+/* R100 directional fixed-function lighting. Vector bank addresses and material
+ * selectors follow the open R100 driver. Local/spot lights are separate work. */
+static float tcl_dot3(const float a[3], const float b[3])
+{
+    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+}
+
+static void tcl_normalize3(float v[3])
+{
+    float length = sqrtf(tcl_dot3(v, v));
+    if (length > 0 && isfinite(length)) {
+        for (unsigned i = 0; i < 3; i++) {
+            v[i] /= length;
+        }
+    }
+}
+
+static void tcl_transform(ATI3DState *t, unsigned matrix,
+                          const float in[4], float out[4])
+{
+    unsigned base = matrix * 4;
+    if (!t->tcl_valid[base] || !t->tcl_valid[base + 1] ||
+        !t->tcl_valid[base + 2] || !t->tcl_valid[base + 3]) {
+        memcpy(out, in, 4 * sizeof(float));
+        return;
+    }
+    for (unsigned row = 0; row < 4; row++) {
+        out[row] = 0;
+        for (unsigned col = 0; col < 4; col++) {
+            out[row] += fl(t->tcl_vectors[base + row][col]) * in[col];
+        }
+    }
+}
+
+static void tcl_material(ATIVGAState *s, unsigned source, unsigned reg,
+                         const ATIVertex *v, float out[4])
+{
+    for (unsigned i = 0; i < 4; i++) {
+        out[i] = source == 2 ? v->c0[i] :
+                 source == 3 ? v->c1[i] : RF(s, reg + 4 * i);
+    }
+}
+
+static void tcl_light_vertex(ATIVGAState *s, ATIVertex *v,
+                             const float position[4], const float normal[3])
+{
+    ATI3DState *t = s->r3d;
+    uint32_t model = R(s, 0x226c), select = R(s, SE_TCL_OUTPUT_VTX_SEL);
+    float n[4] = { normal[0], normal[1], normal[2], 0 }, eye[4];
+    float material[4][4], diffuse[3] = { 0 }, specular[3] = { 0 };
+    unsigned source[4];
+
+    if (!(model & 1) || !(select & 6)) {
+        return;
+    }
+    /* The primary R100 driver uses eye-space for local viewers. Combined
+     * model-space/local-viewer semantics are not implemented here. */
+    if ((model & 6) == 6) {
+        return;
+    }
+    /* This first implementation covers directional lighting. Do not reinterpret
+     * a programmed local or spot light as an infinite light. */
+    for (unsigned light = 0; light < 8; light++) {
+        uint32_t control = R(s, 0x2270 + (light / 2) * 4) >>
+                           ((light & 1) * 16);
+        if ((control & 1) && (control & 0x18)) {
+            return;
+        }
+    }
+    if (model & 2) {
+        memcpy(eye, position, sizeof(eye));
+    } else {
+        uint32_t matrices = R(s, 0x225c);
+        float transformed[4];
+        tcl_transform(t, matrices & 15, position, eye);
+        tcl_transform(t, (matrices >> 16) & 15, n, transformed);
+        memcpy(n, transformed, sizeof(n));
+    }
+    if (model & 8) {
+        tcl_normalize3(n);
+    } else if (model & 16) {
+        float scale = fl(t->tcl_vectors[124][3]);
+        for (unsigned i = 0; i < 3; i++) {
+            n[i] *= scale;
+        }
+    }
+    for (unsigned property = 0; property < 4; property++) {
+        static const unsigned registers[4] = { 0x2210, 0x2220, 0x2230, 0x2240 };
+        source[property] = (model >> (16 + 2 * property)) & 3;
+        tcl_material(s, source[property], registers[property], v,
+                     material[property]);
+    }
+    for (unsigned i = 0; i < 3; i++) {
+        float ambient = fl(t->tcl_vectors[122][i]);
+        /* PREMULT stores emissive + global ambient * material ambient in
+         * the global vector. Other source modes store the global ambient. */
+        diffuse[i] = source[0] == 0 && source[1] == 0 ? ambient :
+                     material[0][i] + ambient * material[1][i];
+    }
+    for (unsigned light = 0; light < 8; light++) {
+        uint32_t control = R(s, 0x2270 + (light / 2) * 4) >>
+                           ((light & 1) * 16);
+        float direction[3], half_vector[3];
+        float ndotl, spec = 0;
+        if (!(control & 1)) {
+            continue;
+        }
+        for (unsigned i = 0; i < 3; i++) {
+            direction[i] = fl(t->tcl_vectors[88 + light][i]);
+        }
+        ndotl = MAX(0.0f, tcl_dot3(n, direction));
+        if ((model & 32) && (control & 4) && ndotl > 0) {
+            if (model & 4) {
+                float view[3] = { -eye[0], -eye[1], -eye[2] };
+                tcl_normalize3(view);
+                for (unsigned i = 0; i < 3; i++) {
+                    half_vector[i] = direction[i] + view[i];
+                }
+                tcl_normalize3(half_vector);
+            } else {
+                for (unsigned i = 0; i < 3; i++) {
+                    half_vector[i] = fl(t->tcl_vectors[96 + light][i]);
+                }
+            }
+            spec = powf(MAX(0.0f, tcl_dot3(n, half_vector)),
+                        MAX(0.0f, RF(s, 0x2250)));
+        }
+        for (unsigned i = 0; i < 3; i++) {
+            if (control & 2) {
+                float ambient = fl(t->tcl_vectors[64 + light][i]);
+                diffuse[i] += ambient * (source[1] ? material[1][i] : 1);
+            }
+            diffuse[i] += ndotl * fl(t->tcl_vectors[72 + light][i]) *
+                          (source[2] ? material[2][i] : 1);
+            specular[i] += spec * fl(t->tcl_vectors[80 + light][i]) *
+                           (source[3] ? material[3][i] : 1);
+        }
+    }
+    for (unsigned i = 0; i < 3; i++) {
+        if (select & 2) {
+            v->c0[i] = CLAMP(diffuse[i] + ((model & 64) ? specular[i] : 0),
+                             0.0f, 1.0f);
+        }
+        if (select & 4) {
+            v->c1[i] = (model & 64) ? 0 : CLAMP(specular[i], 0.0f, 1.0f);
+        }
+    }
+    if ((select & 2) && (model & 128)) {
+        v->c0[3] = CLAMP(material[2][3], 0.0f, 1.0f);
+    }
+}
+
+static void decode_vertex(ATIVGAState *s, uint32_t f, const uint32_t *d,
+                          ATIVertex *v, bool rgba_order, bool tcl_enable)
+{
+    uint32_t coord = R(s, SE_COORD_FMT), se = R(s, SE_CNTL);
+    unsigned i = 0;
+    float w0 = 1.0f;
+    float normal[3] = { 0 };
+
+    memset(v, 0, sizeof(*v));
+    v->x = fl(d[i++]);
+    v->y = fl(d[i++]);
+    v->z = (f & VF_Z) ? fl(d[i++]) : 0.0f;
+    if (f & VF_W0) {
+        w0 = fl(d[i++]);
+    }
+    /* R100 input layout places normal XYZ immediately after position,
+     * before diffuse/specular colors and texture coordinates. */
+    if (f & VF_N0) {
+        for (unsigned component = 0; component < 3; component++) {
+            normal[component] = fl(d[i++]);
+        }
+    }
+    v->c0[0] = v->c0[1] = v->c0[2] = v->c0[3] = 1.0f;
+    if (f & VF_FPCOLOR) {
+        /* float colours follow VF_CNTL's colour order too: B, G, R unless
+         * COLOR_ORDER_RGBA (Mac OS's RAVE engine sends BGR) */
+        int r = rgba_order ? 0 : 2, b = 2 - r;
+        v->c0[r] = fl(d[i]); v->c0[1] = fl(d[i + 1]); v->c0[b] = fl(d[i + 2]);
+        i += 3;
+    }
+    if (f & VF_FPALPHA) {
+        v->c0[3] = fl(d[i++]);
+    }
+    if (f & VF_PKCOLOR) {
+        uint32_t c = d[i++];
+        if (rgba_order) {
+            c = (c & 0xff00ff00) | ((c & 0xff) << 16) | ((c >> 16) & 0xff);
+        }
+        argb_to_float(c, v->c0);
+    }
+    v->c1[3] = 1.0f;
+    if (f & VF_FPSPEC) {
+        int r = rgba_order ? 0 : 2, b = 2 - r;
+        v->c1[r] = fl(d[i]); v->c1[1] = fl(d[i + 1]); v->c1[b] = fl(d[i + 2]);
+        i += 3;
+    }
+    if (f & VF_FPFOG) {
+        v->c1[3] = fl(d[i++]);
+    }
+    if (f & VF_PKSPEC) {
+        uint32_t c = d[i++];
+        if (rgba_order) {
+            c = (c & 0xff00ff00) | ((c & 0xff) << 16) | ((c >> 16) & 0xff);
+        }
+        argb_to_float(c, v->c1);
+    }
+    for (int u = 0; u < 4; u++) {
+        static const uint32_t stb[4] = { VF_ST0, VF_ST1, VF_ST2, VF_ST3 };
+        static const uint32_t qb[4] = { VF_Q0, VF_Q1, VF_Q2, VF_Q3 };
+        float st0 = 0, st1 = 0, q = 1.0f;
+        if (f & stb[u]) {
+            st0 = fl(d[i]);
+            st1 = fl(d[i + 1]);
+            i += 2;
+        }
+        if (f & qb[u]) {
+            q = fl(d[i++]);
+        }
+        if (u < 3) {
+            v->tc[u][0] = st0;
+            v->tc[u][1] = st1;
+            v->tc[u][2] = q;
+        }
+    }
+    if (tcl_enable && !(R(s, SE_CNTL_STATUS) & (1u << 8))) {
+        float position[4] = { v->x, v->y, v->z, w0 };
+        tcl_light_vertex(s, v, position, normal);
+    }
+    /* Selected model-projection transform; vertex blending is not emulated. */
+    bool transformed = false;
+    if (tcl_enable && !(R(s, SE_CNTL_STATUS) & (1u << 8)) &&
+        (R(s, SE_TCL_OUTPUT_VTX_SEL) & 1)) {
+        ATI3DState *t = s->r3d;
+        unsigned m = (R(s, SE_TCL_MATRIX_SELECT_1) & 15) * 4;
+        if (t->tcl_valid[m] && t->tcl_valid[m + 1] &&
+            t->tcl_valid[m + 2] && t->tcl_valid[m + 3]) {
+            float in[4] = { v->x, v->y, v->z, w0 }, out[4] = { 0 };
+            for (unsigned row = 0; row < 4; row++) {
+                for (unsigned col = 0; col < 4; col++) {
+                    out[row] += fl(t->tcl_vectors[m + row][col]) * in[col];
+                }
+            }
+            v->x = out[0]; v->y = out[1]; v->z = out[2]; w0 = out[3];
+            transformed = true;
+        }
+    }
+    /* W0 is 1/w unless the coordinate format says otherwise */
+    if (transformed) {
+        v->rhw = w0 != 0 ? 1.0f / w0 : 1.0f;
+    } else if (f & VF_W0) {
+        v->rhw = (coord & (1 << 16)) ? (w0 != 0 ? 1.0f / w0 : 1.0f) : w0;
+    } else {
+        v->rhw = 1.0f;
+    }
+    /*
+     * SE_COORD_FMT: *_PRE_MULT_1_OVER_W0 means the value has already been
+     * divided by w (projected).  The shader wants projected X/Y/Z and the
+     * true texture coordinates (GL interpolates them with w), so
+     * pre-divided texture coordinates are multiplied back by w, and X/Y/Z
+     * that are not pre-divided are divided here.  Quake III through ATI's
+     * OpenGL renderer: X/Y/Z projected, S/T divided by w, W0 = 1/w.
+     */
+    if ((transformed || !(coord & 1)) && v->rhw) {
+        v->x *= v->rhw;
+        v->y *= v->rhw;
+    }
+    if ((transformed || !(coord & 2)) && (f & VF_Z) && v->rhw) {
+        v->z *= v->rhw;
+    }
+    for (int u = 0; u < 3; u++) {
+        static const uint32_t qbit[3] = { VF_Q0, VF_Q1, VF_Q2 };
+        if (coord & (1u << (17 + 2 * u)) && v->rhw) {
+            v->tc[u][0] /= v->rhw;
+            v->tc[u][1] /= v->rhw;
+            if (f & qbit[u]) {      /* a q sent along was divided as well */
+                v->tc[u][2] /= v->rhw;
+            }
+        }
+    }
+    /* viewport transform when enabled, after the division by w */
+    if (se & (1 << 24)) {
+        v->x = v->x * RF(s, SE_VPORT_XSCALE) + RF(s, SE_VPORT_XOFFSET);
+        v->y = v->y * RF(s, SE_VPORT_YSCALE) + RF(s, SE_VPORT_YOFFSET);
+    }
+    if (se & (1 << 25)) {
+        v->z = v->z * RF(s, SE_VPORT_ZSCALE) + RF(s, SE_VPORT_ZOFFSET);
+    }
+    if (se & (1 << 27)) {       /* OpenGL pixel centres */
+        /* nothing: GL already samples at pixel centres */
+    }
+}
+
+/* GL primitive for an R100 prim type, possibly after expansion */
+static unsigned expand_prim(unsigned type, const ATIVertex *in, unsigned n,
+                            ATIVertex **out, uint16_t *glprim)
+{
+    ATIVertex *o;
+    unsigned k = 0;
+
+    switch (type) {
+    case 1: *glprim = 0x0000; *out = (ATIVertex *)in; return n;  /* points */
+    case 2: *glprim = 0x0001; *out = (ATIVertex *)in; return n;  /* lines */
+    case 3: *glprim = 0x0003; *out = (ATIVertex *)in; return n;  /* strip */
+    case 4: *glprim = 0x0004; *out = (ATIVertex *)in; return n - n % 3;
+    case 5: *glprim = 0x0006; *out = (ATIVertex *)in; return n;  /* fan */
+    case 6: *glprim = 0x0005; *out = (ATIVertex *)in; return n;  /* strip */
+    case 12: *glprim = 0x0002; *out = (ATIVertex *)in; return n; /* loop */
+    case 15: *glprim = 0x0006; *out = (ATIVertex *)in; return n; /* polygon */
+    case 8:     /* consecutive corners; v1 is the shared corner */
+        o = g_new(ATIVertex, n / 3 * 6);
+        for (unsigned i = 0; i + 2 < n; i += 3) {
+            const ATIVertex *a = &in[i], *b = &in[i + 1], *c = &in[i + 2];
+            ATIVertex v3 = *a;
+            v3.x = a->x + c->x - b->x;
+            v3.y = a->y + c->y - b->y;
+            v3.z = a->z + c->z - b->z;
+            v3.rhw = a->rhw + c->rhw - b->rhw;
+            for (unsigned component = 0; component < 4; component++) {
+                v3.c0[component] = a->c0[component] + c->c0[component] -
+                                   b->c0[component];
+                v3.c1[component] = a->c1[component] + c->c1[component] -
+                                   b->c1[component];
+                for (unsigned u = 0; u < 3; u++) {
+                    v3.tc[u][component] = a->tc[u][component] +
+                                         c->tc[u][component] -
+                                         b->tc[u][component];
+                }
+            }
+            o[k++] = in[i]; o[k++] = in[i + 1]; o[k++] = in[i + 2];
+            o[k++] = in[i]; o[k++] = in[i + 2]; o[k++] = v3;
+        }
+        *glprim = 0x0004;
+        *out = o;
+        return k;
+    case 13:    /* quad list */
+        o = g_new(ATIVertex, n / 4 * 6);
+        for (unsigned i = 0; i + 3 < n; i += 4) {
+            o[k++] = in[i]; o[k++] = in[i + 1]; o[k++] = in[i + 2];
+            o[k++] = in[i]; o[k++] = in[i + 2]; o[k++] = in[i + 3];
+        }
+        *glprim = 0x0004;
+        *out = o;
+        return k;
+    case 14:    /* quad strip */
+        *glprim = 0x0005;
+        *out = (ATIVertex *)in;
+        return n;
+    default:
+        qemu_log_mask(LOG_UNIMP, "ati: 3D primitive type %u\n", type);
+        *out = (ATIVertex *)in;
+        *glprim = 0x0004;
+        return 0;
+    }
+}
+
+static void draw(ATIVGAState *s, uint32_t vfmt, uint32_t vfcntl,
+                 ATIVertex *v, unsigned n)
+{
+    ATI3DState *t = s->r3d;
+    ATIDrawState st;
+    ATIVertex *ev;
+    uint16_t glprim;
+    unsigned en;
+
+    if (!t->r || !n || t->depth_failed || t->failed) {
+        return;
+    }
+    if (!decode_state(s, &st)) {
+        return;
+    }
+    /* Nonparametric S/T coordinates are measured in texels. */
+    for (unsigned i = 0; i < n; i++) {
+        for (unsigned u = 0; u < 3; u++) {
+            if ((R(s, SE_COORD_FMT) & (1u << (8 + u))) &&
+                (st.tex_enable & (1u << u))) {
+                v[i].tc[u][0] /= st.tex[u].img.w;
+                v[i].tc[u][1] /= st.tex[u].img.h;
+            }
+        }
+    }
+    en = expand_prim(vfcntl & 15, v, n, &ev, &glprim);
+    trace_ati_3d_draw(st.color.mc, st.depth_mc, st.z_test, st.z_func, st.z_write,
+                      st.blend, st.blend_src, st.blend_dst, vfcntl & 15, n);
+    if (trace_event_get_state_backends(TRACE_ATI_3D_DRAW_VTX)) {
+        float zmin = 1e9, zmax = -1e9, wmin = 1e9, wmax = -1e9;
+        for (unsigned i = 0; i < n; i++) {
+            zmin = MIN(zmin, v[i].z); zmax = MAX(zmax, v[i].z);
+            wmin = MIN(wmin, v[i].rhw); wmax = MAX(wmax, v[i].rhw);
+        }
+        trace_ati_3d_draw_vtx((int)(zmin * 1e6), (int)(wmin * 1e6),
+                              (int)v[0].x, (int)v[0].y, vfmt, R(s, PP_CNTL),
+                              (int)(v[0].tc[0][0] * 1e3), (int)(v[0].tc[0][1] * 1e3),
+                              (int)(v[0].tc[1][0] * 1e3), (int)(v[0].tc[1][1] * 1e3));
+        (void)zmax; (void)wmax;
+    }
+    if (en) {
+        track_acquire(s, &st.color)->gen++;
+        if (!depth_prepare_draw(s, &st)) {
+            if (ev != v) {
+                g_free(ev);
+            }
+            return;
+        }
+        ati_glr_draw(t->r, &st, glprim, ev, en);
+        /* R100 decompression/force-dirty draws materialize real depth bytes.
+         * Their zero color mask is not a request to invent a depth clear. */
+        if (st.depth_memory && (R(s, RB3D_ZSTENCILCNTL) & (1u << 31)) &&
+            (R(s, RB3D_ZSTENCILCNTL) & (1u << 29))) {
+            depth_readback(s, &t->depth[st.depth_slot]);
+        }
+        t->draws++;
+        t->verts += en;
+    }
+    if (ev != v) {
+        g_free(ev);
+    }
+}
+
+static ATIVertex *vbuf(ATI3DState *t, unsigned n)
+{
+    if (n > t->vbuf_cap) {
+        t->vbuf_cap = MAX(n, 1024);
+        t->vbuf = g_renew(ATIVertex, t->vbuf, t->vbuf_cap);
+    }
+    return t->vbuf;
+}
+
+static void draw_immd(ATIVGAState *s, const uint32_t *d, unsigned n)
+{
+    ATI3DState *t = s->r3d;
+    uint32_t vfmt, vf;
+    unsigned vsz, nv;
+    ATIVertex *v;
+
+    if (n < 2) {
+        return;
+    }
+    vfmt = d[0];
+    vf = d[1];
+    vsz = vtx_dwords(vfmt);
+    nv = MIN(vf >> 16, (n - 2) / vsz);
+    v = vbuf(t, nv);
+    for (unsigned i = 0; i < nv; i++) {
+        decode_vertex(s, vfmt, d + 2 + i * vsz, &v[i], vf & (1 << 6), vf & (1 << 9));
+    }
+    draw(s, vfmt, vf, v, nv);
+}
+
+static void draw_vbuf(ATIVGAState *s, uint32_t vfmt, uint32_t vf,
+                      const uint16_t *idx, unsigned nidx)
+{
+    ATI3DState *t = s->r3d;
+    unsigned vsz = vtx_dwords(vfmt);
+    unsigned nv = idx ? nidx : (vf >> 16);
+    uint32_t stride, base;
+    ATIVertex *v;
+    uint32_t tmp[64];
+
+    if (!t->narrays || vsz > ARRAY_SIZE(tmp)) {
+        return;
+    }
+    base = t->arr_addr[0];
+    stride = t->arr_stride[0] ? t->arr_stride[0] : vsz;
+    v = vbuf(t, nv);
+    for (unsigned i = 0; i < nv; i++) {
+        unsigned vi = idx ? idx[i] : i;
+        ati_mc_rw(s, base + (uint64_t)vi * stride * 4, tmp, vsz * 4, false);
+        /* vertex arrays are fetched with the CP's swap setting */
+        for (unsigned k = 0; k < vsz; k++) {
+            tmp[k] = (R(s, SE_CNTL_STATUS) & 3) == 2 ? ldl_be_p(&tmp[k])
+                                                     : ldl_le_p(&tmp[k]);
+        }
+        decode_vertex(s, vfmt, tmp, &v[i], vf & (1 << 6), vf & (1 << 9));
+    }
+    draw(s, vfmt, vf, v, nv);
+}
+
+/*
+ * Vertices packed in a buffer at an MC address (GART, AGP or VRAM), read
+ * in one piece and decoded by index: 3D_RNDR_GEN_INDX_PRIM.
+ *
+ * Only the vertices between the lowest and the highest index are fetched.
+ * ATI's OpenGL renderer keeps many draws' vertices in one buffer and points
+ * each draw's indices into the middle of it: fetching from the buffer's start
+ * read and byte-swapped about 16 times the vertices drawn (Quake III), all on
+ * the vCPU thread.  When the range holds no more vertices than there are
+ * indices (a mesh that reuses its vertices), each vertex is decoded once and
+ * copied per index; otherwise each index is decoded as before.  The vertices
+ * handed to the renderer are the same either way.
+ */
+static void draw_membuf(ATIVGAState *s, uint32_t base, uint32_t vfmt,
+                        uint32_t vf, const uint16_t *idx, unsigned n)
+{
+    ATI3DState *t = s->r3d;
+    unsigned vsz = vtx_dwords(vfmt), lo = 0, hi = n, nbuf;
+    bool be = (R(s, SE_CNTL_STATUS) & 3) == 2;
+    bool rgba = vf & (1 << 6);
+    size_t ndw;
+    uint32_t *buf;
+    ATIVertex *v;
+
+    if (!n) {
+        return;
+    }
+    if (idx) {
+        lo = 0xffff;
+        hi = 0;
+        for (unsigned i = 0; i < n; i++) {
+            lo = MIN(lo, (unsigned)idx[i]);
+            hi = MAX(hi, (unsigned)idx[i] + 1);
+        }
+    }
+    nbuf = hi - lo;
+    if (nbuf > 65536) {
+        qemu_log_mask(LOG_GUEST_ERROR, "ati: vertex buffer of %u vertices\n", nbuf);
+        return;
+    }
+    t->vb_fetch += nbuf;
+    t->vb_idx += n;
+    ndw = (size_t)nbuf * vsz;
+    if (ndw > t->mbuf_cap) {
+        t->mbuf_cap = MAX(ndw, 4096);
+        t->mbuf = g_renew(uint32_t, t->mbuf, t->mbuf_cap);
+    }
+    buf = t->mbuf;
+    ati_mc_rw(s, base + (uint64_t)lo * vsz * 4, buf, (uint64_t)ndw * 4, false);
+    for (size_t k = 0; k < ndw; k++) {
+        buf[k] = be ? ldl_be_p(&buf[k]) : ldl_le_p(&buf[k]);
+    }
+    v = vbuf(t, n);
+    if (idx && nbuf <= n) {
+        if (nbuf > t->dec_cap) {
+            t->dec_cap = MAX(nbuf, 1024);
+            t->dec = g_renew(ATIVertex, t->dec, t->dec_cap);
+        }
+        for (unsigned k = 0; k < nbuf; k++) {
+            decode_vertex(s, vfmt, buf + (size_t)k * vsz, &t->dec[k], rgba, vf & (1 << 9));
+        }
+        for (unsigned i = 0; i < n; i++) {
+            v[i] = t->dec[idx[i] - lo];
+        }
+    } else {
+        for (unsigned i = 0; i < n; i++) {
+            decode_vertex(s, vfmt, buf + (size_t)(idx ? idx[i] - lo : i) * vsz,
+                          &v[i], rgba, vf & (1 << 9));
+        }
+    }
+    draw(s, vfmt, vf, v, n);
+}
+
+/*
+ * 3D_CLEAR_ZMASK (first tile, tile count, clear mask): the fast Z clear.
+ * Depth lives in the host renderer, so the rows covered by the tiles are
+ * set to RB3D_DEPTHCLEARVALUE.  Mac OS's driver clears 2400 tiles for
+ * 640x480 with 16-bit Z, i.e. 128 pixels per tile in pixel order; the
+ * rows touched are cleared across the whole width.
+ */
+#define ZMASK_TILE_PIXELS 128
+
+static void clear_zmask(ATIVGAState *s, const uint32_t *d, unsigned n)
+{
+    ATI3DState *t = s->r3d;
+    ATIDrawState st;
+    uint32_t zs = R(s, RB3D_ZSTENCILCNTL), cv = R(s, RB3D_DEPTHCLEARVALUE);
+    uint64_t p0, p1;
+    unsigned y0, y1;
+    float z;
+
+    if (n < 2 || !decode_targets(s, &st) || !st.color.w) {
+        if (s->depth_memory_enabled) {
+            depth_fail(s, "Z-mask clear lacks a known surface extent");
+        }
+        return;
+    }
+    if (s->depth_memory_enabled) {
+        ATIDepthImage img;
+        ATIDepthTrack *k;
+        /* RE_WIDTH_HEIGHT is the current draw scissor, not the backing
+         * allocation boundary. Decode the format/pitch before checking the
+         * full-origin cache packet's independent allocation extent. */
+        if (!depth_descriptor(s, st.color.h, (zs & 15) != 0, &img)) {
+            return;
+        }
+        /* The packet addresses the Z-mask cache; the surface's cache
+         * allocation begins at ZMASKOFFSET. Native ATI contexts use nonzero
+         * cache allocations independently of their physical depth address. */
+        uint32_t base = R(s, RB3D_ZMASKOFFSET);
+        trace_ati_3d_zmask_memory(d[0], d[1], n > 2 ? d[2] : 0, base,
+                                 img.mc, R(s, RB3D_DEPTHPITCH), cv);
+        /* The primary R100 driver identifies bits 15/16/31/32 (one-based)
+         * as the not-clear flags. The other bits carry coarse Z metadata;
+         * they do not replace the exact DEPTHCLEARVALUE used here. Partial
+         * per-tile masks are not modeled by this opt-in backend. */
+        if (n < 3 || (d[2] & 0xc000c000)) {
+            depth_fail(s, "unsupported partial or missing Z-mask clear pattern");
+            return;
+        }
+        if (d[0] != base) {
+            depth_fail(s, "unsupported partial Z-mask cache address");
+            return;
+        }
+        /* R100 cache entries cover 128 pixels, independent of depth word
+         * size. Only a full-origin, complete eight-row allocation covering
+         * the draw extent is modeled here. Do not derive its bottom edge
+         * from the scissor: native contexts also clear padded backing rows.
+         * Partial addresses, masks and fractional or incomplete bands remain
+         * unsupported; their nonlinear cache mapping is not inferred. */
+        uint64_t pixels = (uint64_t)d[1] * ZMASK_TILE_PIXELS;
+        uint64_t height = img.w ? pixels / img.w : 0;
+        if ((img.w & 15) || !height || pixels % img.w || (height & 7) ||
+            height < ROUND_UP(st.color.h, 8) || height > 2048) {
+            depth_fail(s, "unsupported partial Z-mask cache extent");
+            return;
+        }
+        if (!depth_descriptor(s, height, (zs & 15) != 0, &img)) {
+            return;
+        }
+        if (depth_overlap(img.mc, depth_length(&img), st.color.mc,
+                          (uint64_t)st.color.pitch * st.color.h)) {
+            depth_fail(s, "Z-mask depth allocation aliases current color");
+            return;
+        }
+        y0 = 0;
+        y1 = img.h;
+        k = depth_acquire(s, &img);
+        if (!k) {
+            return;
+        }
+        z = img.fmt == 16 ? (cv & 0xffff) / 65535.0f :
+                           (cv & 0xffffff) / 16777215.0f;
+        ati_glr_depth_memory_clear(t->r, k - t->depth, &k->img, z,
+                                  img.fmt == 16 ? -1 : (int)(cv >> 24),
+                                  0, y0, img.w, y1 - y0);
+        k->gen++;
+        t->zclears++;
+        return;
+    }
+    p0 = (uint64_t)d[0] * ZMASK_TILE_PIXELS;
+    p1 = (uint64_t)(d[0] + d[1]) * ZMASK_TILE_PIXELS;
+    y0 = MIN(p0 / st.color.w, 2048);
+    y1 = MIN(DIV_ROUND_UP(p1, st.color.w), 2048);
+    if (y1 <= y0) {
+        return;
+    }
+    z = (zs & 15) == 0 ? (cv & 0xffff) / 65535.0f : (cv & 0xffffff) / 16777215.0f;
+    track_acquire(s, &st.color);
+    trace_ati_3d_zclear(st.color.mc, R(s, RB3D_DEPTHOFFSET) & ~15u, st.color.w,
+                        y1 - y0, cv, zs);
+    ati_glr_depth_clear(t->r, &st.color, R(s, RB3D_DEPTHOFFSET) & ~15u, z,
+                        (zs & 15) == 0 ? -1 : (int)(cv >> 24),
+                        0, y0, st.color.w, y1 - y0);
+    t->zclears++;
+}
+
+void ati_3d_packet(ATIVGAState *s, uint8_t op, const uint32_t *d, unsigned n)
+{
+    ATI3DState *t = s->r3d;
+
+    trace_ati_3d_packet(op, n, n > 0 ? d[0] : 0, n > 1 ? d[1] : 0);
+    if (!t || !t->r) {
+        return;
+    }
+    switch (op) {
+    case 0x25:  /* used by ATI's Mac OS RAVE engine like 3D_DRAW_IMMD (same
+                 * vertex format and VF_CNTL words, vertices inline) */
+    case 0x29:  /* 3D_DRAW_IMMD */
+        draw_immd(s, d, n);
+        break;
+    case 0x2f:  /* 3D_LOAD_VBPNTR */
+    {
+        unsigned c = d[0] & 0x1f, k = 1;
+        t->narrays = MIN(c, 16u);
+        for (unsigned i = 0; i < t->narrays && k < n; i += 2) {
+            uint32_t sz = d[k++];
+            t->arr_size[i] = (sz >> 8) & 0x7f;
+            t->arr_stride[i] = sz & 0xff;
+            if (k < n) {
+                t->arr_addr[i] = d[k++];
+            }
+            if (i + 1 < t->narrays) {
+                t->arr_size[i + 1] = (sz >> 24) & 0x7f;
+                t->arr_stride[i + 1] = (sz >> 16) & 0xff;
+                if (k < n) {
+                    t->arr_addr[i + 1] = d[k++];
+                }
+            }
+        }
+        break;
+    }
+    case 0x28:  /* 3D_DRAW_VBUF */
+        if (n >= 2) {
+            draw_vbuf(s, d[0], d[1], NULL, 0);
+        }
+        break;
+    case 0x2a:  /* 3D_DRAW_INDX: 16-bit indices packed in the packet */
+        if (n >= 2) {
+            unsigned ni = MIN(d[1] >> 16, (n - 2) * 2);
+            uint16_t *ix = g_new(uint16_t, ni);
+            for (unsigned i = 0; i < ni; i++) {
+                uint32_t w = d[2 + i / 2];
+                ix[i] = (i & 1) ? w >> 16 : w & 0xffff;
+            }
+            draw_vbuf(s, d[0], d[1], ix, ni);
+            g_free(ix);
+        }
+        break;
+    case 0x23:  /* 3D_RNDR_GEN_INDX_PRIM: buffer address, vertex count or
+                 * max index, vertex format, VF_CNTL, [16-bit indices] */
+        if (n >= 4) {
+            uint32_t vf = d[3];
+            if (((vf >> 4) & 3) == 1) {         /* WALK_IND */
+                unsigned ni = MIN(vf >> 16, (n - 4) * 2);
+                uint16_t *ix = g_new(uint16_t, ni ? ni : 1);
+                for (unsigned i = 0; i < ni; i++) {
+                    uint32_t w = d[4 + i / 2];
+                    ix[i] = (i & 1) ? w >> 16 : w & 0xffff;
+                }
+                draw_membuf(s, d[0], d[2], vf, ix, ni);
+                g_free(ix);
+            } else {                            /* WALK_LIST */
+                draw_membuf(s, d[0], d[2], vf, NULL, vf >> 16);
+            }
+        }
+        break;
+    case 0x32:  /* 3D_CLEAR_ZMASK: first tile, tile count, clear mask */
+        clear_zmask(s, d, n);
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "ati: 3D packet 0x%02x not emulated\n", op);
+        break;
+    }
+}
+
+const char *ati_3d_stats(ATIVGAState *s)
+{
+    ATI3DState *t = s->r3d;
+
+    snprintf(t->stats, sizeof(t->stats), "draws3d=%" PRIu64 " verts3d=%" PRIu64
+             " readbacks=%" PRIu64 " target_uploads=%" PRIu64
+             " tex_uploads=%" PRIu64 " tex_clean_hits=%" PRIu64
+             " zclears=%" PRIu64 " upload_skips=%" PRIu64
+             " rb_2d=%" PRIu64 " rb_status=%" PRIu64 " rb_scanout=%" PRIu64
+             " rb_cpwait=%" PRIu64
+             " flips=%" PRIu64 " joined=%" PRIu64 " flip_waits=%" PRIu64
+             " vb_fetch=%" PRIu64 " vb_idx=%" PRIu64 " gl_fills=%" PRIu64
+             " gl=%s",
+             t->draws, t->verts, t->readbacks, t->uploads, t->texuploads,
+             t->texhits, t->zclears, t->upload_skips, t->rb_why[ATI_SYNC_2D],
+             t->rb_why[ATI_SYNC_STATUS], t->rb_why[ATI_SYNC_VBLANK],
+             t->rb_why[ATI_SYNC_CP_WAIT], t->flips,
+             t->readbacks_joined, t->vblank_waits, t->vb_fetch, t->vb_idx,
+             t->gl_fills,
+             t->r ? "on" : "off");
+    if (s->depth_memory_enabled) {
+        size_t used = strlen(t->stats);
+        snprintf(t->stats + used, sizeof(t->stats) - used,
+                 " depth_uploads=%" PRIu64 " depth_readbacks=%" PRIu64,
+                 t->depth_uploads, t->depth_readbacks);
+    }
+    if (t->mc_ram_enabled) {
+        size_t used = strlen(t->stats);
+        snprintf(t->stats + used, sizeof(t->stats) - used,
+                 " mc_ram_tries=%" PRIu64 " mc_ram_hits=%" PRIu64
+                 " mc_ram_map_reject=%" PRIu64 " mc_ram_owner_reject=%" PRIu64
+                 " mc_ram_recheck_global=%" PRIu64,
+                 t->mc_ram_tries,t->mc_ram_hits,t->mc_ram_map_reject,
+                 t->mc_ram_owner_reject,t->mc_ram_recheck_global);
+    }
+    return t->stats;
+}
+
+void ati_3d_reg_write(ATIVGAState *s, hwaddr addr, uint32_t data)
+{
+    ATI3DState *t = s->r3d;
+    if (!t) {
+        return;
+    }
+    if (addr == SE_TCL_VECTOR_INDEX) {
+        t->tcl_index = data & 127;
+        t->tcl_stride = data >> 16;
+        t->tcl_component = 0;
+    } else if (addr == SE_TCL_VECTOR_DATA) {
+        t->tcl_vectors[t->tcl_index][t->tcl_component++] = data;
+        if (t->tcl_component == 4) {
+            t->tcl_valid[t->tcl_index] = true;
+            t->tcl_index = (t->tcl_index + t->tcl_stride) & 127;
+            t->tcl_component = 0;
+        }
+    }
+
+}
+
+bool ati_3d_init(ATIVGAState *s, Error **errp)
+{
+    ATI3DState *t = g_new0(ATI3DState, 1);
+    char info[256] = "";
+    const char *env = getenv("RETROBOOT_ATI_3D");
+
+    s->r3d = t;
+    t->mc_ram_enabled = s->selective_2d_ram_enabled;
+    if (t->mc_ram_enabled &&
+        (!s->coherent_vram_enabled || !s->selective_2d_sync_enabled)) {
+        error_setg(errp, "ATI RAM-source 2D sync requires coherent selective 2D");
+        return false;
+    }
+    if (t->mc_ram_enabled && env && !strcmp(env, "off")) {
+        error_setg(errp, "ATI RAM-source 2D sync conflicts with disabled 3D");
+        return false;
+    }
+    if (s->yuv_ram_byte_order_enabled && env && !strcmp(env, "off")) {
+        error_setg(errp, "ATI YUV RAM byte order conflicts with disabled 3D");
+        return false;
+    }
+    if (s->depth_memory_enabled && !s->coherent_vram_enabled) {
+        error_setg(errp, "ATI depth memory requires coherent VRAM apertures");
+        return false;
+    }
+    if (s->depth_memory_enabled && env && !strcmp(env, "off")) {
+        error_setg(errp, "ATI depth memory conflicts with disabled 3D");
+        return false;
+    }
+    if (env && !strcmp(env, "off")) {
+        if (getenv("RETROBOOT_EGL_RENDER_NODE") || s->texture_sampling_enabled) {
+            error_setg(errp, getenv("RETROBOOT_EGL_RENDER_NODE") ?
+                       "ATI explicit render node conflicts with disabled 3D" :
+                       "ATI required sampler conflicts with disabled 3D");
+            return false;
+        }
+        info_report("ati: 3D engine disabled (RETROBOOT_ATI_3D=off)");
+        return true;
+    }
+    t->r = ati_glr_new(info, sizeof(info), s->texture_sampling_enabled);
+    if (t->r) {
+        if (s->depth_memory_enabled) {
+            char depth_error[256] = "";
+            if (!ati_glr_depth_memory_enable(t->r, depth_error,
+                                             sizeof(depth_error))) {
+                error_setg(errp, "ATI depth memory initialization failed (%s)",
+                           depth_error);
+                return false;
+            }
+        }
+        info_report("ati: 3D engine on host GL: %s", info);
+    } else {
+        if (s->yuv_ram_byte_order_enabled) {
+            error_setg(errp, "ATI YUV RAM renderer initialization failed (%s)", info);
+            return false;
+        }
+        if (t->mc_ram_enabled) {
+            error_setg(errp, "ATI RAM-source renderer initialization failed (%s)", info);
+            return false;
+        }
+        if (s->depth_memory_enabled) {
+            error_setg(errp, "ATI depth memory renderer initialization failed (%s)", info);
+            return false;
+        }
+        if (getenv("RETROBOOT_EGL_RENDER_NODE") || s->texture_sampling_enabled) {
+            error_setg(errp, getenv("RETROBOOT_EGL_RENDER_NODE") ?
+                       "ATI explicit render node initialization failed (%s)" :
+                       "ATI required sampler initialization failed (%s)", info);
+            return false;
+        }
+        warn_report("ati: no host GL (%s); 3D drawing is discarded", info);
+    }
+    return true;
+}
diff --git a/hw/display/ati_3d.h b/hw/display/ati_3d.h
new file mode 100644
index 00000000..a98cd85f
--- /dev/null
+++ b/hw/display/ati_3d.h
@@ -0,0 +1,210 @@
+/*
+ * QEMU ATI Radeon (R100) emulation: interface between the 3D state decoder
+ * (vCPU thread) and the GL renderer (its own thread).
+ *
+ * Copyright (c) 2026 RetroBoot contributors
+ *
+ * This work is licensed under the GNU GPL license version 2 or later.
+ */
+#ifndef ATI_3D_H
+#define ATI_3D_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* canonical vertex: window-space position plus everything interpolated */
+typedef struct ATIVertex {
+    float x, y, z, rhw;        /* window x/y in pixels, z in [0,1], 1/w */
+    float c0[4];               /* diffuse RGBA */
+    float c1[4];               /* specular RGB, fog factor in [3] */
+    float tc[3][4];            /* s, t, q (r unused) per unit, already /w */
+} ATIVertex;
+
+enum {
+    ATI_FMT_NONE = 0,
+    ATI_FMT_ARGB1555, ATI_FMT_RGB565, ATI_FMT_ARGB8888, ATI_FMT_RGB332,
+    ATI_FMT_ARGB4444, ATI_FMT_I8, ATI_FMT_AI88, ATI_FMT_RGBA8888,
+    ATI_FMT_Y8, ATI_FMT_VYUY422, ATI_FMT_YVYU422, ATI_FMT_DXT1,
+    ATI_FMT_DXT23, ATI_FMT_DXT45, ATI_FMT_AI44,
+};
+
+/* a block of guest memory interpreted as a 2D image */
+typedef struct ATIImage {
+    uint32_t mc;               /* card address of texel/pixel (0,0) */
+    uint32_t pitch;            /* bytes per row */
+    uint16_t w, h;
+    uint8_t fmt;               /* ATI_FMT_* */
+    uint8_t swap;              /* 0 none, 1 16-bit, 2 32-bit, 3 half-dword */
+} ATIImage;
+
+#define ATI_DEPTH_SLOTS 8
+#define ATI_COLOR_SLOTS 8
+
+typedef struct ATIDepthImage {
+    uint32_t mc;
+    uint32_t pitch;             /* Guest bytes per row. */
+    uint16_t w, h;              /* Actual imported/exported pixels/rows. */
+    uint8_t fmt;                /* Exactly 16 or 24; reject all others. */
+    uint8_t swap;               /* Byte-address XOR in each four-byte group. */
+} ATIDepthImage;
+
+
+typedef struct ATITexUnit {
+    bool enabled;
+    ATIImage img;              /* level 0 */
+    uint8_t levels;            /* mip levels present (1 = base only) */
+    uint32_t level_offs[12];   /* byte offset of each level from mc */
+    uint16_t level_w[12], level_h[12];
+    uint32_t level_pitch[12];
+    uint16_t min_filter, mag_filter;   /* GL enums */
+    uint16_t wrap_s, wrap_t;           /* GL enums */
+    uint8_t clamp_s, clamp_t;          /* R100 modes, optional sampler */
+    float lod_bias;
+    float border[4];
+    uint64_t key;              /* identity of the uploaded texture */
+    uint32_t gen;              /* content generation */
+    bool chroma_key;
+} ATITexUnit;
+
+typedef struct ATIStage {
+    uint32_t cblend, ablend;
+    float tfactor[4];
+} ATIStage;
+
+typedef struct ATIDrawState {
+    ATIImage color;            /* render target */
+    uint32_t depth_mc, depth_pitch;
+    uint8_t depth_fmt;         /* 16, 24 (with stencil), 32 */
+    bool depth_memory;
+    uint8_t depth_slot;
+    ATIDepthImage depth_image;
+    bool z_test, z_write, stencil;
+    uint16_t z_func;
+    uint16_t st_func, st_fail, st_zfail, st_zpass;
+    uint8_t st_ref, st_mask, st_wmask;
+    bool blend;
+    uint16_t blend_src, blend_dst, blend_eq;
+    bool rop_enable;
+    uint8_t rop;
+    uint32_t plane_mask;
+    uint8_t color_mask;        /* bit 0 R, 1 G, 2 B, 3 A written */
+    bool scissor;
+    int16_t sc_x0, sc_y0, sc_x1, sc_y1;     /* inclusive */
+    uint8_t cull;              /* 0 none, 1 cull CW-front?, see renderer */
+    bool cull_enable;
+    uint16_t cull_face;        /* GL_FRONT/GL_BACK in screen winding */
+    bool front_ccw;
+    bool flat;                 /* flat shading of colours */
+    uint8_t flat_vtx;          /* provoking vertex */
+    bool alpha_test;
+    uint16_t alpha_func;
+    float alpha_ref;
+    bool fog;
+    float fog_color[4];
+    uint8_t fog_src;           /* 0 vertex fog factor (c1.a), 1 from z */
+    bool specular;
+    uint8_t tex_enable;        /* bit per unit */
+    uint8_t stage_enable;      /* bit per combiner stage */
+    ATITexUnit tex[3];
+    ATIStage stage[3];
+    bool persp_tex;
+    float solid[4];            /* RE_SOLID_COLOR */
+    bool solid_color;          /* diffuse shade solid */
+    float line_width;
+    float zbias_factor, zbias_const;
+    bool zbias;
+} ATIDrawState;
+
+/* render thread API (ati_glr.c) */
+typedef struct ATIRenderer ATIRenderer;
+ATIRenderer *ati_glr_new(char *info, size_t infolen, bool texture_sampling);
+void ati_glr_draw(ATIRenderer *r, const ATIDrawState *st, uint16_t prim,
+                  const ATIVertex *v, unsigned nv);
+/* make the texture identified by key current with these bytes (copied) */
+void ati_glr_texture(ATIRenderer *r, uint64_t key, uint32_t gen,
+                     const ATITexUnit *t, const uint8_t *data, size_t len);
+bool ati_glr_texture_known(ATIRenderer *r, uint64_t key, uint32_t gen);
+/* render-target content from guest memory (bytes in guest layout) */
+void ati_glr_target_upload(ATIRenderer *r, const ATIImage *img,
+                           const uint8_t *data);
+/* the same, taking ownership of data (g_malloc()ed, pitch * h bytes) */
+void ati_glr_target_upload_take(ATIRenderer *r, const ATIImage *img,
+                                uint8_t *data);
+/* fill [x, x+w) x [y, y+h) of a target with one pixel (px: guest bytes) */
+void ati_glr_fill(ATIRenderer *r, const ATIImage *img, int x, int y, int w,
+                  int h, const uint8_t px[4]);
+void ati_glr_depth_clear(ATIRenderer *r, const ATIImage *color,
+                         uint32_t depth_mc, float z, int stencil,
+                         int x, int y, int w, int h);
+/*
+ * Read the render target back into guest layout; waits. True publishes pixels
+ * and, when requested, ati_vram_hash(out, pitch * h). False publishes neither
+ * a valid buffer nor a hash and requests sticky internal-error.
+ */
+bool ati_glr_target_read(ATIRenderer *r, const ATIImage *img, uint8_t *out,
+                         uint64_t *hash);
+/* FIFO lifetime of each device-side color tracking slot. NULL releases it. */
+void ati_glr_target_hold(ATIRenderer *r, unsigned slot, const ATIImage *img);
+typedef struct ATIReadJob {
+    ATIImage img;
+    uint8_t *buf;
+    size_t len;
+    uint64_t hash;              /* ati_vram_hash(buf, len), set before done */
+    bool ok;                    /* published with done, no stale buffer on failure */
+    int done;                   /* set by the render thread (atomic) */
+} ATIReadJob;
+/*
+ * True while the vCPU waits for the render thread with the BQL released
+ * (glr_push_wait): the device's 3D state is mid-operation, so other threads
+ * holding the BQL (the vblank timer) leave it alone.
+ */
+bool ati_glr_waiting(ATIRenderer *r);
+/* content hash of guest bytes (render-target change detection) */
+uint64_t ati_vram_hash(const uint8_t *p, size_t len);
+ATIReadJob *ati_glr_target_read_async(ATIRenderer *r, const ATIImage *img);
+bool ati_glr_read_done(ATIReadJob *j);
+void ati_glr_read_wait(ATIRenderer *r, ATIReadJob *j);
+void ati_glr_read_free(ATIReadJob *j);
+void ati_glr_finish(ATIRenderer *r);
+const char *ati_glr_info(ATIRenderer *r);
+
+/* r is already running. Actual packed read self-test/extension gate, not just
+ * extension-name detection. False leaves it disabled and fills error text. */
+bool ati_glr_depth_memory_enable(ATIRenderer *r, char *error, size_t error_len);
+
+/* Deep-copy raw pitch*h bytes before returning. Fixed slot is main-owned;
+ * matching key is mc/pitch/w/fmt/swap. Reusing/growing a slot requires main to
+ * export its old contents and then upload the complete preserved new extent. */
+void ati_glr_depth_memory_upload(ATIRenderer *r, unsigned slot,
+                                 const ATIDepthImage *img, const uint8_t *raw);
+
+typedef struct ATIDepthReadJob ATIDepthReadJob;
+/* Deep-copy initial_raw (pitch*h) so all row padding is preserved. Returned
+ * reference belongs to main pending ownership. Worker holds its own reference
+ * until AFTER publishing done, signaling the event and its final job access. */
+ATIDepthReadJob *ati_glr_depth_memory_read_async(ATIRenderer *r, unsigned slot,
+                                                const ATIDepthImage *img,
+                                                const uint8_t *initial_raw);
+void ati_glr_depth_read_ref(ATIDepthReadJob *job);
+void ati_glr_depth_read_unref(ATIDepthReadJob *job);
+bool ati_glr_depth_read_done(ATIDepthReadJob *job);
+bool ati_glr_depth_read_ok(ATIDepthReadJob *job); /* only after done */
+/* Same BQL/vCPU waiting policy as current GLR wait. Caller holds a separate
+ * reference across waiting; main rechecks pending identity under BQL before
+ * landing once and releasing pending ownership. No queue-tail Finish. */
+bool ati_glr_depth_read_wait(ATIRenderer *r, ATIDepthReadJob *job);
+const uint8_t *ati_glr_depth_read_data(ATIDepthReadJob *job);
+
+/* Real decoded clear value/rectangle, never an invented far reset. img/key must
+ * already be uploaded to slot. Legacy ati_glr_depth_clear remains unchanged. */
+void ati_glr_depth_memory_clear(ATIRenderer *r, unsigned slot,
+                                const ATIDepthImage *img, float z, int stencil,
+                                int x, int y, int w, int h);
+/* FIFO + synchronous drain, detach shared depth from all color FBOs, destroy
+ * the eight resources. Main lands all owned depth before reset/remap/cleanup. */
+void ati_glr_depth_memory_reset(ATIRenderer *r);
+
+/* pixel conversion helpers shared by both sides */
+unsigned ati_fmt_bpp(uint8_t fmt);
+
+#endif
