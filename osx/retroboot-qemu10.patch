+
+/* USB reset resets protocol state, not the physical keyboard matrix. Build
+ * the current report directly; never replay old input events or timestamps. */
+static void hid_keyboard_restore_physical(HIDState *hs)
+{
+    unsigned qcode;
+    for (qcode = 1; qcode < Q_KEY_CODE__MAX; qcode++) {
+        if (hs->physical_keys[qcode / 64] & (UINT64_C(1) << (qcode % 64))) {
+            KeyValue key = { .type = KEY_VALUE_KIND_QCODE,
+                             .u.qcode.data = qcode };
+            int codes[3], i;
+            int count = qemu_input_key_value_to_scancode(&key, true, codes);
+            for (i = 0; i < count; i++) {
+                hid_keyboard_apply_keycode(hs, codes[i]);
+            }
+        }
+    }
+    hs->kbd.modifiers &= 0xff; /* no unfinished PS/2 prefix crosses reset */
+}
