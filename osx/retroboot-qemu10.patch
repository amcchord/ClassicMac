+/* The sleep packet precedes the guest's wake-vector write and HID0/MSR
+ * transition. Keep input latched and the PMU quiet until the CPU accepts
+ * hardware sleep; a key during quiesce must never redirect a running CPU. */
+static bool pmu_osx_sleep_active(PMUState *s)
+{
+    return s->osx_sleep_pending || s->osx_sleeping;
+}
