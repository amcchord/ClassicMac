+static void ati_vga_set_offset(VGACommonState *vga, uint32_t offs)
+{
+    int bypp = DIV_ROUND_UP(vga->vbe_regs[VBE_DISPI_INDEX_BPP], BITS_PER_BYTE);
+
+    if (!bypp ||
+        vga->vbe_regs[VBE_DISPI_INDEX_YRES] *
+        vga->vbe_regs[VBE_DISPI_INDEX_VIRT_WIDTH] * bypp + offs >
+        vga->vbe_size) {
+        return;
+    }
+    vga->vbe_start_addr = offs / 4;
+}
+
+/* The normal VBE raster has no split screen. Its dirty snapshot ends at
+ * start + stride * (height - 1) + visible_row_bytes. Cover the full last
+ * pitch conservatively, and reject any geometry needing a wider envelope. */
+bool ati_texture_scanout_span(ATIVGAState *s, uint64_t *off, uint64_t *len)
+{
+    VGACommonState *vga = &s->vga;
+    uint32_t bpp = vga->vbe_regs[VBE_DISPI_INDEX_BPP];
+    uint32_t width = vga->vbe_regs[VBE_DISPI_INDEX_XRES];
+    uint32_t height = vga->vbe_regs[VBE_DISPI_INDEX_YRES];
+    uint64_t row = (uint64_t)width * DIV_ROUND_UP(bpp, 8);
+    uint64_t start = (uint64_t)vga->vbe_start_addr * 4;
+    uint64_t span = (uint64_t)vga->vbe_line_offset * height;
+    if (!ati_ext_mode(s) ||
+        (vga->vbe_regs[VBE_DISPI_INDEX_ENABLE] &
+         (VBE_DISPI_ENABLED | VBE_DISPI_LFB_ENABLED)) !=
+        (VBE_DISPI_ENABLED | VBE_DISPI_LFB_ENABLED) ||
+        (bpp != 8 && bpp != 15 && bpp != 16 && bpp != 24 && bpp != 32) ||
+        !width || !height || row > vga->vbe_line_offset || !span ||
+        start >= vga->vram_size || span > vga->vram_size - start ||
+        start >= vga->vbe_size || span > vga->vbe_size - start) {
+        return false;
+    }
+    *off = start;
+    *len = span;
+    return true;
+}
+
+/* Both consumers invalidate every texture on their whole dirty pages. */
+static void ati_display_update(void *opaque)
+{
+    VGACommonState *vga = opaque;
+    ATIVGAState *s = container_of(vga, ATIVGAState, vga);
+    uint64_t start, len;
+    if (ati_texture_scanout_span(s, &start, &len)) {
+        ati_3d_texture_vram_invalidate(s, start, len);
+    } else {
+        ati_3d_texture_vram_invalidate(s, 0, 0);
+    }
+    vga->hw_ops->gfx_update(opaque);
+}
