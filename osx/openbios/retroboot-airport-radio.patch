+/*
+ * RetroBoot AirPort card node.  QEMU publishes the fw_cfg file
+ * "etc/retroboot/airport" only when the machine has the emulated card
+ * (-global macio-newworld.airport=true); without it nothing below runs and
+ * the device tree is exactly the one this firmware built before the patch.
+ *
+ * Apple's original Mac OS 9 "AirPort Driver" matches the node name "radio",
+ * rejects nodes carrying "SocketNumber", and uses Name Registry
+ * "AAPL,address" entry 0 as the Hermes register window and entry 1 as PC
+ * Card attribute memory (CIS, COR at +0x3e0).  The Mac OS ROM derives
+ * "AAPL,address" from the two "reg" entries.  Offsets follow the public
+ * Linux/NetBSD power-up sequence; the interrupt number matches QEMU's
+ * NEWWORLD_AIRPORT_IRQ.
+ */
+#define RETROBOOT_AIRPORT_FW_CFG "etc/retroboot/airport"
+
+int
+macio_retroboot_airport_present(void)
+{
+    uint16_t select;
+    uint32_t size;
+
+    /* No static state: the firmware data/bss layout (and with it every
+     * phandle in the tree) stays exactly as in the unpatched build. */
+    return fw_cfg_find_file(RETROBOOT_AIRPORT_FW_CFG, &select, &size) != 0;
+}
+
+static void
+retroboot_radio_init(const char *path, phys_addr_t addr)
+{
+    phandle_t node;
+    uint32_t props[4];
+    char buf[256];
+
+    fword("new-device");
+    push_str("radio");
+    fword("device-name");
+    snprintf(buf, sizeof(buf), "%s/radio", path);
+    node = find_dev(buf);
+    set_property(node, "built-in", "", 0);
+    props[0] = __cpu_to_be32(0x30000);
+    props[1] = __cpu_to_be32(0x1000);
+    props[2] = __cpu_to_be32(0x1a000);
+    props[3] = __cpu_to_be32(0x1000);
+    set_property(node, "reg", (char *)props, sizeof(props));
+    props[0] = __cpu_to_be32(0x39);
+    props[1] = __cpu_to_be32(1);
+    set_property(node, "interrupts", (char *)props, 2 * sizeof(props[0]));
+
+    fword("finish-device");
+}
+
 void
 ob_macio_keylargo_init(const char *path, phys_addr_t addr)
 {
@@ -528,6 +581,9 @@ ob_macio_keylargo_init(const char *path, phys_addr_t addr)
     escc_init(path, addr);
     macio_ide_init(path, addr, 2);
     openpic_init(path, addr);
+    if (macio_retroboot_airport_present()) {
+        retroboot_radio_init(path, addr);
+    }
     davbus_init(path, addr);
 
     aliases = find_dev("/aliases");
