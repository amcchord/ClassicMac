 /* set a timer for EOF */
 static void ohci_eof_timer(OHCIState *ohci)
 {
-    timer_mod(ohci->eof_timer, ohci->sof_time + usb_frame_time);
+    int64_t when = ohci->sof_time + usb_frame_time;
+
+    if (ohci_frames_idle(ohci)) {
+        when += (int64_t)(ohci->idle_frames - 1) * usb_frame_time;
+    }
+    timer_mod(ohci->eof_timer, when);
 }
