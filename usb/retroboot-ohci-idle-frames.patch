+/*
+ * With no device on the root hub and the SOF interrupt disabled a frame
+ * changes nothing but the frame number, so up to idle_frames frames run
+ * per timer (one host wakeup each idle_frames ms instead of every 1 ms).
+ * Register accesses first catch up with the frames that have ended, so the
+ * guest always sees the current frame number and interrupt state; only the
+ * HCCA frame number in guest memory advances in steps.
+ */
+static bool ohci_frames_idle(OHCIState *ohci)
+{
+    int i;
+
+    if (ohci->idle_frames <= 1 || (ohci->intr & OHCI_INTR_SF)) {
+        return false;
+    }
+    for (i = 0; i < ohci->num_ports; i++) {
+        if (ohci->rhport[i].port.dev) {
+            return false;
+        }
+    }
+    return true;
+}
