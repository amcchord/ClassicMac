+/* Run every frame that has ended (several of them while frames are batched) */
+static void ohci_frame_catch_up(OHCIState *ohci)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    while (timer_pending(ohci->eof_timer) &&
