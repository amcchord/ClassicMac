+- (void)refreshGXMetalStatus
+{
+    if (!gxmetal_status_menu) {
+        return;
+    }
+
+    __block char *raw = NULL;
+    __block bool running = false;
+    with_bql(^{
+        Error *err = NULL;
+        running = runstate_is_running();
+        raw = object_property_get_str(object_get_root(), "gxmetal-status", &err);
+        error_free(err);
+    });
+    NSDictionary *status = nil;
+    if (raw) {
+        NSData *data = [[NSString stringWithUTF8String:raw]
+            dataUsingEncoding:NSUTF8StringEncoding];
+        id decoded = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+        if ([decoded isKindOfClass:[NSDictionary class]] &&
+            [decoded[@"schema"] integerValue] == 1 &&
+            [@[@"metal", @"software"] containsObject:decoded[@"renderer"]]) {
+            status = decoded;
+        }
+        g_free(raw);
+    }
+
+    NSString *title = @"GXMetal status unavailable";
+    NSString *symbol = @"questionmark.circle";
+    BOOL contacted = [status[@"completedCommands"] unsignedLongLongValue] > 0;
+    BOOL recent = [status[@"activeContexts"] unsignedIntValue] > 0 &&
+        [status[@"successfulDraws"] unsignedLongLongValue] > 0 &&
+        [status[@"lastDrawAgeMs"] longLongValue] >= 0 &&
+        [status[@"lastDrawAgeMs"] longLongValue] < 2000;
+    if (!running) {
+        title = @"Mac is paused or starting up";
+        symbol = @"pause.circle";
+    } else if ([status[@"faulted"] boolValue] ||
+               [status[@"errorCode"] unsignedIntValue] != 0) {
+        title = @"GXMetal needs attention";
+        symbol = @"exclamationmark.triangle";
+    } else if ([status[@"renderer"] isEqualToString:@"software"]) {
+        title = @"Software renderer";
+        symbol = @"exclamationmark.triangle";
+    } else if (status && !contacted) {
+        title = @"Metal ready · waiting for guest";
+        symbol = @"bolt.slash";
+    } else if (status && recent) {
+        title = @"Rendering with Metal";
+        symbol = @"bolt.fill";
+    } else if (status) {
+        title = @"GXMetal connected · idle";
+        symbol = @"checkmark.circle";
+    }
+
+    [gxmetal_status_menu removeAllItems];
+    NSMenuItem *heading = [gxmetal_status_menu addItemWithTitle:title
+        action:nil keyEquivalent:@""];
+    [heading setImage:[NSImage imageWithSystemSymbolName:symbol
+        accessibilityDescription:title]];
+    [heading setEnabled:NO];
+    if (status) {
+        NSString *renderer = [status[@"renderer"] isEqualToString:@"metal"] ?
+            @"Host renderer: Metal" : @"Host renderer: software";
+        [gxmetal_status_menu addItemWithTitle:renderer action:nil keyEquivalent:@""];
+        [gxmetal_status_menu addItemWithTitle:(contacted ?
+            @"Guest: GXMetal commands received" : @"Guest: no GXMetal commands yet")
+            action:nil keyEquivalent:@""];
+        [gxmetal_status_menu addItemWithTitle:[NSString stringWithFormat:
+            @"Active 3D contexts: %@", status[@"activeContexts"]]
+            action:nil keyEquivalent:@""];
+        [gxmetal_status_menu addItemWithTitle:[NSString stringWithFormat:
+            @"Host protocol: %u.%u", [status[@"protocol"] unsignedIntValue] >> 16, [status[@"protocol"] unsignedIntValue] & 0xffff]
+            action:nil keyEquivalent:@""];
+        if ([status[@"errorCode"] unsignedIntValue] != 0) {
+            [gxmetal_status_menu addItemWithTitle:[NSString stringWithFormat:
+                @"Graphics error: %@", status[@"errorCode"]]
+                action:nil keyEquivalent:@""];
+        }
+    }
+    [gxmetal_status_menu addItem:[NSMenuItem separatorItem]];
+    [gxmetal_status_menu addItemWithTitle:@"How to Test or Repair GXMetal…"
+        action:@selector(showGXMetalHelp:) keyEquivalent:@""];
+}
+
+- (void)showGXMetalHelp:(id)sender
+{
+    [cocoaView ungrabMouse];
+    NSAlert *alert = [[[NSAlert alloc] init] autorelease];
+    [alert setMessageText:@"Test or Repair GXMetal"];
+    [alert setInformativeText:
+        @"Open ClassicMac Tools in the guest, then its GXMetal folder, and run "
+        @"GXMetal Test. It checks the installed driver version, rendering, "
+        @"and software fallback.\n\n"
+        @"To install or repair, run Install GXMetal from that same folder, "
+        @"restart the guest, then run GXMetal Test again.\n\n"
+        @"If Tools is missing, shut down the guest, enable ClassicMac Tools "
+        @"in this Mac’s media controls, and start it again.\n\n"
+        @"This status reports current host activity. Rendering with Metal "
+        @"means successful 3D draw commands in the last two seconds. It "
+        @"cannot confirm an installed extension version, a passing test, "
+        @"or whether a game selected Apple Software RAVE."];
+    [alert addButtonWithTitle:@"OK"];
+    [alert runModal];
+}
