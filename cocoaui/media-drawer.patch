+
+/* Managed Macs route every media action to one host drawer so changes are
+ * saved and Power Mac IDE media is staged honestly for the next startup. */
+- (void)openClassicMacMedia:(id)sender
+{
+    const char *machineID = getenv("CLASSICMAC_VM_ID");
+    if (!machineID) {
+        return;
+    }
+    NSString *identifier = [NSString stringWithUTF8String:machineID];
+    if (![[[NSUUID alloc] initWithUUIDString:identifier] autorelease]) {
+        return;
+    }
+    [cocoaView ungrabMouse];
+    [cocoaView raiseAllKeys];
+    [cocoaView raiseAllButtons];
+    [[NSDistributedNotificationCenter defaultCenter]
+        postNotificationName:@"com.classicmac.media"
                       object:identifier userInfo:nil deliverImmediately:YES];
 }
 
