+/*
+ * Ask classic Mac OS to force-quit its frontmost application. A foreground
+ * program that stops yielding can make the cooperatively scheduled desktop
+ * look completely frozen even though the guest OS and emulator are alive.
+ * Keeping this action in the host menu makes that recovery path available
+ * even while the guest window is not processing ordinary keyboard events.
+ */
+- (void)forceQuitFrontmostGuestApp:(id)sender
+{
+    with_bql(^{
+        qkbd_state_key_event(kbd, Q_KEY_CODE_META_L, true);
+        qkbd_state_key_event(kbd, Q_KEY_CODE_ALT, true);
+        qkbd_state_key_event(kbd, Q_KEY_CODE_ESC, true);
+        qkbd_state_key_event(kbd, Q_KEY_CODE_ESC, false);
+        qkbd_state_key_event(kbd, Q_KEY_CODE_ALT, false);
+        qkbd_state_key_event(kbd, Q_KEY_CODE_META_L, false);
+    });
+}
