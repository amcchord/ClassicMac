diff --git a/ui/input.c b/ui/input.c
index 1f5be0b..d2c9462 100644
--- a/ui/input.c
+++ b/ui/input.c
@@ -38,6 +38,7 @@ static QTAILQ_HEAD(, QemuInputHandlerState) handlers =
     QTAILQ_HEAD_INITIALIZER(handlers);
 static NotifierList mouse_mode_notifiers =
     NOTIFIER_LIST_INITIALIZER(mouse_mode_notifiers);
+static bool relative_mode_requested;
 
 static QemuInputEventQueueHead kbd_queue = QTAILQ_HEAD_INITIALIZER(kbd_queue);
 static QEMUTimer *kbd_timer;
@@ -309,6 +310,30 @@ void qemu_input_event_send_impl(QemuConsole *src, InputEvent *evt)
 
     qemu_input_event_trace(src, evt);
 
+    /* Classic Mac OS keeps a shared button state for every installed mouse.
+     * During relative capture, mirror buttons to the tablet and ADB handlers
+     * so one guest driver cannot immediately overwrite the other. Motion
+     * remains capability-routed: absolute to the tablet, relative to ADB. */
+    if (relative_mode_requested && evt->type == INPUT_EVENT_KIND_BTN) {
+        bool sent = false;
+
+        QTAILQ_FOREACH(s, &handlers, node) {
+            if (!(s->handler->mask & INPUT_EVENT_MASK_BTN)) {
+                continue;
+            }
+            if ((src == NULL && s->con != NULL) ||
+                (src != NULL && s->con != NULL && s->con != src)) {
+                continue;
+            }
+            s->handler->event(s->dev, src, evt);
+            s->events++;
+            sent = true;
+        }
+        if (sent) {
+            return;
+        }
+    }
+
     /* send event */
     s = qemu_input_find_handler(1 << evt->type, src);
     if (!s) {
@@ -462,11 +487,27 @@ bool qemu_input_is_absolute(QemuConsole *con)
 {
     QemuInputHandlerState *s;
 
+    if (relative_mode_requested) {
+        return false;
+    }
     s = qemu_input_find_handler(INPUT_EVENT_MASK_REL | INPUT_EVENT_MASK_ABS,
                                 con);
     return (s != NULL) && (s->handler->mask & INPUT_EVENT_MASK_ABS);
 }
 
+void qemu_input_set_relative_mode(bool relative)
+{
+    if (relative_mode_requested == relative) {
+        return;
+    }
+    relative_mode_requested = relative;
+
+    /* Motion selects the tablet or ADB mouse by capability. Button events
+     * are mirrored while relative mode is active so classic Mac OS sees one
+     * coherent button state from both installed mouse drivers. */
+    notifier_list_notify(&mouse_mode_notifiers, NULL);
+}
+
 int qemu_input_scale_axis(int value,
                           int min_in, int max_in,
                           int min_out, int max_out)
