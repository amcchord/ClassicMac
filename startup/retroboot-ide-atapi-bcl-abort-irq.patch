diff --git a/hw/ide/atapi.c b/hw/ide/atapi.c
--- a/hw/ide/atapi.c
+++ b/hw/ide/atapi.c
@@ -614,6 +614,19 @@
     /* TODO: Move abort back into core.c and introduce proper error flow between
      *       ATAPI layer and IDE core layer */
     ide_abort_command(s);
+    if (s->bus->atapi_abort_irq) {
+        /*
+         * RetroBoot: complete the aborted PACKET command like any other
+         * (interrupt reason C/D and I/O, INTRQ), as ATA8-ACS describes for
+         * PACKET error outputs.  Without the interrupt a guest that waits
+         * for it times out: Mac OS 9's ATAPI driver sends MODE SENSE (page
+         * 0x2a) with a byte count limit of 0 to every CD drive at startup
+         * and waited 1 s per drive.
+         */
+        trace_ide_atapi_bcl_abort(s);
+        s->nsector = (s->nsector & ~7) | ATAPI_INT_REASON_IO | ATAPI_INT_REASON_CD;
+        ide_bus_set_irq(s->bus);
+    }
     return false;
 }
 
