diff --git a/hw/display/vga.c b/hw/display/vga.c
--- a/hw/display/vga.c
+++ b/hw/display/vga.c
@@ -1544,6 +1544,47 @@
 /*
  * graphic modes
  */
+/*
+ * RetroBoot: whether a displayed row of untracked VRAM differs from the copy
+ * taken when it was last reported.  For a changed row, [*b0, *b1) is the span
+ * from its first to its last differing byte, and only that span is copied: a
+ * write elsewhere in the row while it is being compared still differs at the
+ * next refresh, so nothing the guest draws is lost, only reported a refresh
+ * later.  memcmp decides the common case, an unchanged row.
+ */
+static bool vga_untracked_row_changed(const uint8_t *row, uint8_t *copy,
+                                      size_t len, size_t *b0, size_t *b1)
+{
+    size_t lo = 0, hi = len;
+
+    if (likely(memcmp(row, copy, len) == 0)) {
+        return false;
+    }
+    while (lo + 8 <= len && ldq_he_p(row + lo) == ldq_he_p(copy + lo)) {
+        lo += 8;
+    }
+    while (lo < len && row[lo] == copy[lo]) {
+        lo++;
+    }
+    if (lo == len) {
+        return false;               /* written back to what was shown */
+    }
+    while (hi >= lo + 8 &&
+           ldq_he_p(row + hi - 8) == ldq_he_p(copy + hi - 8)) {
+        hi -= 8;
+    }
+    while (hi > lo && row[hi - 1] == copy[hi - 1]) {
+        hi--;
+    }
+    if (hi <= lo) {
+        hi = lo + 1;
+    }
+    memcpy(copy + lo, row + lo, hi - lo);
+    *b0 = lo;
+    *b1 = hi;
+    return true;
+}
