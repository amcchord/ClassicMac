 }
 
+static uint32_t pci_vga_cursor_argb_to_rgba(uint32_t argb)
+{
+    /* QEXT is AARRGGBB; QEMUCursor is stored as little-endian R,G,B,A. */
+    return (argb & 0xff00ff00) |
+           ((argb & 0x00ff0000) >> 16) |
+           ((argb & 0x000000ff) << 16);
+}
+
+static void pci_vga_qext_define_cursor(PCIVGAState *d)
+{
+    QEMUCursor *cursor;
+    uint32_t x, y;
+
+    if (!d->hardware_cursor || d->cursor_width == 0 ||
+        d->cursor_height == 0 ||
+        d->cursor_width > PCI_VGA_QEXT_CURSOR_MAX_WIDTH ||
+        d->cursor_height > PCI_VGA_QEXT_CURSOR_MAX_HEIGHT) {
+        return;
+    }
+
+    cursor = cursor_alloc(d->cursor_width, d->cursor_height);
+    if (!cursor) {
+        return;
+    }
+    cursor->hot_x = d->cursor_hot_x;
+    cursor->hot_y = d->cursor_hot_y;
+    for (y = 0; y < d->cursor_height; y++) {
+        for (x = 0; x < d->cursor_width; x++) {
+            cursor->data[y * d->cursor_width + x] =
+                pci_vga_cursor_argb_to_rgba(
+                    d->cursor_argb[y * PCI_VGA_QEXT_CURSOR_MAX_WIDTH + x]);
+        }
+    }
+    dpy_cursor_define(d->vga.con, cursor);
+    cursor_unref(cursor);
+    dpy_mouse_set(d->vga.con, d->cursor_x, d->cursor_y,
+                  d->cursor_visible);
+}
+
+static void pci_vga_qext_resize_write(void *ptr, hwaddr addr,
+                                      uint64_t val, unsigned size)
+{
+    VGACommonState *s = ptr;
+    PCIVGAState *d = container_of(s, PCIVGAState, vga);
+
+    if (d->hardware_cursor &&
+        addr >= PCI_VGA_QEXT_CURSOR_DATA &&
+        addr < PCI_VGA_QEXT_SIZE_CURSOR) {
+        d->cursor_argb[(addr - PCI_VGA_QEXT_CURSOR_DATA) / 4] = val;
+        return;
+    }
+
+    switch (addr) {
+    case PCI_VGA_QEXT_REG_CURSOR_WIDTH:
+        d->cursor_width = val;
+        break;
+    case PCI_VGA_QEXT_REG_CURSOR_HEIGHT:
+        d->cursor_height = val;
+        break;
+    case PCI_VGA_QEXT_REG_CURSOR_HOT_X:
+        d->cursor_hot_x = val;
+        break;
+    case PCI_VGA_QEXT_REG_CURSOR_HOT_Y:
+        d->cursor_hot_y = val;
+        break;
+    case PCI_VGA_QEXT_REG_CURSOR_X:
+        d->cursor_x = val;
+        break;
+    case PCI_VGA_QEXT_REG_CURSOR_Y:
+        d->cursor_y = val;
+        break;
+    case PCI_VGA_QEXT_REG_CURSOR_VISIBLE:
+        d->cursor_visible = val != 0;
+        break;
+    case PCI_VGA_QEXT_REG_CURSOR_COMMAND:
+        if (val & PCI_VGA_QEXT_CURSOR_DEFINE) {
+            pci_vga_qext_define_cursor(d);
+        }
+        if (val & PCI_VGA_QEXT_CURSOR_MOVE) {
+            dpy_mouse_set(s->con, d->cursor_x, d->cursor_y,
+                          d->cursor_visible);
+        }
+        break;
+    default:
+        pci_vga_qext_write(ptr, addr, val, size);
+        break;
+    }
+}
+
 static bool vga_get_big_endian_fb(Object *obj, Error **errp)
 {
     PCIVGAState *d = PCI_VGA(PCI_DEVICE(obj));
@@ -242,7 +346,7 @@ static const MemoryRegionOps pci_vga_qext_ops = {
 
