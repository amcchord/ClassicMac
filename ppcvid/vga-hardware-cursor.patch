             memory_region_init_io(&subs[2], owner, &pci_vga_qext_resize_ops,
                                   s, "qemu extended regs",
-                                  PCI_VGA_QEXT_SIZE_FEATURES);
+                                  hardware_cursor ? PCI_VGA_QEXT_SIZE_CURSOR :
