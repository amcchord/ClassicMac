diff --git a/include/hw/display/bochs-vbe.h b/include/hw/display/bochs-vbe.h
index bbaf590..6f43e28 100644
--- a/include/hw/display/bochs-vbe.h
+++ b/include/hw/display/bochs-vbe.h
@@ -88,5 +88,27 @@
 #define PCI_VGA_QEXT_REG_FEATURES     (5 * 4)
 /* packed linear 1/2/4 bpp indexed modes (packed-lowbpp=on) */
 #define  PCI_VGA_QEXT_FEATURE_PACKED_LOWBPP  0x1
+/* host-composited 16x16 ARGB cursor (hardware-cursor=on) */
+#define  PCI_VGA_QEXT_FEATURE_HARDWARE_CURSOR 0x2
+
+/*
+ * Hardware cursor registers and sprite memory. The guest stages a 16x16
+ * big-endian ARGB image at CURSOR_DATA, then commits either a definition or
+ * a position/visibility update. The expanded region still fits inside BAR2.
+ */
+#define PCI_VGA_QEXT_REG_CURSOR_WIDTH   (6 * 4)
+#define PCI_VGA_QEXT_REG_CURSOR_HEIGHT  (7 * 4)
+#define PCI_VGA_QEXT_REG_CURSOR_HOT_X   (8 * 4)
+#define PCI_VGA_QEXT_REG_CURSOR_HOT_Y   (9 * 4)
+#define PCI_VGA_QEXT_REG_CURSOR_X       (10 * 4)
+#define PCI_VGA_QEXT_REG_CURSOR_Y       (11 * 4)
+#define PCI_VGA_QEXT_REG_CURSOR_VISIBLE (12 * 4)
+#define PCI_VGA_QEXT_REG_CURSOR_COMMAND (13 * 4)
+#define  PCI_VGA_QEXT_CURSOR_DEFINE     0x1
+#define  PCI_VGA_QEXT_CURSOR_MOVE       0x2
+#define PCI_VGA_QEXT_CURSOR_DATA        0x100
+#define PCI_VGA_QEXT_CURSOR_MAX_WIDTH   16
+#define PCI_VGA_QEXT_CURSOR_MAX_HEIGHT  16
+#define PCI_VGA_QEXT_SIZE_CURSOR        0x500
 
 #endif /* HW_DISPLAY_BOCHS_VBE_H */
