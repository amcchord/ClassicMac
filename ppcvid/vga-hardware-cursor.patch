+    bool cursor_visible;
+    uint32_t cursor_argb[PCI_VGA_QEXT_CURSOR_MAX_WIDTH *
+                         PCI_VGA_QEXT_CURSOR_MAX_HEIGHT];
 };
 
 #define TYPE_PCI_VGA "pci-vga"
@@ -187,7 +199,8 @@ static uint64_t pci_vga_qext_resize_read(void *ptr, hwaddr addr,
 
     switch (addr) {
     case PCI_VGA_QEXT_REG_SIZE:
-        return PCI_VGA_QEXT_SIZE_FEATURES;
+        return d->hardware_cursor ?
+            PCI_VGA_QEXT_SIZE_CURSOR : PCI_VGA_QEXT_SIZE_FEATURES;
     case PCI_VGA_QEXT_REG_REQ_WIDTH:
         return d->host_req_width;
     case PCI_VGA_QEXT_REG_REQ_HEIGHT:
@@ -195,7 +208,9 @@ static uint64_t pci_vga_qext_resize_read(void *ptr, hwaddr addr,
     case PCI_VGA_QEXT_REG_REQ_SERIAL:
         return d->host_req_serial;
     case PCI_VGA_QEXT_REG_FEATURES:
-        return s->packed_lowbpp ? PCI_VGA_QEXT_FEATURE_PACKED_LOWBPP : 0;
+        return (s->packed_lowbpp ? PCI_VGA_QEXT_FEATURE_PACKED_LOWBPP : 0) |
