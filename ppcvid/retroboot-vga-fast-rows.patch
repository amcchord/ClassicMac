+/*
+ * RetroBoot: rows that lie in VRAM without wrapping convert from a plain
+ * pointer, 15- and 16-bit pixels through a table of the same formula: a page
+ * flip makes the whole screen dirty, and at 1920x1080 the per-pixel masked
+ * reads below took several milliseconds per frame, under the BQL.  Rows
+ * that wrap, or start on an odd address, keep the loops below.
+ */
+static const uint8_t *vga_row_ptr(VGACommonState *vga, uint32_t addr,
+                                  uint32_t bytes, uint32_t align)
+{
+    uint32_t a = addr & vga->vbe_size_mask;
+
+    if ((addr & (align - 1)) || bytes > vga->vbe_size_mask + 1u - a) {
+        return NULL;
+    }
+    return vga->vram_ptr + a;
+}
+
+static uint32_t *vga_lut15, *vga_lut16;     /* main loop only */
+
+static const uint32_t *vga_lut(bool b15)
+{
+    uint32_t **lut = b15 ? &vga_lut15 : &vga_lut16;
+
+    if (!*lut) {
+        uint32_t n = b15 ? 0x8000 : 0x10000;
+        uint32_t *t = g_new(uint32_t, n);
+        for (uint32_t v = 0; v < n; v++) {
+            t[v] = b15 ? rgb_to_pixel32((v >> 7) & 0xf8, (v >> 2) & 0xf8,
+                                        (v << 3) & 0xf8)
+                       : rgb_to_pixel32((v >> 8) & 0xf8, (v >> 3) & 0xfc,
+                                        (v << 3) & 0xf8);
+        }
+        *lut = t;
+    }
+    return *lut;
+}
+
+static bool vga_draw_row16_fast(VGACommonState *vga, uint8_t *d, uint32_t addr,
+                                int width, bool b15, bool be)
+{
+    const uint8_t *p = vga_row_ptr(vga, addr, width * 2, 2);
+    const uint32_t *lut;
+    uint32_t mask = b15 ? 0x7fff : 0xffff;
+
+    if (!p || width <= 0) {
+        return false;
+    }
+    lut = vga_lut(b15);
+    if (be) {
+        for (int x = 0; x < width; x++) {
+            ((uint32_t *)d)[x] = lut[lduw_be_p(p + 2 * x) & mask];
+        }
+    } else {
+        for (int x = 0; x < width; x++) {
+            ((uint32_t *)d)[x] = lut[lduw_le_p(p + 2 * x) & mask];
+        }
+    }
+    return true;
+}
+
+static bool vga_draw_row32_fast(VGACommonState *vga, uint8_t *d, uint32_t addr,
+                                int width, bool be)
+{
+    const uint8_t *p = vga_row_ptr(vga, addr, width * 4, 1);
+
+    if (!p || width <= 0) {
+        return false;
+    }
+    for (int x = 0; x < width; x++) {
+        uint32_t v = be ? ldl_be_p(p + 4 * x) : ldl_le_p(p + 4 * x);
+        ((uint32_t *)d)[x] = rgb_to_pixel32((v >> 16) & 0xff, (v >> 8) & 0xff,
+                                            v & 0xff);
+    }
+    return true;
+}
