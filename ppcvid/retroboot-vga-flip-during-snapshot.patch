diff --git a/hw/display/vga.c b/hw/display/vga.c
--- a/hw/display/vga.c
+++ b/hw/display/vga.c
@@ -1779,9 +1779,25 @@
     y1 = 0;
 
     if (!full_update && !s->untracked_vram_active) {
+        VGADisplayParams now;
+
         snap = memory_region_snapshot_and_clear_dirty(&s->vram, region_start,
                                                       region_end - region_start,
                                                       DIRTY_MEMORY_VGA);
+        /*
+         * RetroBoot: the vCPU can complete device writes while the snapshot
