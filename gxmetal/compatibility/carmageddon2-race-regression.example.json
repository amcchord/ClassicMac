        {"click": [350, 220], "delay_after": 1},
        {"key": "v", "delay_after": 1, "capture_after": true},
        {"chord": "Super_L+o", "delay_after": 4},
        {"screenshot": "virtual-cd-utility"},
        {"click": [221, 129], "delay_after": 3},
