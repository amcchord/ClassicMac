{
  "schema": 1,
  "defaults": {
    "boot_wait_seconds": 5,
    "observation_seconds": 0,
    "capture_interval_seconds": 4,
    "resolution": "1024x768x15"
  },
  "games": [
    {
      "id": "havoc-getgamma-gameplay-probe",
      "name": "HAVOC final gamma candidate gameplay regression",
      "modes": ["gxmetal"],
      "steps": [
        {"wait_for_pixel": {"x": 22, "y": 11, "red": 221, "green": 0, "blue": 0, "tolerance": 8, "timeout_seconds": 180, "poll_interval_seconds": 1}},
        {"screenshot": "finder-ready"},
        {"rehome_pointer": true, "delay_after": 0.25},
        {"chord": "Super_L+Alt_L+w", "delay_after": 2},
        {"double_click": [590, 52], "delay_after": 3},
        {"text": "GXMetal Sweep Games", "delay_after": 1},
        {"chord": "Super_L+o", "delay_after": 3},
        {"text": "HAVOC", "delay_after": 1},
        {"chord": "Super_L+o", "delay_after": 3},
        {"text": "HAVOC", "delay_after": 1},
        {"chord": "Super_L+o", "delay_after": 35},
        {"key": "Escape", "delay_after": 2},
        {"wait_for_pixel": {"x": 350, "y": 448, "red": 189, "green": 123, "blue": 0, "tolerance": 8, "timeout_seconds": 60, "poll_interval_seconds": 1}},
        {"screenshot": "first-run-help"},
        {"click": [350, 448], "delay_after": 5},
        {"wait_for_pixel": {"x": 140, "y": 96, "red": 124, "green": 0, "blue": 0, "tolerance": 8, "timeout_seconds": 30, "poll_interval_seconds": 1}},
        {"screenshot": "main-menu"},
        {"click": [382, 99], "delay_after": 12},
        {"screenshot": "after-single-player"},
        {"click": [320, 312], "delay_after": 12},
        {"wait_for_pixel": {"x": 304, "y": 342, "red": 255, "green": 0, "blue": 0, "tolerance": 8, "timeout_seconds": 30, "poll_interval_seconds": 1}},
        {"screenshot": "gameplay-ready"},
        {"screenshot": "before-input"},
        {"key": "Left", "hold_ms": 1000, "delay_after": 2},
        {"screenshot": "after-input"},
        {"assert_frame_changed_since": {"screenshot": "before-input", "minimum_changed_fraction": 0.15, "channel_tolerance": 16}},
        {"key": "Right", "hold_ms": 500, "delay_after": 2},
        {"wait": 10},
        {"screenshot": "short-soak"},
        {"assert_color_range_fraction_below": {"minimum_rgb": [160, 0, 0], "maximum_rgb": [200, 50, 50], "maximum_fraction": 0.50}}
      ]
    }
  ]
}
