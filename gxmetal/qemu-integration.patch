+            }
         }
         break;
     default:
@@ -455,11 +491,28 @@ static void pci_std_vga_realize(PCIDevice *dev, Error **errp)
     VGACommonState *s = &d->vga;
     bool qext = false;
     bool edid = false;
+    uint32_t i;
+
+    if (d->gxmetal_enabled &&
+        !(d->flags & (1 << PCI_VGA_FLAG_ENABLE_MMIO))) {
+        error_setg(errp, "GXMetal requires the VGA MMIO BAR");
+        return;
+    }
+    if (d->gxmetal_enabled &&
+        !(d->flags & (1 << PCI_VGA_FLAG_ENABLE_QEXT))) {
+        error_setg(errp, "GXMetal requires the QEMU VGA extended registers");
+        return;
+    }
 
     /* vga + console init */
     if (!vga_common_init(s, OBJECT(dev), errp)) {
         return;
     }
+    for (i = 0; i < 256; i++) {
+        d->gamma_red[i] = i;
+        d->gamma_green[i] = i;
+        d->gamma_blue[i] = i;
+    }
     vga_init(s, OBJECT(dev), pci_address_space(dev), pci_address_space_io(dev),
              true);
 
@@ -489,7 +542,20 @@ static void pci_std_vga_realize(PCIDevice *dev, Error **errp)
         }
         pci_std_vga_mmio_region_init(s, OBJECT(dev), &d->mmio, d->mrs,
                                      qext, edid, d->host_resize,
-                                     d->hardware_cursor);
+                                     d->hardware_cursor ||
+                                         d->gxmetal_enabled);
+
+        if (d->gxmetal_enabled) {
+            if (!gxmetal_qemu_init(&d->gxmetal, OBJECT(dev), &s->vram,
+                                   s->vram_size, s->con, errp)) {
+                return;
+            }
+            memory_region_add_subregion(&d->mmio,
+                                        GXMETAL_BAR2_REGISTER_OFFSET,
+                                        &d->gxmetal.registers);
+            pci_register_bar(&d->dev, 4, PCI_BASE_ADDRESS_MEM_PREFETCH,
+                             &d->gxmetal.shared);
+        }
 
         pci_register_bar(&d->dev, 2, PCI_BASE_ADDRESS_SPACE_MEMORY, &d->mmio);
     }
@@ -566,6 +632,7 @@ static const Property vga_pci_properties[] = {
     DEFINE_PROP_BOOL("packed-lowbpp", PCIVGAState, vga.packed_lowbpp, false),
     DEFINE_PROP_BOOL("untracked-vram", PCIVGAState, vga.untracked_vram, false),
     DEFINE_PROP_BOOL("hardware-cursor", PCIVGAState, hardware_cursor, false),
+    DEFINE_PROP_BOOL("gxmetal", PCIVGAState, gxmetal_enabled, false),
     DEFINE_EDID_PROPERTIES(PCIVGAState, edid_info),
 };
 
diff --git a/include/hw/display/bochs-vbe.h b/include/hw/display/bochs-vbe.h
