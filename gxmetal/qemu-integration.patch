@@ -76,6 +77,16 @@ struct PCIVGAState {
     bool cursor_visible;
     uint32_t cursor_argb[PCI_VGA_QEXT_CURSOR_MAX_WIDTH *
                          PCI_VGA_QEXT_CURSOR_MAX_HEIGHT];
+
+    /* Classic Mac cscSetGamma table staged through QEXT. */
+    uint32_t gamma_index;
+    uint8_t gamma_red[256];
+    uint8_t gamma_green[256];
+    uint8_t gamma_blue[256];
+
+    /* Optional paravirtual QuickDraw 3D RAVE command transport. */
