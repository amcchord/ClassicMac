+#define PCI_VGA_QEXT_REG_GAMMA_INDEX    (14 * 4)
+#define PCI_VGA_QEXT_REG_GAMMA_VALUE    (15 * 4)
+#define PCI_VGA_QEXT_REG_GAMMA_COMMAND  (16 * 4)
+#define  PCI_VGA_QEXT_GAMMA_APPLY       0x1
 #define PCI_VGA_QEXT_CURSOR_DATA        0x100
