     default:
         return pci_vga_qext_read(ptr, addr, size);
     }
@@ -273,5 +288,9 @@ static void pci_vga_qext_define_cursor(PCIVGAState *d)
     cursor_unref(cursor);
     dpy_mouse_set(d->vga.con, d->cursor_x, d->cursor_y,
                   d->cursor_visible);
+    if (d->gxmetal_enabled) {
+        gxmetal_qemu_set_guest_cursor_visible(&d->gxmetal,
+                                               d->cursor_visible);
+    }
 }
 
@@ -286,6 +304,27 @@ static void pci_vga_qext_resize_write(void *ptr, hwaddr addr,
     }
 
     switch (addr) {
+    case PCI_VGA_QEXT_REG_GAMMA_INDEX:
+        if (d->gxmetal_enabled) {
+            d->gamma_index = val & 255;
+        }
+        break;
+    case PCI_VGA_QEXT_REG_GAMMA_VALUE:
+        if (d->gxmetal_enabled) {
+            uint32_t index = d->gamma_index & 255;
+
+            d->gamma_red[index] = (val >> 16) & 255;
+            d->gamma_green[index] = (val >> 8) & 255;
+            d->gamma_blue[index] = val & 255;
+            d->gamma_index = (index + 1) & 255;
+        }
+        break;
+    case PCI_VGA_QEXT_REG_GAMMA_COMMAND:
+        if (d->gxmetal_enabled && (val & PCI_VGA_QEXT_GAMMA_APPLY)) {
+            gxmetal_metal_set_gamma(d->gxmetal.metal, d->gamma_red,
+                                    d->gamma_green, d->gamma_blue);
+        }
+        break;
     case PCI_VGA_QEXT_REG_CURSOR_WIDTH:
         d->cursor_width = val;
         break;
@@ -321,6 +360,10 @@ static void pci_vga_qext_resize_write(void *ptr, hwaddr addr,
         if (val & PCI_VGA_QEXT_CURSOR_MOVE) {
             dpy_mouse_set(s->con, d->cursor_x, d->cursor_y,
                           d->cursor_visible);
+            if (d->gxmetal_enabled) {
