+    GXMetalQemuState gxmetal;
 };
 
 #define TYPE_PCI_VGA "pci-vga"
@@ -199,7 +210,7 @@ static uint64_t pci_vga_qext_resize_read(void *ptr, hwaddr addr,
 
     switch (addr) {
     case PCI_VGA_QEXT_REG_SIZE:
-        return d->hardware_cursor ?
+        return (d->hardware_cursor || d->gxmetal_enabled) ?
