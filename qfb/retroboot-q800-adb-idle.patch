+/* RetroBoot: the autopoll period (slower while the devices are idle). */
+static int64_t adb_autopoll_delay(ADBBusState *s)
+{
+    if (s->idle_rate_ms > s->autopoll_rate_ms &&
+        qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) - s->last_input_ms >=
+        s->idle_after_ms) {
+        return s->idle_rate_ms;
+    }
+    return s->autopoll_rate_ms;
+}
+
+/* A device got input from the host: poll it now, then at the full rate. */
+void adb_input_activity(ADBBusState *s)
+{
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+    bool was_idle = adb_autopoll_delay(s) != s->autopoll_rate_ms;
+
+    s->last_input_ms = now;
+    if (was_idle && s->autopoll_enabled && s->autopoll_mask &&
+        !s->autopoll_blocked) {
+        timer_mod(s->autopoll_timer, now);
+    }
+}
+
 void adb_autopoll_block(ADBBusState *s)
 {
     s->autopoll_blocked = true;
@@ -191,7 +222,7 @@ void adb_autopoll_unblock(ADBBusState *s)
