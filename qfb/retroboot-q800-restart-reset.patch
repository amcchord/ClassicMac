diff --git a/target/m68k/cpu.h b/target/m68k/cpu.h
index 7911ab9de3..44480a455b 100644
--- a/target/m68k/cpu.h
+++ b/target/m68k/cpu.h
@@ -167,6 +167,15 @@ struct ArchCPU {
     CPUState parent_obj;
 
     CPUM68KState env;
+
+    /*
+     * RetroBoot: a Macintosh ROM executes RESET once at power-on and again
+     * when Mac OS restarts.  With restart-resets on, every RESET after the
+     * first since the last system reset asks for a system reset (guest-reset),
+     * as the machine's restart.  Off: RESET does nothing (QEMU's behaviour).
+     */
+    bool restart_resets;
+    uint32_t reset_insns;
 };
 
 /*
