RetroBoot: Mac OS's Restart on the Quadra 800 is a system reset, and a q800 system reset starts the ROM again (m68k series).

The Macintosh ROM executes RESET once at power-on (PC 0x4080009C on the
Quadra 610/650/800 ROM) and runs the same path when Mac OS restarts; QEMU's
RESET does nothing, so a Restart (Special menu, the power dialog's Restart
button or R) rebooted the Mac inside the running QEMU without any QMP event,
and hostd could not tell a Restart from a hang.  m68k CPU property
restart-resets (default off; on for the q800 through its compat globals): a
RESET after the first since the last system reset requests a system reset
(SHUTDOWN_CAUSE_GUEST_RESET: QMP SHUTDOWN guest-reset with -action
reboot=shutdown, RESET guest-reset otherwise).  -global
m68040-m68k-cpu.restart-resets=off restores QEMU's in-place restart.

A q800 system reset (this one, or QMP system_reset) loaded the initial SP
and PC from RAM at 0 and 4, which hold Mac OS's vectors by then: the CPU
started at a stale RAM address and the screen stayed white.  The machine now
keeps the ROM's reset vectors and writes them back before the CPU reset.

diff --git a/hw/m68k/q800.c b/hw/m68k/q800.c
index c52b3b5012..c0317ceb2d 100644
--- a/hw/m68k/q800.c
+++ b/hw/m68k/q800.c
@@ -108,7 +108,17 @@ static void main_cpu_reset(void *opaque)
 {
     M68kCPU *cpu = opaque;
     CPUState *cs = CPU(cpu);
-
+    Q800MachineState *m = container_of(cpu, Q800MachineState, cpu);
+
+    if (m->rom_reset_vectors) {
+        /*
+         * RetroBoot: put the Mac ROM's reset vectors back at 0 and 4.  By the
+         * time of a system reset Mac OS's vectors are in that RAM, and the CPU
+         * started at a stale RAM address (a white screen) instead of the ROM.
+         */
+        stl_phys(cs->as, 0, m->rom_reset_sp);
+        stl_phys(cs->as, 4, m->rom_reset_pc);
+    }
     cpu_reset(cs);
     cpu->env.aregs[7] = ldl_phys(cs->as, 0);
     cpu->env.pc = ldl_phys(cs->as, 4);
@@ -697,6 +707,9 @@ static void q800_machine_init(MachineState *machine)
             stl_phys(cs->as, 0, ldl_be_p(ptr));    /* reset initial SP */
             stl_phys(cs->as, 4,
                      MACROM_ADDR + ldl_be_p(ptr + 4)); /* reset initial PC */
+            m->rom_reset_sp = ldl_be_p(ptr);
+            m->rom_reset_pc = MACROM_ADDR + ldl_be_p(ptr + 4);
+            m->rom_reset_vectors = true;
         }
     }
 }
@@ -781,6 +794,8 @@ static void q800_init(Object *obj)
 }
 
 static GlobalProperty hw_compat_q800[] = {
+    /* RetroBoot: Mac OS's Restart is a system reset (guest-reset) */
+    { M68K_CPU_TYPE_NAME("m68040"), "restart-resets", "on" },
     { "scsi-hd", "quirk_mode_page_vendor_specific_apple", "on" },
     { "scsi-hd", "vendor", " SEAGATE" },
     { "scsi-hd", "product", "          ST225N" },
