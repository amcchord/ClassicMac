+	li	r6,0
+	stwx	r6,r3,r5
+	addi	r5,r5,4
+	stwx	r6,r3,r5
+	b	3f
+2:
+	stwx	r6,r3,r5
+3:
+	mtcr	r9
 	blr
 GLOBL(of_rtas_end):
 
