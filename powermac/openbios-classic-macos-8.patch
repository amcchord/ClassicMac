 #include "cuda.h"
+#include "timer.h"
 
 //#define DEBUG_CUDA
 #ifdef DEBUG_CUDA
@@ -174,6 +175,25 @@ DECLARE_UNNAMED_NODE(ob_cuda, 0, sizeof(int));
 
 static cuda_t *main_cuda;
 
+void
+cuda_quiesce(void)
+{
+	if (main_cuda == NULL)
+		return;
+
+	/*
+	 * OpenBIOS polls CUDA synchronously and does not install an interrupt
+	 * handler.  Do not leave a pending VIA interrupt asserted when the client
+	 * calls quiesce: older Mac OS ROMs enable external interrupts before their
+	 * CUDA driver has taken ownership and otherwise loop in the NanoKernel
+	 * interrupt dispatcher.
+	 */
+	/* Let QEMU's delayed shift-register completion become visible first. */
+	udelay(1000);
+	cuda_readb(main_cuda, SR);
+	cuda_writeb(main_cuda, IFR, 0x7f);
+}
+
 static void
 ppc32_reset_all(void)
 {
