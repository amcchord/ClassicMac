+/* A real MAC finishes a packet after the guest has submitted its descriptor.
+ * This opt-in delay also keeps a synchronous backend from returning a reply
+ * while the old guest driver is still accounting for its transmit request. */
+static int rtl8139_next_tx(RTL8139State *s)
+{
+    int first = -1;
+    for (int i = 0; i < 4; i++) {
+        if ((s->tx_pending & (1u << i)) &&
+            (first < 0 || s->tx_deadline[i] < s->tx_deadline[first])) {
+            first = i;
+        }
+    }
+    return first;
+}
+
+static void rtl8139_delayed_tx(void *opaque)
+{
+    RTL8139State *s = opaque;
+    int next;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    while ((next = rtl8139_next_tx(s)) >= 0) {
+        if (s->tx_deadline[next] > now) {
+            timer_mod(s->tx_timer, s->tx_deadline[next]);
+            return;
+        }
+        s->tx_pending &= ~(1u << next);
+        rtl8139_transmit_one_now(s, next);
+    }
+}
+
+static int rtl8139_transmit_one(RTL8139State *s, int descriptor)
+{
+    if (!s->tx_delay_ns) {
+        return rtl8139_transmit_one_now(s, descriptor);
+    }
+    if (!rtl8139_transmitter_enabled(s) ||
+        (s->TxStatus[descriptor] & TxHostOwns) ||
+        (s->tx_pending & (1u << descriptor))) {
+        return 0;
+    }
+    int64_t due = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    for (int i = 0; i < 4; i++) {
+        if (s->tx_pending & (1u << i)) {
+            due = MAX(due, s->tx_deadline[i]);
+        }
+    }
+    s->tx_deadline[descriptor] = due + s->tx_delay_ns;
+    s->tx_pending |= 1u << descriptor;
+    timer_mod(s->tx_timer, s->tx_deadline[rtl8139_next_tx(s)]);
+    return 1;
+}
+
