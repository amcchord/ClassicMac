+bool icount_request_runtime_disable(void)
+{
+    if (!icount_enabled() || replay_mode != REPLAY_MODE_NONE) {
+        return false;
+    }
+
+    qatomic_set(&runtime_disable_requested, true);
+    if (first_cpu) {
+        qemu_cpu_kick(first_cpu);
+    }
+    qemu_notify_event();
+    return true;
+}
+
+bool icount_runtime_disable_requested(void)
+{
+    return qatomic_read(&runtime_disable_requested);
+}
+
+bool icount_complete_runtime_disable(void)
+{
+    int64_t virtual_time;
+
+    if (!qatomic_xchg(&runtime_disable_requested, false) ||
+        !icount_enabled()) {
+        return false;
+    }
+
+    /*
+     * The caller has already run icount_process_data(), so this samples a
+     * fully-accounted boundary.  Rebase the normal clock before publishing
+     * ICOUNT_DISABLED: readers then see the same virtual nanosecond on either
+     * side of the switch.
+     */
+    virtual_time = icount_get();
+    cpu_set_clock(virtual_time);
+
+    if (timers_state.icount_warp_timer) {
+        timer_free(timers_state.icount_warp_timer);
+        timers_state.icount_warp_timer = NULL;
+    }
+    if (timers_state.icount_rt_timer) {
+        timer_free(timers_state.icount_rt_timer);
+        timers_state.icount_rt_timer = NULL;
+    }
+    if (timers_state.icount_vm_timer) {
+        timer_free(timers_state.icount_vm_timer);
+        timers_state.icount_vm_timer = NULL;
+    }
+    timers_state.vm_clock_warp_start = -1;
+    icount_sleep = true;
+    icount_align_option = false;
+    use_icount = ICOUNT_DISABLED;
+    qemu_clock_notify(QEMU_CLOCK_VIRTUAL);
+    return true;
+}
