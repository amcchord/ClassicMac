+/*
+ * Rebase the normal virtual clock without stopping it.  Runtime icount
+ * handoff uses this to preserve the guest-visible time accumulated during
+ * startup before switching back to the host monotonic clock.
+ */
+void cpu_set_clock(int64_t new_time)
+{
+    seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                       &timers_state.vm_clock_lock);
+    timers_state.cpu_clock_offset = new_time;
+    if (timers_state.cpu_ticks_enabled) {
+        timers_state.cpu_clock_offset -= get_clock();
+    }
+    seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                         &timers_state.vm_clock_lock);
+}
