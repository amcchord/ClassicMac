+static uint32_t page_coverage_mask(tb_page_addr_t first,
+                                   tb_page_addr_t last)
+{
+    const unsigned shift = TARGET_PAGE_BITS - 5;
+    const tb_page_addr_t page_offset_mask = ~TARGET_PAGE_MASK;
+    unsigned first_region = (first & page_offset_mask) >> shift;
+    unsigned last_region = (last & page_offset_mask) >> shift;
+
+    tcg_debug_assert(((first ^ last) & TARGET_PAGE_MASK) == 0);
+    return (UINT32_MAX << first_region) &
+           (UINT32_MAX >> (31 - last_region));
+}
+
+static uint32_t tb_page_coverage_mask(const TranslationBlock *tb,
+                                      unsigned int n)
+{
+    tb_page_addr_t page0 = tb_page_addr0(tb);
+    tb_page_addr_t first = n == 0 ? page0 : tb_page_addr1(tb);
+    tb_page_addr_t last = page0 + tb->size - 1;
+
+    if (n == 0) {
+        last = MIN(last, first | ~TARGET_PAGE_MASK);
+    } else {
+        last = first + (last & ~TARGET_PAGE_MASK);
+    }
+    return page_coverage_mask(first, last);
+}
