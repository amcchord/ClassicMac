@@ -501,6 +501,16 @@
  */
 static uint64_t ns_to_tb(uint32_t freq, int64_t clock)
 {
+    /*
+     * Mac99's architectural timebase is exactly 25 MHz, so one tick is
+     * exactly 40 ns.  The generic muldiv64 path performs a 128-bit divide;
+     * Mac OS 9 reads TBU/TBL continuously while polling startup services,
+     * making that otherwise-correct generic conversion a measurable TCG
+     * bottleneck.  Preserve the same floor semantics with a native divide.
+     */
+    if (likely(freq == 25000000)) {
+        return clock / 40;
+    }
     return muldiv64(clock, freq, NANOSECONDS_PER_SECOND);
 }
 
