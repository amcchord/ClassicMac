diff --git a/hw/misc/macio/cuda.c b/hw/misc/macio/cuda.c
index 312dde242ba..6f0c8ae333b 100644
--- a/hw/misc/macio/cuda.c
+++ b/hw/misc/macio/cuda.c
@@ -204,7 +204,7 @@ static void cuda_adb_poll(void *opaque)
 {
     CUDAState *s = opaque;
     ADBBusState *adb_bus = &s->adb_bus;
-    uint8_t obuf[ADB_MAX_OUT_LEN + 2];
+    uint8_t obuf[ADB_MAX_OUT_LEN + 3];
     int olen;
 
     olen = adb_poll(adb_bus, obuf + 2, adb_bus->autopoll_mask);
@@ -212,6 +212,39 @@ static void cuda_adb_poll(void *opaque)
         obuf[0] = ADB_PACKET;
         obuf[1] = 0x40; /* polled data */
         cuda_send_packet_to_host(s, obuf, olen + 2);
+        return;
+    }
+
+    if (s->one_second_mode) {
+        uint32_t ti = s->tick_offset +
+                      (qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) /
+                       NANOSECONDS_PER_SECOND);
+
+        if (ti != s->last_second_tick) {
+            if (s->one_second_first_packet || s->one_second_mode == 1 ||
+                !(ti & 3)) {
+                obuf[0] = CUDA_PACKET;
+                obuf[1] = 0;
+                obuf[2] = CUDA_GET_TIME;
+                obuf[3] = ti >> 24;
+                obuf[4] = ti >> 16;
+                obuf[5] = ti >> 8;
+                obuf[6] = ti;
+                olen = 7;
+            } else if (s->one_second_mode == 2) {
+                obuf[0] = CUDA_PACKET;
+                obuf[1] = 0;
+                obuf[2] = CUDA_GET_TIME;
+                olen = 3;
+            } else {
+                obuf[0] = TIMER_PACKET;
+                olen = 1;
+            }
+
+            s->last_second_tick = ti;
+            s->one_second_first_packet = false;
+            cuda_send_packet_to_host(s, obuf, olen);
+        }
     }
 }
 
@@ -367,6 +400,20 @@ static bool cuda_cmd_set_time(CUDAState *s,
     return true;
 }
 
+static bool cuda_cmd_one_second_mode(CUDAState *s,
+                                     const uint8_t *in_data, int in_len,
+                                     uint8_t *out_data, int *out_len)
+{
+    if (in_len != 1) {
+        return false;
+    }
+
+    s->one_second_mode = in_data[0];
+    s->last_second_tick = 0;
+    s->one_second_first_packet = true;
+    return true;
+}
+
 static const CudaCommand handlers[] = {
     { CUDA_AUTOPOLL, "AUTOPOLL", cuda_cmd_autopoll },
     { CUDA_SET_AUTO_RATE, "SET_AUTO_RATE",  cuda_cmd_set_autorate },
@@ -377,6 +424,8 @@ static const CudaCommand handlers[] = {
       cuda_cmd_set_file_server_flag },
     { CUDA_SET_POWER_MESSAGES, "SET_POWER_MESSAGES",
       cuda_cmd_set_power_message },
+    { CUDA_SET_ONE_SECOND_MODE, "SET_ONE_SECOND_MODE",
+      cuda_cmd_one_second_mode },
     { CUDA_GET_TIME, "GET_TIME", cuda_cmd_get_time },
     { CUDA_SET_TIME, "SET_TIME", cuda_cmd_set_time },
 };
@@ -485,7 +534,7 @@ static const MemoryRegionOps mos6522_cuda_ops = {
 
 static const VMStateDescription vmstate_cuda = {
