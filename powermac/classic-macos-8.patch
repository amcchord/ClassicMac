diff --git a/hw/nvram/mac_nvram.c b/hw/nvram/mac_nvram.c
index efadb3c943c..a6c144c3e5a 100644
--- a/hw/nvram/mac_nvram.c
+++ b/hw/nvram/mac_nvram.c
@@ -38,6 +38,7 @@
 #include <zlib.h> /* for adler32 */
 
 #define DEF_SYSTEM_SIZE 0xc10
+#define DEF_MACOS_SIZE  0x510
 
 /* macio style NVRAM device */
 static void macio_nvram_writeb(void *opaque, hwaddr addr,
@@ -169,11 +170,27 @@ static void pmac_format_nvram_partition_of(MacIONVRAMState *nvr, int off,
                                            int len)
 {
     int sysp_end;
+    ChrpNvramPartHdr *part_header;
 
     /* OpenBIOS nvram variables partition */
     sysp_end = chrp_nvram_create_system_partition(&nvr->data[off],
                                                   DEF_SYSTEM_SIZE, len) + off;
 
+    /* New World Mac OS expects the OF partition to be named "common". */
+    part_header = (ChrpNvramPartHdr *)&nvr->data[off];
+    pstrcpy(part_header->name, sizeof(part_header->name), "common");
+    chrp_nvram_finish_partition(part_header, sysp_end - off);
+
+    /*
+     * Mac OS 8 and 9 store 256 bytes of XPRAM followed by 1 KiB of
+     * Name Registry data in an APL,MacOS75 partition.
+     */
+    part_header = (ChrpNvramPartHdr *)&nvr->data[sysp_end];
+    part_header->signature = 0xa0;
+    pstrcpy(part_header->name, sizeof(part_header->name), "APL,MacOS75");
+    chrp_nvram_finish_partition(part_header, DEF_MACOS_SIZE);
+    sysp_end += DEF_MACOS_SIZE;
+
     /* Free space partition */
     chrp_nvram_create_free_partition(&nvr->data[sysp_end], len - sysp_end);
 }
@@ -205,12 +222,6 @@ static void pmac_format_nvram_partition_osx(MacIONVRAMState *nvr, int off,
 /* Set up NVRAM with OF and OSX partitions */
 void pmac_format_nvram_partition(MacIONVRAMState *nvr, int len)
 {
-    /*
-     * Mac OS X expects side "B" of the flash at the second half of NVRAM,
-     * so we use half of the chip for OF and the other half for a free OSX
-     * partition.
-     */
-    pmac_format_nvram_partition_of(nvr, 0, len / 2);
-    pmac_format_nvram_partition_osx(nvr, len / 2, len / 2);
+    pmac_format_nvram_partition_of(nvr, 0, len);
 }
 type_init(macio_nvram_register_types)
