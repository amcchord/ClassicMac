*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Source patches and native build scripts must retain Unix line endings.
*.patch text eol=lf
*.sh text eol=lf
*.py text eol=lf

# Copland patch hunks intentionally preserve the upstream mixed CRLF bytes.
copland/*.patch -text

# These copied device sources are then patched inside the vendor tree.
screamer/*.[ch] text eol=lf
