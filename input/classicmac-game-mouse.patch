+bool ati_cursor_visible(const ATIVGAState *s)
+{
+    unsigned width = ((s->regs.crtc_h_total_disp >> 16) + 1) * 8;
+    unsigned height = (s->regs.crtc_v_total_disp >> 16) + 1;
+
+    /* ATI's Mac driver hides a cursor by parking it at (2047, 2047),
+     * leaving CUR_EN set. Test its actual position as well as the enable bit. */
+    return (s->regs.crtc_gen_cntl & CRTC2_CUR_EN) &&
+           (s->regs.cur_hv_pos >> 16) < width &&
+           (s->regs.cur_hv_pos & 0xffff) < height;
+}
