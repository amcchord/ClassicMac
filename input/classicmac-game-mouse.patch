+void qemu_input_handler_set_classicmac_game_mouse(QemuInputHandlerState *s)
+{
+    s->classicmac_game_mouse = true;
+}
+
+void qemu_input_set_classicmac_game_mode(bool enabled)
+{
+    QemuInputHandlerState *s;
+    bool present = false;
+
+    QTAILQ_FOREACH(s, &handlers, node) {
+        if (s->classicmac_game_mouse) {
+            present = true;
+            break;
+        }
+    }
+    if (!present) {
+        return;
+    }
+    if (classicmac_game_mode != enabled) {
+        /* A game can quit on mouse-down, before the matching mouse-up. Do
+         * not strand a held button on the device that is losing ownership. */
+        qemu_input_queue_btn(NULL, INPUT_BUTTON_LEFT, false);
+        qemu_input_queue_btn(NULL, INPUT_BUTTON_RIGHT, false);
+        qemu_input_queue_btn(NULL, INPUT_BUTTON_MIDDLE, false);
+        qemu_input_event_sync();
+        classicmac_game_mode = enabled;
+        notifier_list_notify(&mouse_mode_notifiers, NULL);
+    }
+}
