+    // ClassicMac holds Caps Lock through the boot chooser. Releasing it on a
+    // timer can boot System 7 instead; release the synthetic keys immediately
+    // before the first real keyboard event, once the initial hold window ends.
+    if (std::getenv("CLASSICMAC_CONTROL") && !this->hold_released &&
+        !this->held_keys.empty() && this->hold_until_ns &&
+        get_virt_time_ns() >= this->hold_until_ns) {
+        for (uint8_t code : this->held_keys) {
+            KeyboardEvent released{};
+            released.key = code;
+            released.flags = KEYBOARD_EVENT_UP;
+            this->pending_events.push_back(std::make_unique<KeyboardEvent>(released));
+        }
+        this->held_keys.clear();
+        this->hold_reports.clear();
+        this->hold_reporting = false;
+        this->hold_released = true;
+        this->srq_flag = 1;
+    }
